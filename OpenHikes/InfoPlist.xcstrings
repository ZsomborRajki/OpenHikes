    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet die Kamera, damit du unterwegs Fotos deiner Wanderung aufnehmen kannst. Fotos werden bei dieser Wanderung aufbewahrt und an der Stelle des Weges verortet, die du ausgewählt hattest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses the camera so you can photograph a hike while you are on it. Photos are kept with that hike, and pinned to the point on the trail you had selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa la cámara para que puedas fotografiar una excursión mientras la haces. Las fotos se guardan con esa excursión, en el punto del sendero que tenías seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise l’appareil photo pour que vous puissiez photographier une randonnée en cours. Les photos sont conservées avec cette randonnée et placées au point du sentier que vous aviez sélectionné."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes koristi kameru kako biste mogli fotografirati turu dok ste na njoj. Fotografije se čuvaju uz tu turu i pričvršćuju na točku staze koju ste odabrali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa la fotocamera per permetterti di fotografare un’escursione mentre sei in cammino. Le foto restano con quell’escursione, nel punto del sentiero che avevi selezionato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes gebruikt de camera zodat je onderweg foto’s van een wandeling kunt maken. Foto’s worden bij die wandeling bewaard en vastgezet op het punt op het pad dat je had geselecteerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes używa aparatu, aby można było fotografować wędrówkę w jej trakcie. Zdjęcia są przechowywane razem z tą wędrówką i przypinane do punktu na szlaku, który był wtedy zaznaczony."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes folosește camera pentru a vă permite să fotografiați o drumeție în timp ce o parcurgeți. Pozele sunt păstrate împreună cu drumeția respectivă și fixate în punctul de pe traseu pe care îl aveați selectat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes использует камеру, чтобы вы могли фотографировать во время похода. Фото хранятся вместе с этим походом и привязываются к той точке тропы, которую вы выбрали."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes використовує камеру, щоб ви могли фотографувати під час походу. Фото зберігаються разом із цим походом і привʼязуються до тієї точки на стежці, яку ви вибрали."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verbindet sich mit Health, um deine abgeschlossenen Wanderungen als Trainings zu speichern, einschließlich Distanz und Route, wenn du „Wanderungen in Health speichern“ aktivierst. OpenHikes liest auf deinem iPhone nichts aus Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes connects to Health to save your finished hikes as workouts, including distance and route, when you turn on Save Hikes to Health. OpenHikes reads nothing from Health on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes se conecta a Salud para guardar tus excursiones terminadas como entrenamientos, con su distancia y su ruta, cuando activas «Guardar excursiones en Salud». OpenHikes no lee nada de Salud en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes se connecte à Santé pour enregistrer vos randonnées terminées comme entraînements, avec leur distance et leur itinéraire, lorsque vous activez « Enregistrer les randonnées dans Santé ». OpenHikes ne lit rien dans Santé sur votre iPhone."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes se povezuje sa Zdravljem kako bi vaše završene ture spremio kao treninge, uključujući udaljenost i rutu, kad uključite “Spremaj ture u Zdravlje”. OpenHikes ne čita ništa iz Zdravlja na vašem iPhoneu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes si collega a Salute per salvare le escursioni terminate come allenamenti, con la loro distanza e il loro percorso, quando attivi «Salva escursioni in Salute». OpenHikes non legge nulla da Salute sul tuo iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes maakt verbinding met Gezondheid om je voltooide wandelingen als work-outs te bewaren, inclusief afstand en route, als je ‘Bewaar wandelingen in Gezondheid’ aanzet. OpenHikes leest niets uit Gezondheid op je iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes łączy się z aplikacją Zdrowie, aby zapisywać ukończone wędrówki jako treningi, wraz z dystansem i trasą, gdy włączysz opcję „Zapisuj wędrówki w Zdrowiu”. OpenHikes niczego nie odczytuje z aplikacji Zdrowie na Twoim iPhonie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes se conectează la Sănătate pentru a salva drumețiile încheiate ca exerciții, inclusiv distanța și ruta, atunci când activați „Salvare drumeții în Sănătate”. OpenHikes nu citește nimic din Sănătate pe iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes подключается к приложению «Здоровье», чтобы сохранять завершенные походы как тренировки, с расстоянием и маршрутом, если вы включили «Сохранять походы в Здоровье». OpenHikes ничего не читает из приложения «Здоровье» на вашем iPhone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes підключається до Здоровʼя, щоб зберігати завершені походи як тренування, з відстанню й маршрутом, коли ви вмикаєте «Зберігати походи до Здоровʼя». OpenHikes нічого не зчитує зі Здоровʼя на вашому iPhone."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes speichert deine abgeschlossenen Wanderungen als Wandertrainings in Health, mit Distanz und Route, wenn du „Wanderungen in Health speichern“ aktivierst. OpenHikes liest auf deinem iPhone nichts aus Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes saves your finished hikes to Health as hiking workouts, with their distance and route, when you turn on Save Hikes to Health. OpenHikes reads nothing from Health on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes guarda tus excursiones terminadas en Salud como entrenamientos de senderismo, con su distancia y su ruta, cuando activas «Guardar excursiones en Salud». OpenHikes no lee nada de Salud en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes enregistre vos randonnées terminées dans Santé comme entraînements de randonnée, avec leur distance et leur itinéraire, lorsque vous activez « Enregistrer les randonnées dans Santé ». OpenHikes ne lit rien dans Santé sur votre iPhone."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes sprema vaše završene ture u Zdravlje kao treninge planinarenja, s udaljenošću i rutom, kad uključite “Spremaj ture u Zdravlje”. OpenHikes ne čita ništa iz Zdravlja na vašem iPhoneu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes salva le escursioni terminate in Salute come allenamenti di escursionismo, con la loro distanza e il loro percorso, quando attivi «Salva escursioni in Salute». OpenHikes non legge nulla da Salute sul tuo iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes bewaart je voltooide wandelingen in Gezondheid als wandeltochtwork-outs, met hun afstand en route, als je ‘Bewaar wandelingen in Gezondheid’ aanzet. OpenHikes leest niets uit Gezondheid op je iPhone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes zapisuje ukończone wędrówki w aplikacji Zdrowie jako treningi typu Wędrówka, wraz z dystansem i trasą, gdy włączysz opcję „Zapisuj wędrówki w Zdrowiu”. OpenHikes niczego nie odczytuje z aplikacji Zdrowie na Twoim iPhonie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes salvează drumețiile încheiate în Sănătate ca exerciții de drumeție, cu distanța și ruta lor, atunci când activați „Salvare drumeții în Sănătate”. OpenHikes nu citește nimic din Sănătate pe iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes сохраняет завершенные походы в приложении «Здоровье» как тренировки «Пеший туризм», с расстоянием и маршрутом, если вы включили «Сохранять походы в Здоровье». OpenHikes ничего не читает из приложения «Здоровье» на вашем iPhone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes зберігає завершені походи до Здоровʼя як тренування «Піший туризм», з відстанню й маршрутом, коли ви вмикаєте «Зберігати походи до Здоровʼя». OpenHikes нічого не зчитує зі Здоровʼя на вашому iPhone."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet den Standortzugriff „Immer“ nur, wenn du in den Einstellungen „Wegverfolgung im Hintergrund“ aktivierst, damit dein Home-Bildschirm-Widget und deine Live-Aktivität deinen Fortschritt entlang des Weges anzeigen, während die App nicht geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses Always location, only when you turn on Background Trail Tracking in Settings, to keep your Home Screen widget and Live Activity showing your progress along the trail while the app isn’t open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa el acceso «Siempre» a la ubicación, solo si activas «Seguimiento del sendero en segundo plano» en los ajustes de la app, para que tu widget de la pantalla de inicio y tu Actividad en directo sigan mostrando tu progreso por el sendero mientras la app no está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise l’accès « Toujours » à la position, seulement si vous activez « Suivi du sentier en arrière-plan » dans les réglages de l’app, pour que votre widget de l’écran d’accueil et votre Activité en direct continuent d’afficher votre progression sur le sentier lorsque l’app n’est pas ouverte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes koristi lokaciju “Uvijek”, samo kad uključite “Praćenje staze u pozadini” u Postavkama, kako bi widget na početnom zaslonu i Aktivnost uživo prikazivali vaš napredak duž staze dok aplikacija nije otvorena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa l’accesso «Sempre» alla posizione, solo se attivi «Monitoraggio del sentiero in background» nelle impostazioni dell’app, perché il widget della schermata Home e l’Attività in tempo reale continuino a mostrare i tuoi progressi lungo il sentiero quando l’app non è aperta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes gebruikt locatietoegang ‘Altijd’, alleen als je ‘Padvolging op achtergrond’ aanzet in de instellingen, zodat je widget op het beginscherm en je live activiteit je voortgang langs het pad tonen terwijl de app niet open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes używa dostępu do położenia „Zawsze” tylko wtedy, gdy włączysz w ustawieniach aplikacji opcję „Śledzenie szlaku w tle”, aby widżet na ekranie głównym i wydarzenie na żywo pokazywały Twój postęp na szlaku, gdy aplikacja nie jest otwarta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes folosește accesul „Întotdeauna” la localizare, doar dacă activați „Urmărirea traseului în fundal” în configurările aplicației, pentru ca widgetul de pe ecranul principal și activitatea live să vă arate progresul pe traseu cât timp aplicația nu este deschisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes использует доступ к геопозиции «Всегда», только если вы включили «Фоновое отслеживание тропы» в настройках приложения, чтобы виджет на экране «Домой» и Эфир активности показывали ваш прогресс на тропе, пока приложение закрыто."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes використовує доступ до геопозиції «Завжди», лише якщо ви ввімкнули «Фонове відстеження стежки» в параметрах програми, щоб віджет на початковому екрані й Дія наживо показували ваш прогрес на стежці, поки програма не відкрита."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet deinen Standort, um zu zeigen, wo du auf der Karte bist, um Wanderungen aufzuzeichnen, die du startest, und um dir mit eingeschalteten Abzweigungshinweisen an jeder Abzweigung eines Wegs, dem du folgst, zu sagen, wohin es geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses your location to show where you are on the map, record hikes you choose to start and, with junction warnings on, say which way to go at each junction of a trail you follow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa tu ubicación para mostrar dónde estás en el mapa, para grabar las excursiones que decidas empezar y, con los avisos de cruces activados, para decirte hacia dónde ir en cada cruce del sendero que sigues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise votre position pour indiquer où vous êtes sur la carte, pour enregistrer les randonnées que vous choisissez de démarrer et, avec les alertes d’intersection activées, pour indiquer la direction à prendre à chaque intersection du sentier que vous suivez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes koristi vašu lokaciju kako bi prikazao gdje ste na karti, snimao ture koje sami pokrenete i, s uključenim upozorenjima na raskrižjima, govorio kojim smjerom ići na svakom raskrižju staze koju pratite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa la tua posizione per mostrarti dove ti trovi sulla mappa, per registrare le escursioni che scegli di avviare e, con gli avvisi agli incroci attivati, per indicarti da che parte andare a ogni incrocio del sentiero che segui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes gebruikt je locatie om te tonen waar je op de kaart bent, om wandelingen op te nemen die je zelf start en, met kruisingswaarschuwingen aan, om bij elke kruising van een pad dat je volgt te zeggen welke kant je op moet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes używa Twojego położenia, aby pokazywać, gdzie jesteś na mapie, nagrywać wędrówki, które postanowisz rozpocząć, i – gdy wskazówki na skrzyżowaniach są włączone – mówić, którędy iść na każdym skrzyżowaniu szlaku, którym idziesz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes folosește localizarea dvs. pentru a arăta unde vă aflați pe hartă, pentru a înregistra drumețiile pe care alegeți să le începeți și, cu avertizările la intersecții activate, pentru a vă spune încotro s-o luați la fiecare intersecție a traseului pe care îl urmați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes использует вашу геопозицию, чтобы показывать на карте, где вы находитесь, записывать походы, которые вы решили начать, а при включенных подсказках на перекрестках — подсказывать, куда идти на каждом перекрестке тропы, по которой вы идете."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes використовує вашу геопозицію, щоб показувати на карті, де ви перебуваєте, записувати походи, які ви вирішите почати, а з увімкненими підказками на перехрестях — підказувати, куди йти на кожному перехресті стежки, якою ви йдете."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet die Bewegungssensoren, um die aufgezeichnete Höhe zu verbessern, den gewanderten Weg über GPS-Lücken hinweg zu erschließen und eine Aufzeichnung anzuhalten, wenn du stehen bleibst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses motion sensors to improve recorded elevation, infer the trail hiked through GPS gaps, and pause a recording when you stop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa los sensores de movimiento para mejorar la altitud grabada, deducir el sendero recorrido cuando se pierde la señal GPS y poner en pausa una grabación cuando te detienes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise les capteurs de mouvement pour améliorer l’altitude enregistrée, reconstituer le sentier parcouru pendant les interruptions du GPS et mettre un enregistrement en pause lorsque vous vous arrêtez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes koristi senzore pokreta kako bi poboljšao snimljenu visinu, odredio prijeđeni put ondje gdje GPS nema signala i pauzirao snimanje kad stanete."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa i sensori di movimento per migliorare l’altitudine registrata, ricostruire il sentiero percorso quando il segnale GPS si interrompe e mettere in pausa una registrazione quando ti fermi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes gebruikt de bewegingssensoren om de opgenomen hoogte te verbeteren, het gewandelde pad af te leiden waar GPS wegvalt, en een opname te pauzeren als je stilstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes używa czujników ruchu, aby poprawiać nagraną wysokość, odtwarzać przebyty szlak tam, gdzie zabrakło sygnału GPS, i wstrzymywać nagrywanie, gdy się zatrzymasz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes folosește senzorii de mișcare pentru a îmbunătăți altitudinea înregistrată, pentru a deduce traseul parcurs acolo unde lipsește semnalul GPS și pentru a suspenda înregistrarea când vă opriți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes использует датчики движения, чтобы уточнять записанную высоту, восстанавливать пройденную тропу там, где пропадал сигнал GPS, и ставить запись на паузу, когда вы останавливаетесь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes використовує датчики руху, щоб уточнювати записану висоту, відновлювати пройдену стежку там, де зникав сигнал GPS, і призупиняти запис, коли ви зупиняєтеся."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Auch in Fotos speichern“, um eine Kopie jedes Wanderfotos in deiner Mediathek abzulegen, versehen mit Zeit und Ort der Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on “Also Save to Photos” to keep a copy of each hike photo in your photo library, stamped with when and where it was taken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Guardar también en Fotos» para conservar una copia de cada foto de excursión en tu fototeca, con la fecha y el lugar en que se tomó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Enregistrer aussi dans Photos » pour conserver une copie de chaque photo de randonnée dans votre photothèque, avec la date et le lieu de la prise de vue."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uključite “Spremi i u Foto” kako biste kopiju svake fotografije s ture čuvali u medijateci, s oznakom kada je i gdje snimljena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Salva anche in Foto» per conservare una copia di ogni foto dell’escursione nella tua libreria foto, con la data e il luogo in cui è stata scattata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet ‘Bewaar ook in Foto’s’ aan om een kopie van elke wandelfoto in je fotobibliotheek te bewaren, met het tijdstip en de plek waar hij is gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz opcję „Zapisuj też w Zdjęciach”, aby kopia każdego zdjęcia z wędrówki trafiała do Twojej biblioteki zdjęć, z datą i miejscem wykonania."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați „Salvare și în Poze” pentru a păstra în biblioteca foto o copie a fiecărei poze din drumeție, cu data, ora și locul în care a fost făcută."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Сохранять также в Фото», чтобы копия каждого фото из похода сохранялась в вашей медиатеке с датой и местом съемки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть «Також зберігати до Фотографій», щоб копія кожного фото з походу зберігалася у вашій фототеці з датою й місцем зйомки."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes durchsucht deine Mediathek nach Bildern, die du während einer Wanderung aufgenommen hast, um jedes an der Stelle des Weges zu verorten, an der du gestanden hast. Es liest nur Fotos, die während dieser Wanderung aufgenommen wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes looks through your photo library for pictures you took while on a hike, so it can pin each one to the point on the trail you were standing on. It only reads photos taken during that hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes busca en tu fototeca las fotos que tomaste durante una excursión, para colocar cada una en el punto del sendero donde estabas. Solo lee las fotos tomadas durante esa excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes parcourt votre photothèque à la recherche des photos prises pendant une randonnée, afin de placer chacune au point du sentier où vous vous trouviez. Seules les photos prises pendant cette randonnée sont lues."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes pretražuje vašu medijateku tražeći slike koje ste snimili na turi kako bi svaku mogao pričvrstiti na točku staze na kojoj ste stajali. Čita samo fotografije snimljene tijekom te ture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes cerca nella tua libreria foto le immagini scattate durante un’escursione, per collocare ciascuna nel punto del sentiero in cui ti trovavi. Legge solo le foto scattate durante quell’escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes zoekt in je fotobibliotheek naar foto’s die je tijdens een wandeling hebt gemaakt, zodat het elke foto kan vastzetten op het punt van het pad waar je stond. Het leest alleen foto’s die tijdens die wandeling zijn gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes szuka w Twojej bibliotece zdjęć tych, które powstały podczas wędrówki, aby przypiąć każde do punktu na szlaku, w którym je zrobiono. Odczytywane są tylko zdjęcia zrobione podczas tej wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes caută în biblioteca foto pozele făcute în timpul unei drumeții, pentru a fixa fiecare poză în punctul de pe traseu în care vă aflați atunci. Citește doar pozele făcute în timpul drumeției respective."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ищет в вашей медиатеке снимки, сделанные во время похода, чтобы привязать каждый к той точке тропы, где вы стояли. Читаются только фото, снятые во время этого похода."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes шукає у вашій фототеці знімки, зроблені під час походу, щоб привʼязати кожен із них до тієї точки на стежці, де ви стояли. Зчитуються лише фото, зроблені під час цього походу."
          }
        }
      }
    },
    "RecordHike" : {
      "comment" : "The precise-location purpose of the same name, in NSLocationTemporaryUsageDescriptionDictionary. Core Location looks the purpose key up in this table.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht deinen genauen Standort, um den Weg aufzuzeichnen, den du wanderst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes needs your precise location to record the trail you hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita tu ubicación exacta para grabar el sendero que recorres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin de votre position exacte pour enregistrer le sentier que vous parcourez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes treba vašu preciznu lokaciju kako bi snimio stazu kojom prolazite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno della tua posizione esatta per registrare il sentiero che percorri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes heeft je exacte locatie nodig om het pad op te nemen dat je wandelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes potrzebuje Twojego dokładnego położenia, aby nagrać szlak, którym idziesz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes are nevoie de localizarea precisă pentru a înregistra traseul pe care îl parcurgeți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы записать тропу, по которой вы идете, приложению OpenHikes нужна ваша точная геопозиция."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб записати стежку, якою ви йдете, програмі OpenHikes потрібна ваша точна геопозиція."
          }
        }
      }
    }
  },
  "version" : "1.0"
}