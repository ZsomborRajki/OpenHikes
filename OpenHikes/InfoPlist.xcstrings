{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes"
          }
        }
      },
      "shouldTranslate" : false
    },
    "GPS Exchange File" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPX-Datei"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivo GPX"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichier GPX"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File GPX"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet die Kamera, damit du unterwegs Fotos deiner Wanderung aufnehmen kannst. Fotos werden bei dieser Wanderung aufbewahrt und an der Stelle des Weges verortet, die du ausgewählt hattest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses the camera so you can photograph a hike while you are on it. Photos are kept with that hike, and pinned to the point on the trail you had selected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa la cámara para que puedas fotografiar una excursión mientras la haces. Las fotos se guardan con esa excursión, en el punto del sendero que tenías seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise l’appareil photo pour que vous puissiez photographier une randonnée en cours. Les photos sont conservées avec cette randonnée et placées au point du sentier que vous aviez sélectionné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa la fotocamera per permetterti di fotografare un’escursione mentre sei in cammino. Le foto restano con quell’escursione, nel punto del sentiero che avevi selezionato."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verbindet sich mit Health, um deine abgeschlossenen Wanderungen als Trainings zu speichern, einschließlich Distanz und Route, wenn du „Wanderungen in Health speichern“ aktivierst. OpenHikes liest auf deinem iPhone nichts aus Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes connects to Health to save your finished hikes as workouts, including distance and route, when you turn on Save Hikes to Health. OpenHikes reads nothing from Health on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes se conecta a Salud para guardar tus excursiones terminadas como entrenamientos, con su distancia y su ruta, cuando activas «Guardar excursiones en Salud». OpenHikes no lee nada de Salud en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes se connecte à Santé pour enregistrer vos randonnées terminées comme entraînements, avec leur distance et leur itinéraire, lorsque vous activez « Enregistrer les randonnées dans Santé ». OpenHikes ne lit rien dans Santé sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes si collega a Salute per salvare le escursioni terminate come allenamenti, con la loro distanza e il loro percorso, quando attivi «Salva escursioni in Salute». OpenHikes non legge nulla da Salute sul tuo iPhone."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes speichert deine abgeschlossenen Wanderungen als Wandertrainings in Health, mit Distanz und Route, wenn du „Wanderungen in Health speichern“ aktivierst. OpenHikes liest auf deinem iPhone nichts aus Health."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes saves your finished hikes to Health as hiking workouts, with their distance and route, when you turn on Save Hikes to Health. OpenHikes reads nothing from Health on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes guarda tus excursiones terminadas en Salud como entrenamientos de senderismo, con su distancia y su ruta, cuando activas «Guardar excursiones en Salud». OpenHikes no lee nada de Salud en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes enregistre vos randonnées terminées dans Santé comme entraînements de randonnée, avec leur distance et leur itinéraire, lorsque vous activez « Enregistrer les randonnées dans Santé ». OpenHikes ne lit rien dans Santé sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes salva le escursioni terminate in Salute come allenamenti di escursionismo, con la loro distanza e il loro percorso, quando attivi «Salva escursioni in Salute». OpenHikes non legge nulla da Salute sul tuo iPhone."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet den Standortzugriff „Immer“ nur, wenn du in den Einstellungen „Wegverfolgung im Hintergrund“ aktivierst, damit dein Home-Bildschirm-Widget und deine Live-Aktivität deinen Fortschritt entlang des Weges anzeigen, während die App nicht geöffnet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses Always location, only when you turn on Background Trail Tracking in Settings, to keep your Home Screen widget and Live Activity showing your progress along the trail while the app isn’t open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa el acceso «Siempre» a la ubicación, solo si activas «Seguimiento del sendero en segundo plano» en los ajustes de la app, para que tu widget de la pantalla de inicio y tu Actividad en directo sigan mostrando tu progreso por el sendero mientras la app no está abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise l’accès « Toujours » à la position, seulement si vous activez « Suivi du sentier en arrière-plan » dans les réglages de l’app, pour que votre widget de l’écran d’accueil et votre Activité en direct continuent d’afficher votre progression sur le sentier lorsque l’app n’est pas ouverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa l’accesso «Sempre» alla posizione, solo se attivi «Monitoraggio del sentiero in background» nelle impostazioni dell’app, perché il widget della schermata Home e l’Attività in tempo reale continuino a mostrare i tuoi progressi lungo il sentiero quando l’app non è aperta."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet deinen Standort, um zu zeigen, wo du auf der Karte bist, und um Wanderungen aufzuzeichnen, die du startest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses your location to show where you are on the map and record hikes you choose to start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa tu ubicación para mostrar dónde estás en el mapa y para grabar las excursiones que decidas empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise votre position pour indiquer où vous êtes sur la carte et pour enregistrer les randonnées que vous choisissez de démarrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa la tua posizione per mostrarti dove ti trovi sulla mappa e per registrare le escursioni che scegli di avviare."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet die Bewegungssensoren, um die aufgezeichnete Höhe zu verbessern und den gewanderten Weg über GPS-Lücken hinweg zu erschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses motion sensors to improve recorded elevation and infer the trail hiked through GPS gaps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa los sensores de movimiento para mejorar la altitud grabada y deducir el sendero recorrido cuando se pierde la señal GPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise les capteurs de mouvement pour améliorer l’altitude enregistrée et reconstituer le sentier parcouru pendant les interruptions du GPS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa i sensori di movimento per migliorare l’altitudine registrata e ricostruire il sentiero percorso quando il segnale GPS si interrompe."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Auch in Fotos speichern“, um eine Kopie jedes Wanderfotos in deiner Mediathek abzulegen, versehen mit Zeit und Ort der Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Turn on “Also Save to Photos” to keep a copy of each hike photo in your photo library, stamped with when and where it was taken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Guardar también en Fotos» para conservar una copia de cada foto de excursión en tu fototeca, con la fecha y el lugar en que se tomó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Enregistrer aussi dans Photos » pour conserver une copie de chaque photo de randonnée dans votre photothèque, avec la date et le lieu de la prise de vue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Salva anche in Foto» per conservare una copia di ogni foto dell’escursione nella tua libreria foto, con la data e il luogo in cui è stata scattata."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes durchsucht deine Mediathek nach Bildern, die du während einer Wanderung aufgenommen hast, um jedes an der Stelle des Weges zu verorten, an der du gestanden hast. Es liest nur Fotos, die während dieser Wanderung aufgenommen wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes looks through your photo library for pictures you took while on a hike, so it can pin each one to the point on the trail you were standing on. It only reads photos taken during that hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes busca en tu fototeca las fotos que tomaste durante una excursión, para colocar cada una en el punto del sendero donde estabas. Solo lee las fotos tomadas durante esa excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes parcourt votre photothèque à la recherche des photos prises pendant une randonnée, afin de placer chacune au point du sentier où vous vous trouviez. Seules les photos prises pendant cette randonnée sont lues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes cerca nella tua libreria foto le immagini scattate durante un’escursione, per collocare ciascuna nel punto del sentiero in cui ti trovavi. Legge solo le foto scattate durante quell’escursione."
          }
        }
      }
    },
    "RecordHike" : {
      "comment" : "The precise-location purpose of the same name, in NSLocationTemporaryUsageDescriptionDictionary. Core Location looks the purpose key up in this table.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht deinen genauen Standort, um den Weg aufzuzeichnen, den du wanderst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes needs your precise location to record the trail you hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita tu ubicación exacta para grabar el sendero que recorres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin de votre position exacte pour enregistrer le sentier que vous parcourez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno della tua posizione esatta per registrare il sentiero che percorri."
          }
        }
      }
    }
  },
  "version" : "1.0"
}