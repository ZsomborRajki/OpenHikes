<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app keeps everything on device except one thing the user asks for by
	  name: sharing a hike with the community.

	  That one is genuine collection in Apple's sense and is declared below.
	  Everything else still is not — tile and Overpass requests carry no
	  identity, and iCloud mirroring puts the hiker's data in the hiker's own
	  private database, which Apple's own guidance does not count as collection
	  by the developer. The community feature is the opposite on both counts:
	  the destination is the *public* database, which the developer owns, and
	  what lands there is a route, photographs and a name, readable by
	  everybody.

	  Every entry sets `NSPrivacyCollectedDataTypeLinked` to true, which is the
	  honest answer rather than the flattering one. The submission carries a
	  name the hiker typed and CloudKit stamps every record with its creator's
	  user record ID, so the developer can tell whose submission is whose —
	  which is precisely what makes reviewing and taking down a submission
	  possible, and therefore not something to claim otherwise about.

	  That creator ID used to be argued for in this comment and declared
	  nowhere, which is the wrong way round. An identifier the app keeps on
	  purpose, copies onto the published listing and refuses a listing without
	  is collected data under Apple's own definitions, whatever it is kept for
	  — so it has an entry of its own below, and so does the walk considered as
	  exercise rather than as a place.

	  Not used for tracking: nothing here is joined with data from other
	  companies' apps or sites, and `NSPrivacyTracking` stays false.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!--
			  The shared route itself. Precise rather than coarse: a GPS track
			  is the most precise location data this app holds, and publishing
			  a trailhead publishes somewhere the hiker stood.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!--
			  The photographs attached to a shared hike. Re-encoded and
			  stripped of their EXIF before they go — see
			  `HikePhotoStore.exportCopy` — but a photograph is a photograph
			  and is declared as one.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!--
			  The hike's title and whatever the hiker wrote about the walk —
			  free text they typed, published under their credit.

			  The display name used to be declared here too, on the argument
			  that it is not the account holder's real name. That is true and
			  it was the wrong conclusion: Apple's definitions put a screen
			  name or handle under User ID, and calling a field the app
			  specifically asks for "other user content" is the move that
			  guidance names. It is declared below instead.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!--
			  Two identifiers, arriving by different routes and both retained.

			  CloudKit stamps every record with its creator's user record ID,
			  and nothing about this feature treats that as incidental: the
			  reviewer copies it onto the published listing as
			  `CommunityHike.authorID`, and the app refuses a listing that has
			  none — see `CloudKitCommunityTransport`. It is what a block is
			  against, so that blocking one hiker survives them publishing
			  under a different name, and it is what a takedown is aimed at.

			  The other is the name typed into the share form, which is a
			  display name and not the account holder's:
			  `CommunityListing.authorName` has said "a credit and not an
			  identity" since it was written, blank is allowed, and the form
			  now says so rather than leaving the hiker to read "Name" and
			  decide for themselves — see `CommunityShareSheet`. Apple's
			  definition puts a screen name or handle here rather than under
			  Contact Info, which is the answer that follows from what the
			  field now asks for.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!--
			  The walk as an activity rather than as a place, which is the
			  second thing a published route is.

			  Every point carries its timestamp and the submission uploads the
			  route whole, so the duration, the pace and where the hiker
			  stopped go with it; the listing carries the date and the
			  distance beside them. None of that is inferred by somebody
			  determined to — the preview draws it straight back out, on the
			  same stat tiles a hike in the library gets.

			  Declared even though none of it comes from HealthKit and none of
			  it is a heart rate. Apple's category is fitness and exercise
			  data, a timed hike is exercise, and what this manifest answers
			  is what leaves the device rather than which framework it came
			  from.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  Settings, the last-known map entitlement, and the UI-testing and
			  test-host suites. Every one of them is this app's own domain:
			  `CA92.1` and not `1C8F.1`, because nothing is read or written
			  through an App Group defaults suite — the App Group carries a
			  file (`SharedStore`), not preferences.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!--
			  `C617.1` covers the app container: the tile cache's TTL and
			  oldest-first eviction, the photo store's orphan sweep, the
			  Overpass trail-graph cache's 30-day expiry, and the export
			  staging directory's cleanup all read modification dates on files
			  this app wrote.

			  `3B52.1` covers the other half: an imported GPX arrives through a
			  document picker, and its size is read before the file is loaded
			  so an unbounded one cannot be read into memory. That URL is the
			  user's, not the app's, which is a different approved reason
			  rather than the same one twice.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
			</array>
		</dict>
		<dict>
			<!--
			  `HikeRecorder` measures elapsed time between fixes against
			  `systemUptime` rather than `Date`, so a clock change mid-hike
			  cannot rewrite a recording's duration. That is the elapsed-time
			  reason, `35F9.1`, and not `8FFB.1` — no absolute timestamp is
			  derived from boot time, and none of it leaves the device.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
