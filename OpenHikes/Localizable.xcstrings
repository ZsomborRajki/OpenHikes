          }
        }
      }
    },
    "Live for other hikers. Add photos you’ve taken since, or ask for the hike to be taken down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für andere sichtbar. Füge Fotos hinzu, die du seitdem aufgenommen hast, oder bitte darum, die Wanderung zu entfernen."
          }
        }
      }
    },
    "Live Progress" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Fortschritt"
          }
        }
      }
    },
    "Live, and the photos you added are waiting for a person to check them. Opens a request to withdraw them, or the hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Online, und die Fotos, die du hinzugefügt hast, warten auf die Prüfung durch eine Person. Öffnet eine Anfrage, um sie oder die Wanderung zurückzuziehen."
          }
        }
      }
    },
    "Loading" : {
