    "Bright, high-contrast trail map that stays readable in sunlight. Routes can’t be downloaded ahead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle, kontrastreiche Wanderkarte, die auch in der Sonne gut lesbar bleibt. Routen können nicht vorab heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa de senderos claro y de alto contraste que se lee bien a pleno sol. Las rutas no se pueden descargar con antelación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte de randonnée claire et contrastée, qui reste lisible en plein soleil. Les itinéraires ne peuvent pas être téléchargés à l’avance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa dei sentieri luminosa e ad alto contrasto, leggibile anche in pieno sole. I percorsi non si possono scaricare in anticipo."
          }
