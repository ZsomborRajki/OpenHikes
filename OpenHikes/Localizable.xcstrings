    "It may have been taken down. Pull the list again to refresh it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung wurde möglicherweise entfernt. Aktualisiere die Liste, indem du sie nach unten ziehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que se haya retirado. Desliza la lista hacia abajo para actualizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée a peut-être été retirée. Tirez la liste vers le bas pour l’actualiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe essere stata rimossa. Trascina di nuovo l’elenco per aggiornarlo."
          }
        }
      }
    },
    "It may not be a GPX file, or its points are missing coordinates or out of range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise ist es keine GPX-Datei, oder Punkten darin fehlen Koordinaten oder sie liegen außerhalb des gültigen Bereichs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que no sea un archivo GPX, o que sus puntos no tengan coordenadas o estén fuera de rango."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s’agit peut-être pas d’un fichier GPX, ou ses points n’ont pas de coordonnées ou sont hors limites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe non essere un file GPX, oppure i suoi punti non hanno coordinate o sono fuori intervallo."
          }
        }
      }
    },
    "It stops appearing for everybody, and the route and photographs behind it are deleted for good. This can’t be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung wird für niemanden mehr angezeigt, und die Route und die Fotos dahinter werden endgültig gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejará de aparecer para todo el mundo, y la ruta y las fotografías que contiene se eliminarán para siempre. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée ne sera plus visible pour personne, et son itinéraire et ses photos seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smette di comparire per tutti, e il percorso e le fotografie collegati vengono eliminati definitivamente. L’operazione non può essere annullata."
          }
        }
      }
    },
    "It’ll appear for other hikers once it’s been checked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erscheint für andere, sobald sie geprüft wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparecerá para otras personas cuando se haya revisado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée sera visible par d’autres personnes une fois vérifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sarà visibile alle altre persone dopo il controllo."
          }
        }
      }
    },
    "Its photos stay in this hike’s gallery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Fotos bleiben in der Galerie dieser Wanderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus fotos se quedan en la galería de esta excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses photos restent dans la galerie de cette randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue foto restano nella galleria di questa escursione."
          }
        }
      }
    },
    "Its record could not be saved, so the hike is still under way. Try ending it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eintrag konnte nicht gespeichert werden, daher läuft die Wanderung noch. Versuche erneut, sie zu beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido guardar sus datos, así que la excursión sigue en curso. Intenta terminarla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses données n’ont pas pu être sauvegardées, la randonnée est donc toujours en cours. Essayez à nouveau de la terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvarne i dati, quindi l’escursione è ancora in corso. Prova di nuovo a terminarla."
          }
        }
      }
    },
    "Its reviewer role may have been changed. Check the CloudKit Console for this environment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prüferrolle wurde möglicherweise geändert. Prüfe die CloudKit Console für diese Umgebung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que se haya cambiado su rol de revisión. Consulta la CloudKit Console de este entorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rôle de vérification a peut-être été modifié. Consultez la CloudKit Console de cet environnement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ruolo di revisione potrebbe essere cambiato. Controlla la CloudKit Console per questo ambiente."
          }
        }
      }
    },
    "Its route and statistics are deleted for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Route und Statistiken werden endgültig gelöscht."
          }
