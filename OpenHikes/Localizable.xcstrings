    "Nothing on this device offered to write the message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts auf diesem Gerät hat angeboten, die Nachricht zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna app de este dispositivo se ha ofrecido a redactar el mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune app de cet appareil n’a proposé de rédiger le message."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna app su questo dispositivo si è offerta di scrivere il messaggio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadna aplikacja na tym urządzeniu nie zaproponowała napisania wiadomości."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicio aplicație de pe acest dispozitiv nu s-a oferit să scrie mesajul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одно приложение на этом устройстве не предложило написать сообщение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодна програма на цьому пристрої не запропонувала написати повідомлення."
          }
        }
      }
    },
