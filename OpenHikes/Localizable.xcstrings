    "Community hikes are ones worth someone else’s day out — a whole route, hiked by you, that isn’t already on the list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Wanderungen sind solche, die anderen einen ganzen Tag draußen wert sind – eine vollständige Route, von dir gewandert, die noch nicht in der Liste steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excursiones de la comunidad son las que merecen la salida de otra persona: una ruta completa, recorrida por ti, que no esté ya en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les randonnées de la communauté sont celles qui valent une journée de sortie pour quelqu’un d’autre – un itinéraire complet, parcouru par vous, qui ne figure pas déjà dans la liste."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ture zajednice su one vrijedne tuđeg slobodnog dana – cijela ruta koju ste sami prošli, a koje još nema na popisu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le escursioni della community sono quelle per cui vale la pena che qualcun altro dedichi una giornata: un percorso completo, fatto da te, che non sia già nell’elenco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communitywandelingen zijn wandelingen die een dag uit voor een ander waard zijn – een hele route, door jou gewandeld, die nog niet in de lijst staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wędrówki społeczności to takie, na które komuś innemu warto poświęcić dzień – cała trasa, przebyta przez Ciebie, której nie ma jeszcze na liście."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumețiile din comunitate sunt cele pentru care merită ca altcineva să-și dedice o zi – o rută completă, parcursă de dvs., care nu se află deja în listă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Походы сообщества — это те, ради которых другому человеку стоит потратить день: целый маршрут, пройденный вами, которого еще нет в списке."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Походи спільноти — це ті, заради яких іншій людині варто присвятити день: цілий маршрут, який ви пройшли і якого ще немає в списку."
          }
        }
      }
    },
    "Community hikes start at %@; this one is %@. It stays in your own list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Wanderungen beginnen bei %1$@; diese hat %2$@. Sie bleibt in deiner eigenen Liste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Community hikes start at %1$@; this one is %2$@. It stays in your own list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excursiones de la comunidad tienen al menos %1$@; esta tiene %2$@. Se queda en tu propia lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les randonnées de la communauté font au moins %1$@ ; celle-ci fait %2$@. Elle reste dans votre propre liste."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ture zajednice počinju od %1$@; ova ima %2$@. Ostaje na vašem popisu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le escursioni della community partono da %1$@; questa è di %2$@. Resta nel tuo elenco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communitywandelingen beginnen bij %1$@; deze is %2$@. Ze blijft in je eigen lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wędrówki społeczności zaczynają się od %1$@, a ta ma %2$@. Zostaje na Twojej liście."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumețiile din comunitate au cel puțin %1$@; aceasta are %2$@. Rămâne în lista dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Походы сообщества начинаются от %1$@, а длина этого — %2$@. Он остается в вашем списке."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мінімальна довжина походу спільноти — %1$@, а цього — %2$@. Він залишиться у вашому списку."
          }
        }
      }
    },
    "Community shows hikes other people shared, and OpenStreetMap trails, for the area on the map." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Community zeigt Wanderungen, die andere geteilt haben, und Wege aus OpenStreetMap für den Bereich auf der Karte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Comunidad» muestra las excursiones que otras personas han compartido y los senderos de OpenStreetMap de la zona que se ve en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet « Communauté » affiche les randonnées partagées par d’autres personnes et les sentiers OpenStreetMap de la zone visible sur la carte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajednica prikazuje ture koje su drugi podijelili i staze iz OpenStreetMapa za područje na karti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Community mostra le escursioni condivise da altre persone e i sentieri di OpenStreetMap, per la zona visibile sulla mappa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community toont wandelingen die anderen hebben gedeeld, en paden uit OpenStreetMap, voor het gebied op de kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Społeczność pokazuje wędrówki udostępnione przez inne osoby oraz szlaki z OpenStreetMap z obszaru widocznego na mapie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comunitatea afișează drumețiile partajate de alte persoane și traseele OpenStreetMap din zona vizibilă pe hartă."
