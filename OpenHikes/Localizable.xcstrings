    "Reports are read and acted on within 24 hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldungen werden innerhalb von 24 Stunden gelesen und bearbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las denuncias se leen y se atienden en un plazo de 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements sont lus et traités sous 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le segnalazioni vengono lette e gestite entro 24 ore."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoszenia są czytane i rozpatrywane w ciągu 24 godzin."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportările sunt citite și soluționate în cel mult 24 de ore."
