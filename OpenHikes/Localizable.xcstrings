    "What you entered wasn’t lost. Check that the device has storage available, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Eingaben sind nicht verloren. Prüfe, ob auf dem Gerät Speicherplatz verfügbar ist, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que has escrito no se ha perdido. Comprueba que el dispositivo tenga espacio de almacenamiento y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre saisie n’a pas été perdue. Vérifiez que l’appareil dispose d’espace de stockage, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che hai inserito non è andato perso. Verifica che il dispositivo abbia spazio disponibile, poi riprova."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co zostało wpisane, nie przepadło. Sprawdź, czy na urządzeniu jest wolne miejsce, i spróbuj ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce ați introdus nu s-a pierdut. Verificați dacă dispozitivul are spațiu de stocare disponibil, apoi reîncercați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введенное вами не потеряно. Убедитесь, что на устройстве есть свободное место, и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те, що ви ввели, не втрачено. Переконайтеся, що на пристрої є вільне місце, а потім спробуйте ще раз."
          }
        }
      }
    },
