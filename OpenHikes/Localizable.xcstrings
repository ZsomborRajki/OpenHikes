    "Bright, high-contrast trail map that stays readable in sunlight. Routes can’t be downloaded ahead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helle, kontrastreiche Wanderkarte, die auch in der Sonne gut lesbar bleibt. Routen können nicht vorab heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa de senderos claro y de alto contraste que se lee bien a pleno sol. Las rutas no se pueden descargar con antelación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte de randonnée claire et contrastée, qui reste lisible en plein soleil. Les itinéraires ne peuvent pas être téléchargés à l’avance."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svijetla karta za planinarenje visokog kontrasta koja ostaje čitljiva na suncu. Rute se ne mogu unaprijed preuzeti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa dei sentieri luminosa e ad alto contrasto, leggibile anche in pieno sole. I percorsi non si possono scaricare in anticipo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichte wandelkaart met veel contrast, die in de zon goed leesbaar blijft. Routes kunnen niet vooraf worden gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasna, kontrastowa mapa szlaków, czytelna także w słońcu. Tras nie można pobrać z wyprzedzeniem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartă turistică luminoasă, cu contrast ridicat, care rămâne lizibilă în lumina soarelui. Rutele nu pot fi descărcate în avans."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яркая контрастная карта троп, которую легко читать на солнце. Маршруты нельзя загрузить заранее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яскрава контрастна карта стежок, яку легко читати на сонці. Маршрути не можна викачати заздалегідь."
          }
        }
      }
    },
    "Broken terrain, hands used continuously" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zerklüftetes Gelände, Hände ständig im Einsatz"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terreno abrupto, uso continuo de las manos"
          }
