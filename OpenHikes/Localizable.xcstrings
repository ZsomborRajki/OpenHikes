    },
    "This hike isn’t in the community list any more. Resetting lets you share it again, but forgets the details needed to ask for its removal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist nicht mehr in der Community-Liste. Durch das Zurücksetzen kannst du sie erneut teilen, aber die Angaben für eine Anfrage zur Entfernung gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta excursión ya no está en la lista de la comunidad. Al restablecerla puedes volver a compartirla, pero se olvidan los datos necesarios para pedir su retirada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée ne figure plus dans la liste de la communauté. Réinitialiser vous permet de la partager à nouveau, mais efface les informations nécessaires pour demander son retrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa escursione non è più nell’elenco della community. Ripristinandola puoi condividerla di nuovo, ma si perdono i dati necessari per chiederne la rimozione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tej wędrówki nie ma już na liście społeczności. Po zresetowaniu możesz udostępnić ją ponownie, ale znikną dane potrzebne, aby poprosić o jej usunięcie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această drumeție nu mai figurează în lista comunității. Resetarea vă permite să o partajați din nou, dar șterge detaliile necesare pentru a solicita retragerea ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этого похода больше нет в списке сообщества. После сброса им можно поделиться снова, но данные, нужные для запроса на удаление, будут забыты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цього походу більше немає в списку спільноти. Після скидання його можна поширити знову, але дані, потрібні для запиту на видалення, буде втрачено."
          }
        }
      }
    },
    "This Hike’s Photos" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos dieser Wanderung"
          }
