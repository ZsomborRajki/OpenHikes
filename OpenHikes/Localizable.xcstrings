    "Restore couldn’t be completed. %@ Nothing has changed — you can try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung konnte nicht abgeschlossen werden. %@ Es hat sich nichts geändert – du kannst es gleich noch einmal versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido completar la restauración. %@ No ha cambiado nada: puedes volver a intentarlo dentro de un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration n’a pas pu aboutir. %@ Rien n’a changé – vous pouvez réessayer dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile completare il ripristino. %@ Non è cambiato nulla – puoi riprovare tra poco."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się dokończyć przywracania. %@ Nic się nie zmieniło – możesz spróbować ponownie za chwilę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurarea nu a putut fi finalizată. %@ Nu s-a modificat nimic – puteți reîncerca peste puțin timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось завершить восстановление. %@ Ничего не изменилось — можно повторить попытку чуть позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завершити відновлення. %@ Нічого не змінилося — можна спробувати ще раз трохи згодом."
          }
        }
      }
    },
