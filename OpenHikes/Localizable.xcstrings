        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danos tu opinión o informa de un problema en GitHub. Indica la versión que aparece arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez votre avis ou signalez un problème sur GitHub. Merci d’indiquer la version ci-dessus."
