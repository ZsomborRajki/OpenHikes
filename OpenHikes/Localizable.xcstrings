    },
    "%@ — resized before sending, with camera details and original location data removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – vor dem Senden verkleinert, Kameradetails und ursprüngliche Ortsdaten entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – redimensionnement avant l’envoi, sans les informations de l’appareil photo ni la position d’origine."
          }
        }
      }
    },
    "%@ — resized before sending, with camera details and original location data removed. Your route, your notes and this hike’s name stay on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – vor dem Senden verkleinert, Kameradetails und ursprüngliche Ortsdaten entfernt. Deine Route, deine Notizen und der Name dieser Wanderung bleiben auf deinem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – redimensionnement avant l’envoi, sans les informations de l’appareil photo ni la position d’origine. Votre itinéraire, vos notes et le nom de cette randonnée restent sur votre appareil."
          }
        }
      }
    },
