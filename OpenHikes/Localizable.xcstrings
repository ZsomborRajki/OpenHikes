    "What it covered so far is kept as a record. A hike under 100 m is not." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was bisher zurückgelegt wurde, bleibt als Eintrag erhalten. Eine Wanderung unter 100 m nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo recorrido hasta ahora se conserva como registro. Una excursión de menos de 100 m, no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui a été parcouru jusqu’ici est conservé. Ce n’est pas le cas d’une randonnée de moins de 100 m."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ono što je dosad prijeđeno čuva se kao zapis. Tura kraća od 100 m ne čuva se."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tratto percorso finora viene conservato. Un’escursione di meno di 100 m no."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat er tot nu toe is afgelegd, blijft bewaard als verslag. Een wandeling korter dan 100 m niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, co dotąd przebyto, zostaje zachowane w historii. Wędrówka krótsza niż 100 m – nie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porțiunea parcursă până acum este păstrată ca parcurgere. O drumeție mai scurtă de 100 m nu este păstrată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройденное до этого момента сохраняется в истории. Поход короче 100 м не сохраняется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пройдене до цього моменту буде збережено. Похід, коротший за 100 м, не зберігається."
          }
        }
      }
    },
