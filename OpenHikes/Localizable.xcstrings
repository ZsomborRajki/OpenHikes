    "Leave out any photo that shouldn’t be published. The rest still go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass jedes Foto weg, das nicht veröffentlicht werden soll. Die übrigen werden trotzdem gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluye las fotos que no deban publicarse. Las demás se enviarán igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluez les photos qui ne doivent pas être publiées. Les autres seront tout de même envoyées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izostavite svaku fotografiju koju ne treba objaviti. Ostale se i dalje šalju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escludi le foto che non devono essere pubblicate. Le altre verranno inviate comunque."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat elke foto weg die niet gepubliceerd moet worden. De rest gaat gewoon mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiń każde zdjęcie, które nie powinno zostać opublikowane. Pozostałe i tak zostaną opublikowane."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excludeți orice poză care nu trebuie publicată. Celelalte vor fi trimise oricum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключите фото, которые не следует публиковать. Остальные будут опубликованы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виключіть фото, які не слід публікувати. Решту все одно буде опубліковано."
          }
        }
      }
    },
