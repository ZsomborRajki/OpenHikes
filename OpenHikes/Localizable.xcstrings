          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep eerst de beginhendel naar het nieuwe begin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw przeciągnij uchwyt początku na nowy start."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trageți mai întâi mânerul de început la noul punct de plecare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала перетяните начальный маркер на новое начало."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу перетягніть початковий маркер на новий початок."
          }
        }
      }
    },
    "Drag the two handles to the ends of the stretch, here or on the map." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die beiden Griffe an die Enden des Teilstücks, hier oder auf der Karte."
          }
        },
        "es" : {
