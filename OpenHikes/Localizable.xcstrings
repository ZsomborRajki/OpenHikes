    "Your iCloud storage is full. Free up space to keep syncing your hikes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iCloud-Speicher ist voll. Gib Speicherplatz frei, damit deine Wanderungen weiter synchronisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu almacenamiento de iCloud está lleno. Libera espacio para seguir sincronizando tus excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre espace de stockage iCloud est saturé. Libérez de l’espace pour continuer à synchroniser vos randonnées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaša iCloud pohrana je puna. Oslobodite prostor kako biste nastavili sinkronizirati ture."
