    "Matched by the time and place each photo was taken. Nothing is added until you tap Add." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Zeit und Ort der Aufnahme jedes Fotos zugeordnet. Nichts wird hinzugefügt, bevor du auf „Hinzufügen“ tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asociadas por la hora y el lugar en que se tomó cada foto. No se añade nada hasta que tocas «Añadir»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associées selon l’heure et le lieu de prise de vue de chaque photo. Rien n’est ajouté tant que vous ne touchez pas « Ajouter »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbinate in base all’ora e al luogo in cui è stata scattata ciascuna foto. Non viene aggiunto nulla finché non tocchi «Aggiungi»."
          }
        }
      }
    },
