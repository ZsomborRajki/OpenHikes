    "OpenHikes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes"
          }
        }
      }
    },
    "OpenHikes can find photos in your library taken during this hike, and pin each one to the trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes kann Fotos in deiner Mediathek finden, die während dieser Wanderung aufgenommen wurden, und jedes auf dem Weg verorten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes puede encontrar en tu fototeca las fotos tomadas durante esta excursión y colocar cada una en el sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes peut trouver dans votre photothèque les photos prises pendant cette randonnée, et placer chacune d’elles sur le sentier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes può trovare nella tua libreria le foto scattate durante questa escursione e collocarle ciascuna sul sentiero."
          }
        }
      }
    },
    "OpenHikes can only see the photos you’ve shared with it, and none of those were taken during this hike. Share more to look again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes sieht nur die Fotos, die du freigegeben hast, und keines davon wurde während dieser Wanderung aufgenommen. Gib weitere frei, um erneut zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes solo puede ver las fotos a las que le has dado acceso, y ninguna se tomó durante esta excursión. Dale acceso a más fotos para volver a buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ne voit que les photos auxquelles vous lui avez donné accès, et aucune n’a été prise pendant cette randonnée. Donnez accès à d’autres photos pour chercher à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes può vedere solo le foto a cui le hai dato accesso, e nessuna di queste è stata scattata durante questa escursione. Consenti l’accesso ad altre foto per cercare di nuovo."
          }
        }
      }
    },
    "OpenHikes couldn’t open its saved hikes. This launch is using temporary storage, so changes won’t survive a relaunch. Existing data was left untouched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes konnte seine gespeicherten Wanderungen nicht öffnen. Dieser Start verwendet einen temporären Speicher, daher bleiben Änderungen nach einem Neustart nicht erhalten. Vorhandene Daten wurden nicht verändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no ha podido abrir sus excursiones guardadas. Esta sesión usa almacenamiento temporal, así que los cambios se perderán al volver a abrir la app. Los datos existentes no se han modificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas pu ouvrir ses randonnées enregistrées. Ce lancement utilise un stockage temporaire : les modifications seront perdues au prochain lancement. Les données existantes n’ont pas été modifiées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha potuto aprire le escursioni salvate. Questo avvio usa uno spazio temporaneo, quindi le modifiche non sopravvivranno a un nuovo avvio. I dati esistenti non sono stati toccati."
          }
        }
      }
    },
    "OpenHikes couldn’t reach Apple Weather. It will try again automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes konnte Apple Wetter nicht erreichen. Es wird automatisch erneut versucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no ha podido conectar con Tiempo de Apple. Lo volverá a intentar automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas pu joindre Météo Apple. Une nouvelle tentative aura lieu automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha potuto raggiungere Meteo di Apple. Riproverà automaticamente."
          }
        }
      }
    },
    "OpenHikes couldn’t read the other hikes’ offline coverage. No tiles were deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes konnte die Offlineabdeckung der anderen Wanderungen nicht lesen. Es wurden keine Kacheln gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no ha podido leer la cobertura sin conexión de las demás excursiones. No se ha eliminado ninguna tesela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas pu lire la couverture hors ligne des autres randonnées. Aucune tuile n’a été supprimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha potuto leggere la copertura offline delle altre escursioni. Nessun tassello è stato eliminato."
          }
        }
      }
    },
    "OpenHikes couldn’t record the change, so no tiles were deleted. This hike’s saved map is still on your device. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes konnte die Änderung nicht vermerken, daher wurden keine Kacheln gelöscht. Die gespeicherte Karte dieser Wanderung ist weiterhin auf deinem Gerät. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no ha podido registrar el cambio, así que no se ha eliminado ninguna tesela. El mapa guardado de esta excursión sigue en tu dispositivo. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas pu prendre en compte la modification, aucune tuile n’a donc été supprimée. La carte enregistrée de cette randonnée est toujours sur votre appareil. Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha potuto memorizzare la modifica, quindi nessun tassello è stato eliminato. La mappa salvata di questa escursione è ancora sul tuo dispositivo. Riprova."
          }
        }
      }
    },
    "OpenHikes couldn’t store the photo you just took, so it hasn’t been added to this hike. Check that your device has free space and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes konnte das gerade aufgenommene Foto nicht speichern, daher wurde es dieser Wanderung nicht hinzugefügt. Prüfe, ob auf deinem Gerät Speicherplatz frei ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no ha podido almacenar la foto que acabas de tomar, así que no se ha añadido a esta excursión. Comprueba que tu dispositivo tenga espacio libre y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas pu stocker la photo que vous venez de prendre, elle n’a donc pas été ajoutée à cette randonnée. Vérifiez que votre appareil dispose d’espace libre et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha potuto memorizzare la foto che hai appena scattato, quindi non è stata aggiunta a questa escursione. Verifica che il dispositivo abbia spazio libero e riprova."
          }
        }
      }
    },
    "OpenHikes couldn’t work out which day that is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes konnte nicht ermitteln, welcher Tag das ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no ha podido determinar qué día es ese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas pu déterminer de quel jour il s’agit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha potuto capire di che giorno si tratta."
          }
        }
      }
    },
    "OpenHikes doesn’t have Always location access, so this can’t run. Turn it on in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes hat keinen Standortzugriff „Immer“, daher kann dies nicht laufen. Aktiviere ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no tiene acceso «Siempre» a la ubicación, así que esto no puede funcionar. Actívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas l’accès « Toujours » à votre position, cette fonction ne peut donc pas s’exécuter. Activez-le dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha l’accesso «Sempre» alla posizione, quindi questa funzione non può essere eseguita. Attivalo in Impostazioni."
          }
        }
      }
    },
    "OpenHikes hasn’t been able to refresh this reading, so it’s shown dimmed on the map." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes konnte diesen Messwert nicht aktualisieren, daher wird er auf der Karte abgeblendet angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no ha podido actualizar esta lectura, así que se muestra atenuada en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’a pas pu actualiser ce relevé, il est donc estompé sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non ha potuto aggiornare questo dato, quindi è mostrato attenuato sulla mappa."
          }
        }
      }
    },
    "OpenHikes is already recording a hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes zeichnet bereits eine Wanderung auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ya está grabando una excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes enregistre déjà une randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes sta già registrando un’escursione."
          }
        }
      }
    },
    "OpenHikes is still finishing your last recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes schließt deine letzte Aufzeichnung noch ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes aún está terminando tu última grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes termine encore votre dernier enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes sta ancora completando la tua ultima registrazione."
          }
        }
      }
    },
    "OpenHikes isn’t ready on your iPhone yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ist auf deinem iPhone noch nicht bereit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app aún no está lista en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’est pas encore prêt sur votre iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non è ancora pronta sul tuo iPhone."
          }
        }
      }
    },
    "OpenHikes isn’t recording a hike right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes zeichnet gerade keine Wanderung auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes no está grabando ninguna excursión ahora mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes n’enregistre aucune randonnée pour le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes non sta registrando un’escursione in questo momento."
          }
        }
      }
    },
    "OpenHikes needs location access to show where you are and the weather around you. Turn it on in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht Standortzugriff, um anzuzeigen, wo du bist und wie das Wetter um dich herum ist. Aktiviere ihn in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita acceso a la ubicación para mostrar dónde estás y el tiempo a tu alrededor. Actívalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin d’accéder à votre position pour afficher où vous êtes et la météo autour de vous. Activez cet accès dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno dell’accesso alla posizione per mostrarti dove ti trovi e il meteo intorno a te. Attivalo in Impostazioni."
          }
        }
      }
    },
    "OpenHikes needs the camera to take photos. You can still add photos from your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht die Kamera, um Fotos aufzunehmen. Du kannst weiterhin Fotos aus deiner Mediathek hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita la cámara para tomar fotos. Aun así, puedes añadir fotos de tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin de l’appareil photo pour prendre des photos. Vous pouvez toujours ajouter des photos depuis votre photothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno della fotocamera per scattare foto. Puoi comunque aggiungere foto dalla tua libreria."
          }
        }
      }
    },
    "OpenHikes needs to read your photo library to find pictures taken during this hike. You can turn that on in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes muss deine Mediathek lesen, um Bilder zu finden, die während dieser Wanderung aufgenommen wurden. Du kannst das in den Einstellungen aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita leer tu fototeca para encontrar las fotos tomadas durante esta excursión. Puedes activarlo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes doit accéder à votre photothèque pour trouver les photos prises pendant cette randonnée. Vous pouvez activer cet accès dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes deve leggere la tua libreria foto per trovare le immagini scattate durante questa escursione. Puoi attivare l’accesso in Impostazioni."
          }
        }
      }
    },
    "OpenHikes needs your location before it can pick your hike back up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht deinen Standort, bevor es deine Wanderung wieder aufnehmen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita tu ubicación para poder retomar tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin de votre position avant de pouvoir reprendre votre randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno della tua posizione per poter riprendere l’escursione."
          }
        }
      }
    },
    "OpenHikes needs your location before it can record a hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht deinen Standort, bevor es eine Wanderung aufzeichnen kann."
          }
        },
