    "Publishing makes this visible to everybody, immediately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Veröffentlichen ist dies sofort für alle sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al publicar, esto será visible para todo el mundo de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication rend ce contenu visible par tous, immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la pubblicazione diventa subito visibile a tutti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po opublikowaniu od razu zobaczą to wszyscy."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prin publicare, conținutul devine vizibil imediat pentru toată lumea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После публикации это сразу увидят все."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після публікації це одразу побачать усі."
          }
        }
      }
    },
    "Publishing puts these on the trail for everybody, immediately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Veröffentlichen erscheinen diese sofort für alle auf dem Weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al publicar, estas fotos aparecerán en el sendero para todo el mundo de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication les ajoute au sentier pour tout le monde, immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la pubblicazione compaiono subito sul sentiero, visibili a tutti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po opublikowaniu od razu pojawią się na szlaku u wszystkich."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prin publicare, acestea apar imediat pe traseu pentru toată lumea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После публикации они сразу появятся на тропе для всех."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після публікації вони одразу зʼявляться на стежці для всіх."
          }
        }
      }
    },
    "Publishing waits for the description and photographs to load." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
