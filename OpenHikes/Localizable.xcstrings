    "It isn’t on this device yet. Try again once iCloud has caught up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist noch nicht auf diesem Gerät. Versuche es erneut, sobald iCloud auf dem neuesten Stand ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no está en este dispositivo. Vuelve a intentarlo cuando iCloud se haya puesto al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’est pas encore sur cet appareil. Réessayez une fois iCloud à jour."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nije na ovom uređaju. Pokušajte ponovno kad iCloud sustigne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è ancora su questo dispositivo. Riprova quando iCloud si sarà aggiornato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze staat nog niet op dit apparaat. Probeer het opnieuw zodra iCloud is bijgewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ma jej jeszcze na tym urządzeniu. Spróbuj ponownie, gdy iCloud zakończy synchronizację."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu se află încă pe acest dispozitiv. Reîncercați după ce iCloud termină sincronizarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его еще нет на этом устройстве. Повторите попытку, когда iCloud закончит синхронизацию."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Його ще немає на цьому пристрої. Спробуйте ще раз, коли iCloud завершить синхронізацію."
          }
        }
      }
    },
    "It may have been taken down. Pull the list again to refresh it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung wurde möglicherweise entfernt. Aktualisiere die Liste, indem du sie nach unten ziehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que se haya retirado. Desliza la lista hacia abajo para actualizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée a peut-être été retirée. Tirez la liste vers le bas pour l’actualiser."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možda je uklonjena. Ponovno povucite popis kako biste ga osvježili."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe essere stata rimossa. Trascina di nuovo l’elenco per aggiornarlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze is mogelijk offline gehaald. Trek de lijst omlaag om te vernieuwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możliwe, że publikacja została wycofana. Pociągnij listę ponownie, aby ją odświeżyć."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este posibil să fi fost retrasă. Trageți din nou lista pentru a o reîmprospăta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, публикация снята. Потяните список еще раз, чтобы обновить его."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, похід знято з публікації. Потягніть список донизу, щоб оновити його."
          }
        }
      }
    },
    "It may not be a GPX file, or its points are missing coordinates or out of range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise ist es keine GPX-Datei, oder Punkten darin fehlen Koordinaten oder sie liegen außerhalb des gültigen Bereichs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que no sea un archivo GPX, o que sus puntos no tengan coordenadas o estén fuera de rango."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s’agit peut-être pas d’un fichier GPX, ou ses points n’ont pas de coordonnées ou sont hors limites."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možda nije GPX datoteka ili njezinim točkama nedostaju koordinate ili su izvan raspona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe non essere un file GPX, oppure i suoi punti non hanno coordinate o sono fuori intervallo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is mogelijk geen GPX-bestand, of de punten erin missen coördinaten of liggen buiten bereik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Być może nie jest to plik GPX albo jego punkty nie mają współrzędnych lub są poza zakresem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este posibil să nu fie un fișier GPX sau ca punctele sale să nu aibă coordonate ori să fie în afara limitelor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, это не файл GPX, либо у его точек нет координат или они вне допустимого диапазона."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, це не файл GPX або його точки не мають координат чи виходять за допустимі межі."
          }
        }
      }
    },
    "It stops appearing for everybody, and the route and photographs behind it are deleted for good. This can’t be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung wird für niemanden mehr angezeigt, und die Route und die Fotos dahinter werden endgültig gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejará de aparecer para todo el mundo, y la ruta y las fotografías que contiene se eliminarán para siempre. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée ne sera plus visible pour personne, et son itinéraire et ses photos seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prestaje se prikazivati svima, a ruta i fotografije iza nje trajno se brišu. Ovo se ne može poništiti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smette di comparire per tutti, e il percorso e le fotografie collegati vengono eliminati definitivamente. L’operazione non può essere annullata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze verdwijnt voor iedereen, en de route en foto’s erachter worden definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publikacja przestanie być widoczna dla wszystkich, a jej trasa i zdjęcia zostaną trwale usunięte. Tej czynności nie można cofnąć."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu va mai apărea pentru nimeni, iar ruta și pozele sale vor fi șterse definitiv. Această acțiune nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поход перестанет показываться всем, а его маршрут и фото будут удалены безвозвратно. Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похід більше ніхто не побачить, а його маршрут і фото буде видалено назавжди. Цю дію не можна відмінити."
          }
        }
      }
    },
    "It’ll appear for other hikers once it’s been checked." : {
      "localizations" : {
