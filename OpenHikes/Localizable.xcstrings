      }
    },
    "Saved from the community" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus der Community gespeichert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrée depuis la communauté"
          }
        }
      }
    },
    "Saved Hikes Unavailable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Wanderungen nicht verfügbar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randonnées enregistrées indisponibles"
          }
        }
      }
    },
    "Saved maps from %@ are full. Its license allows %@ of saved tiles on this device, across all its map styles — delete another saved map to make room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherten Karten von %1$@ sind voll. Die Lizenz erlaubt %2$@ an gespeicherten Kacheln auf diesem Gerät, über alle Kartenstile hinweg – lösche eine andere gespeicherte Karte, um Platz zu schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved maps from %1$@ are full. Its license allows %2$@ of saved tiles on this device, across all its map styles — delete another saved map to make room."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes enregistrées de %1$@ ont atteint leur limite. Sa licence autorise %2$@ de tuiles enregistrées sur cet appareil, tous styles de carte confondus – supprimez une autre carte enregistrée pour libérer de l’espace."
          }
        }
      }
    },
    "Saved maps keep your hikes usable without a signal. The map cache holds recently viewed maps, up to %@. Clearing it doesn’t touch saved maps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Karten halten deine Wanderungen ohne Empfang nutzbar. Der Kartencache enthält kürzlich angesehene Karten, bis zu %@. Ihn zu leeren betrifft keine gespeicherten Karten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes enregistrées permettent d’utiliser vos randonnées sans réseau. Le cache des cartes contient les cartes consultées récemment, jusqu’à %@. Le vider n’affecte pas les cartes enregistrées."
          }
        }
      }
    },
    "Saves each hike you record to the Health app as a hiking workout with its route. Deleting the hike also removes the workout." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert jede aufgezeichnete Wanderung als Wandertraining mit ihrer Route in der Health-App. Wenn du die Wanderung löschst, wird auch das Training entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
