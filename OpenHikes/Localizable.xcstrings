    "Live for other hikers. Add photos you’ve taken since, or ask for the hike to be taken down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für andere sichtbar. Füge Fotos hinzu, die du seitdem aufgenommen hast, oder bitte darum, die Wanderung zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicada para otras personas. Añade las fotos que hayas tomado después o pide que se retire la excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visible par d’autres personnes. Ajoutez les photos prises depuis, ou demandez le retrait de la randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visibile alle altre persone. Aggiungi le foto scattate da allora, oppure chiedi che l’escursione venga rimossa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opublikowano dla innych osób. Dodaj zdjęcia zrobione od tamtej pory albo poproś o wycofanie publikacji wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vizibilă pentru alte persoane. Adăugați pozele făcute între timp sau solicitați retragerea drumeției."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опубликовано для других туристов. Добавьте фото, снятые с тех пор, или попросите снять поход с публикации."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опубліковано для інших туристів. Додайте фото, зняті відтоді, або попросіть зняти похід з публікації."
          }
        }
      }
    },
    "Live Progress" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Fortschritt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso en directo"
          }
        },
        "fr" : {
          "stringUnit" : {
