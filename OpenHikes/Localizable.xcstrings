    "%@ — resized before sending, with camera details and original location data removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – vor dem Senden verkleinert, Kameradetails und ursprüngliche Ortsdaten entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con reducción de tamaño antes del envío y sin los datos de la cámara ni la ubicación original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – redimensionnement avant l’envoi, sans les informations de l’appareil photo ni la position d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con ridimensionamento prima dell’invio e rimozione dei dati della fotocamera e della posizione originale."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – zmniejszone przed wysłaniem, bez danych aparatu i pierwotnych danych o położeniu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – cu redimensionare înainte de trimitere și fără detaliile camerei sau datele de localizare originale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — перед отправкой размер уменьшается, а сведения о камере и исходные данные о геопозиции удаляются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — перед надсиланням розмір фото зменшується, а відомості про камеру й початкові дані геопозиції вилучаються."
          }
        }
      }
    },
    "%@ — resized before sending, with camera details and original location data removed. Your route, your notes and this hike’s name stay on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – vor dem Senden verkleinert, Kameradetails und ursprüngliche Ortsdaten entfernt. Deine Route, deine Notizen und der Name dieser Wanderung bleiben auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con reducción de tamaño antes del envío y sin los datos de la cámara ni la ubicación original. Tu ruta, tus notas y el nombre de esta excursión se quedan en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – redimensionnement avant l’envoi, sans les informations de l’appareil photo ni la position d’origine. Votre itinéraire, vos notes et le nom de cette randonnée restent sur votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con ridimensionamento prima dell’invio e rimozione dei dati della fotocamera e della posizione originale. Il percorso, le note e il nome di questa escursione restano sul tuo dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – zmniejszone przed wysłaniem, bez danych aparatu i pierwotnych danych o położeniu. Twoja trasa, Twoje notatki i nazwa tej wędrówki zostają na Twoim urządzeniu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – cu redimensionare înainte de trimitere și fără detaliile camerei sau datele de localizare originale. Ruta, notițele și numele acestei drumeții rămân pe dispozitivul dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — перед отправкой размер уменьшается, а сведения о камере и исходные данные о геопозиции удаляются. Ваш маршрут, заметки и название этого похода остаются на вашем устройстве."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — перед надсиланням розмір фото зменшується, а відомості про камеру й початкові дані геопозиції вилучаються. Ваш маршрут, нотатки й назва цього походу залишаються на вашому пристрої."
          }
        }
      }
    },
