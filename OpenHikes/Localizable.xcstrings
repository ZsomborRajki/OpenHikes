                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Al publicar se eliminan para siempre las %lld fotos atenuadas del envío. Las demás se envían igualmente."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Al publicar se elimina para siempre la foto atenuada del envío. Las demás se envían igualmente."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
