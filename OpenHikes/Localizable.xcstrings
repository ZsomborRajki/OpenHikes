    "This trail has changed since the hike, so the stretches it covered can no longer be drawn along it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Weg hat sich seit der Wanderung geändert, daher können die zurückgelegten Abschnitte nicht mehr entlang des Weges gezeichnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sendero ha cambiado desde la excursión, así que los tramos recorridos ya no se pueden dibujar sobre él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sentier a changé depuis la randonnée : les tronçons parcourus ne peuvent plus y être tracés."
