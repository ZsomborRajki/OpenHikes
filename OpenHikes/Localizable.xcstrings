    "Paused — checking now and then in case you set off again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert – prüft ab und zu, ob du wieder losgehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: se comprueba de vez en cuando por si vuelves a ponerte en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause – vérification de temps en temps au cas où vous repartiriez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzirano – povremeno se provjerava jeste li ponovno krenuli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa – con un controllo di tanto in tanto, nel caso tu riparta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gepauzeerd – af en toe wordt gecontroleerd of je weer vertrekt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymano – OpenHikes sprawdza co jakiś czas, czy ruszasz dalej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În pauză – se verifică din când în când dacă porniți din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На паузе — время от времени проверяется, не двинулись ли вы дальше."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупинено — час від часу перевіряється, чи ви не рушили далі."
          }
        }
      }
    },
    "Pauses a recording when you stop somewhere for five minutes, and resumes it when you walk on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält eine Aufzeichnung an, wenn du fünf Minuten an einem Ort bleibst, und setzt sie fort, sobald du weitergehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone en pausa una grabación cuando te detienes cinco minutos en un sitio y la reanuda cuando sigues caminando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met un enregistrement en pause lorsque vous vous arrêtez cinq minutes quelque part, et le reprend lorsque vous repartez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzira snimanje kad negdje stanete na pet minuta i nastavlja ga kad krenete dalje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa una registrazione quando ti fermi per cinque minuti in un posto e la riprende quando riparti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeert een opname als je ergens vijf minuten stilstaat, en hervat haar als je verder loopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje nagrywanie, gdy zatrzymasz się gdzieś na pięć minut, i wznawia je, gdy ruszysz dalej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendă înregistrarea când vă opriți undeva timp de cinci minute și o continuă când porniți din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставит запись на паузу, когда вы останавливаетесь где-нибудь на пять минут, и возобновляет ее, когда вы идете дальше."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупиняє запис, коли ви зупиняєтеся десь на пʼять хвилин, і поновлює його, коли ви рушаєте далі."
          }
        }
      }
    },
    "Pauses the hike being recorded, and turns the GPS off until you resume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert die aufgezeichnete Wanderung und schaltet GPS aus, bis du fortsetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la excursión que se está grabando y apaga el GPS hasta que la reanudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause la randonnée en cours d’enregistrement et désactive le GPS jusqu’à ce que vous la repreniez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzira turu koja se snima i isključuje GPS dok ne nastavite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa l’escursione in registrazione e spegne il GPS finché non riprendi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeert de wandeling die wordt opgenomen, en zet de GPS uit tot je hervat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje nagrywaną wędrówkę i wyłącza GPS do chwili wznowienia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendă drumeția în curs de înregistrare și oprește GPS‑ul până când o continuați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостанавливает запись похода и выключает GPS, пока вы ее не возобновите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупиняє запис походу й вимикає GPS, доки ви його не поновите."
          }
        }
      }
    },
    "Pauses the hike being recorded, from its Lock Screen panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert die aufgezeichnete Wanderung über ihre Anzeige auf dem Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la excursión que se está grabando, desde su panel en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause la randonnée en cours d’enregistrement, depuis son panneau sur l’écran verrouillé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzira turu koja se snima, s ploče na zaključanom zaslonu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa l’escursione in registrazione, dal suo pannello nella schermata di blocco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeert de wandeling die wordt opgenomen, vanaf het paneel op het toegangsscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje nagrywaną wędrówkę z jej panelu na ekranie blokady."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendă drumeția în curs de înregistrare, din panoul de pe ecranul de blocare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостанавливает запись похода с ее панели на экране блокировки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупиняє запис походу з його панелі на замкненому екрані."
          }
        }
      }
    },
    "Pausing it could not be saved, so the hike is still under way. Try pausing it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pause konnte nicht gespeichert werden, daher läuft die Wanderung noch. Versuche erneut, sie zu pausieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la pausa, así que la excursión sigue en curso. Intenta pausarla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise en pause n’a pas pu être sauvegardée, la randonnée est donc toujours en cours. Réessayez de la mettre en pause."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauza se nije mogla spremiti, pa je tura još u tijeku. Pokušajte je ponovno pauzirati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare la pausa, quindi l’escursione è ancora in corso. Prova di nuovo a metterla in pausa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De pauze kon niet worden bewaard, dus de wandeling loopt nog. Probeer haar opnieuw te pauzeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać wstrzymania, więc wędrówka nadal trwa. Spróbuj wstrzymać ją ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendarea nu a putut fi salvată, deci drumeția este încă în desfășurare. Încercați din nou să o suspendați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить паузу, поэтому поход все еще идет. Попробуйте приостановить его снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти призупинення, тому похід досі триває. Спробуйте призупинити його ще раз."
          }
        }
      }
    },
