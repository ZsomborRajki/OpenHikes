    "Resume it, stop to save it, or discard it below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze sie fort, beende sie zum Speichern oder verwirf sie unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanúdala, detenla para guardarla o descártala abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez-le, arrêtez-le pour le sauvegarder ou supprimez-le ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendila, interrompila per salvarla oppure scartala qui sotto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wznów je, zatrzymaj, aby je zapisać, albo odrzuć poniżej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuați-o, opriți-o pentru a o salva sau abandonați-o mai jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возобновите ее, остановите, чтобы сохранить, или удалите ниже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поновіть його, зупиніть, щоб зберегти, або видаліть нижче."
          }
        }
      }
    },
    "Resumes the paused hike, from its Lock Screen panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die pausierte Wanderung über ihre Anzeige auf dem Sperrbildschirm fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanuda la excursión en pausa, desde su panel en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend la randonnée en pause, depuis son panneau sur l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprende l’escursione in pausa, dal suo pannello nella schermata di blocco."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wznawia wstrzymaną wędrówkę z jej panelu na ekranie blokady."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuă drumeția suspendată, din panoul de pe ecranul de blocare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возобновляет приостановленный поход с его панели на экране блокировки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поновлює призупинений похід з його панелі на замкненому екрані."
          }
        }
      }
    },
    "Resuming it could not be saved, so the hike is still paused. Try resuming it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fortsetzen konnte nicht gespeichert werden, daher ist die Wanderung noch pausiert. Versuche erneut, sie fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la reanudación, así que la excursión sigue en pausa. Intenta reanudarla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reprise n’a pas pu être enregistrée, la randonnée est donc toujours en pause. Réessayez de la reprendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare la ripresa, quindi l’escursione è ancora in pausa. Prova di nuovo a riprenderla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać wznowienia, więc wędrówka jest nadal wstrzymana. Spróbuj wznowić ją ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reluarea nu a putut fi salvată, așa că drumeția este încă suspendată. Încercați din nou s-o continuați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить возобновление, поэтому поход все еще на паузе. Попробуйте возобновить его еще раз."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти стан походу, тому його досі призупинено. Спробуйте поновити його ще раз."
          }
        }
      }
    },
