        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделенная линия идет через разрыв по тропе, нанесенной на карту."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виділена лінія проходить через розрив стежкою, нанесеною на карту."
          }
        }
      }
    },
    "The highlighted section has more than one plausible route." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den hervorgehobenen Abschnitt gibt es mehr als eine plausible Route."
