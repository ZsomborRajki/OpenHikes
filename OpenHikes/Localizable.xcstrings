    "A hike is in progress on %@. End it there to hike this trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ läuft gerade eine Wanderung. Beende sie dort, um diesen Weg zu wandern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una excursión en curso en %@. Termínala allí para recorrer este sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une randonnée est en cours sur %@. Terminez-la pour parcourir ce sentier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na uređaju %@ u tijeku je tura. Završite je ondje kako biste prošli ovom stazom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso un’escursione su %@. Terminala lì per percorrere questo sentiero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er loopt een wandeling op %@. Beëindig die daar om dit pad te wandelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa wędrówka na szlaku „%@”. Zakończ ją tam, aby przejść ten szlak."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Există o drumeție în curs pe %@. Încheiați-o acolo pentru a parcurge acest traseu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идет поход по тропе «%@». Завершите его там, чтобы пройти эту тропу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Триває проходження стежки «%@». Завершіть його там, щоб пройти цю стежку."
          }
        }
      }
    },
    "A hike needs a title. Put one back to publish this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Wanderung braucht einen Titel. Gib wieder einen ein, um sie zu veröffentlichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una excursión necesita un título. Vuelve a ponerle uno para publicarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une randonnée doit avoir un titre. Ajoutez-en un pour la publier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tura mora imati naziv. Unesite ga ponovno kako biste je objavili."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’escursione ha bisogno di un titolo. Aggiungine uno per pubblicarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wandeling heeft een titel nodig. Vul er weer een in om dit te publiceren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wędrówka musi mieć nazwę. Przywróć ją, aby opublikować tę wędrówkę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drumeție are nevoie de un titlu. Adăugați unul pentru a o publica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Походу нужно название. Верните его, чтобы опубликовать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Походу потрібна назва. Поверніть її, щоб опублікувати похід."
          }
        }
      }
    },
    "A hike needs at least two points to have a route." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Wanderung braucht mindestens zwei Punkte, um eine Route zu haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una excursión necesita al menos dos puntos para tener una ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une randonnée doit comporter au moins deux points pour avoir un itinéraire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tura treba najmanje dvije točke da bi imala rutu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’escursione ha bisogno di almeno due punti per avere un percorso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wandeling heeft minstens twee punten nodig om een route te hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wędrówka potrzebuje co najmniej dwóch punktów, aby mieć trasę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O drumeție are nevoie de cel puțin două puncte pentru a avea o rută."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы у похода был маршрут, нужны хотя бы две точки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб похід мав маршрут, потрібно щонайменше дві точки."
          }
        }
      }
    },
    "A place is marked where you are standing. Try again once the hike has a location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Ort wird dort markiert, wo du stehst. Versuche es erneut, sobald die Wanderung einen Standort hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares se marcan donde te encuentras. Vuelve a intentarlo cuando la excursión tenga una ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieu est marqué là où vous vous trouvez. Réessayez quand la randonnée aura une position."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjesto se označava ondje gdje stojite. Pokušajte ponovno kad tura dobije lokaciju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il luogo viene segnato dove ti trovi. Riprova quando l’escursione avrà una posizione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een plaats wordt gemarkeerd waar je staat. Probeer het opnieuw zodra de wandeling een locatie heeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce jest oznaczane tam, gdzie stoisz. Spróbuj ponownie, gdy wędrówka będzie miała położenie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locul se marchează acolo unde vă aflați. Reîncercați când localizarea este disponibilă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место отмечается там, где вы стоите. Повторите попытку, когда у похода появится геопозиция."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місце позначається там, де ви стоїте. Спробуйте ще раз, коли похід отримає геопозицію."
          }
        }
      }
    },
