        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche les conditions et la source de ces prévisions"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le condizioni e la fonte di questa previsione"
          }
        }
      }
    },
    "Shows the map flat, from straight above." : {
