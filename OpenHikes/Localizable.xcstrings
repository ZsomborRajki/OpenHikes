            "value" : "Vaše ture čuvaju se u vašoj privatnoj iCloud pohrani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue escursioni sono conservate nel tuo spazio iCloud privato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wandelingen worden bewaard in je privé-iCloud-opslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje wędrówki są przechowywane w Twojej prywatnej przestrzeni w iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumețiile sunt păstrate în spațiul dvs. privat de stocare iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши походы хранятся в вашем личном хранилище iCloud."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші походи зберігаються у вашому приватному сховищі iCloud."
          }
        }
      }
    },
    "Your hikes couldn’t be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen konnten nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer tus excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire vos randonnées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše se ture nisu mogle pročitati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere le tue escursioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wandelingen konden niet worden gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać Twoich wędrówek."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-au putut citi drumețiile dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать ваши походы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати ваші походи."
          }
        }
      }
    },
    "Your hikes lose their offline maps, and the map cache is cleared too. Tiles re-download when you view maps online again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen verlieren ihre Offlinekarten, und auch der Kartencache wird geleert. Kacheln werden erneut geladen, wenn du Karten wieder online ansiehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus excursiones perderán sus mapas sin conexión, y también se borrará la caché de mapas. Las teselas se volverán a descargar cuando vuelvas a ver mapas con conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées perdront leurs cartes hors ligne, et le cache des cartes sera également vidé. Les tuiles seront à nouveau téléchargées lorsque vous consulterez des cartes en ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše ture gube izvanmrežne karte, a briše se i predmemorija karte. Pločice se ponovno preuzimaju kad opet pregledavate karte na mreži."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue escursioni perdono le mappe offline, e anche la cache delle mappe viene svuotata. I tasselli verranno scaricati di nuovo quando visualizzerai le mappe online."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je wandelingen verliezen hun offline kaarten, en de kaartcache wordt ook gewist. Tegels worden opnieuw gedownload als je weer online kaarten bekijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje wędrówki stracą mapy offline, a pamięć podręczna map też zostanie wyczyszczona. Kafelki pobiorą się ponownie, gdy znów otworzysz mapy online."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumețiile își vor pierde hărțile offline, iar cache-ul hărților va fi și el șters. Dalele se vor descărca din nou când veți vizualiza hărțile online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши походы лишатся офлайн-карт, и кэш карт тоже будет очищен. Тайлы загрузятся заново, когда вы снова откроете карты в сети."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші походи втратять офлайн-карти, а кеш карт також буде очищено. Тайли буде викачано заново, коли ви знову переглядатимете карти онлайн."
          }
        }
      }
    },
    "Your hikes stay on this device only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen bleiben nur auf diesem Gerät."
