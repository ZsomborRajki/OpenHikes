    "Turn left at the junction" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biege an der Abzweigung links ab"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el cruce, gira a la izquierda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’intersection, tournez à gauche"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na raskrižju skrenite lijevo"
