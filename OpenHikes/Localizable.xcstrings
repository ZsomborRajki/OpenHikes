    "OpenStreetMap has nothing of these kinds here. Move the map to look somewhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenStreetMap hat hier nichts dieser Art. Bewege die Karte, um woanders zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
