    "Turn left at the junction" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biege an der Abzweigung links ab"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el cruce, gira a la izquierda"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’intersection, tournez à gauche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’incrocio, gira a sinistra"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na skrzyżowaniu skręć w lewo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La intersecție, virați la stânga"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На перекрестке поверните налево"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На перехресті поверніть ліворуч"
          }
        }
      }
    },
    "Turn left at the junction in %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bis zur Abzweigung: Biege links ab"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %@, gira a la izquierda en el cruce"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans %@, tournez à gauche à l’intersection"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra %@, all’incrocio gira a sinistra"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do skrzyżowania %@: skręć w lewo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peste %@, virați la stânga la intersecție"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До перекрестка %@: поверните налево"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "До перехрестя %@: поверніть ліворуч"
          }
        }
      }
    },
    "Turn off Low Power Mode or let the device cool, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktiviere den Stromsparmodus oder lass das Gerät abkühlen und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva el modo de bajo consumo o deja que el dispositivo se enfríe y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez le mode Économie d’énergie ou laissez l’appareil refroidir, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva la modalità risparmio energetico o lascia raffreddare il dispositivo, poi riprova."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz tryb „Niskie zużycie energii” lub poczekaj, aż urządzenie ostygnie, a potem spróbuj ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivați modul Consum redus sau lăsați dispozitivul să se răcească, apoi reîncercați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите режим энергосбережения или дайте устройству остыть, затем повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть режим економії заряду або дайте пристрою охолонути, а тоді спробуйте ще раз."
          }
        }
      }
    },
    "Turn on Follow in Details, then set off along the trail. Finished hikes are kept here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Folgen“ in den Details und mach dich dann auf den Weg. Abgeschlossene Wanderungen werden hier aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Seguir» en los detalles y ponte en marcha por el sendero. Las excursiones terminadas se guardan aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Suivre » dans les détails, puis mettez-vous en route sur le sentier. Les randonnées terminées sont conservées ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Segui» in «Dettagli», poi mettiti in cammino lungo il sentiero. Le escursioni terminate restano qui."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz „Podążaj” w sekcji „Szczegóły”, a potem ruszaj szlakiem. Ukończone wędrówki są przechowywane tutaj."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activați „Urmați” în „Detalii”, apoi porniți pe traseu. Drumețiile încheiate sunt păstrate aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
