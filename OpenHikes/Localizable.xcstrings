    "At least one photo couldn’t be added to this hike. It’s still in your photo library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens ein Foto konnte dieser Wanderung nicht hinzugefügt werden. Es ist weiterhin in deiner Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos una foto no se ha podido añadir a esta excursión. Sigue en tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins une photo n’a pas pu être ajoutée à cette randonnée. Elle se trouve toujours dans votre photothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aggiungere almeno una foto a questa escursione. Si trova ancora nella tua libreria foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co najmniej jednego zdjęcia nie udało się dodać do tej wędrówki. Nadal jest w Twojej bibliotece zdjęć."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cel puțin o poză nu a putut fi adăugată la această drumeție. Se află în continuare în biblioteca foto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось добавить в этот поход как минимум одно фото. Оно по-прежнему есть в вашей медиатеке."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося додати до цього походу щонайменше одне фото. Воно досі є у вашій фототеці."
          }
        }
      }
    },
    "At your pace you’ll reach the end of %@ around %@, and it’s dark from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei deinem Tempo erreichst du das Ende von %1$@ gegen %2$@, und ab %3$@ ist es dunkel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At your pace you’ll reach the end of %1$@ around %2$@, and it’s dark from %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tu ritmo llegarás al final de %1$@ hacia las %2$@, y es de noche desde las %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À votre rythme, vous atteindrez la fin de %1$@ vers %2$@, et il fait nuit dès %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tuo ritmo raggiungerai la fine di %1$@ verso le %2$@, e fa buio dalle %3$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Twoim tempie dotrzesz do końca szlaku „%1$@” około %2$@, a od %3$@ jest już ciemno."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În ritmul dvs., veți termina %1$@ în jurul orei %2$@, iar întunericul se lasă la %3$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вашем темпе вы дойдете до конца тропы «%1$@» около %2$@, а с %3$@ уже темно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вашому темпі ви дійдете до кінця стежки «%1$@» близько %2$@, а з %3$@ уже темно."
          }
        }
      }
    },
