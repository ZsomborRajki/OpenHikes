            "value" : "À %@ sur l’itinéraire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %@ lungo il percorso"
          }
        }
      }
    },
    "%@ already covers the same ground, so this hike stays in your own list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deckt bereits dieselbe Strecke ab, daher bleibt diese Wanderung in deiner eigenen Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya cubre el mismo recorrido, así que esta excursión se queda en tu propia lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ couvre déjà le même parcours : cette randonnée reste donc dans votre propre liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ copre già lo stesso tracciato, quindi questa escursione resta nel tuo elenco."
          }
        }
      }
    },
