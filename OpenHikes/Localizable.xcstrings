    "Adds buildings and small places such as water taps, toilets and benches. Downloads take about twice the space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt Gebäude und kleine Orte wie Wasserstellen, Toiletten und Bänke hinzu. Downloads brauchen etwa doppelt so viel Speicherplatz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade edificios y lugares pequeños como fuentes, aseos y bancos. Las descargas ocupan aproximadamente el doble de espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute les bâtiments et les petits lieux, comme les points d’eau, les toilettes et les bancs. Les téléchargements occupent environ deux fois plus d’espace."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje zgrade i mala mjesta poput slavina s vodom, zahoda i klupa. Preuzimanja zauzimaju otprilike dvostruko više prostora."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge edifici e piccoli luoghi come fontanelle, bagni e panchine. I download occupano circa il doppio dello spazio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt gebouwen en kleine plaatsen toe, zoals waterkranen, toiletten en bankjes. Downloads nemen ongeveer twee keer zoveel ruimte in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje budynki i małe miejsca, takie jak punkty z wodą pitną, toalety i ławki. Pobrane mapy zajmują mniej więcej dwa razy więcej miejsca."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă clădiri și locuri mici, precum cișmele, toalete și bănci. Descărcările ocupă de circa două ori mai mult spațiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет здания и небольшие места, например источники воды, туалеты и скамейки. Загрузки занимают примерно вдвое больше места."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає будівлі й невеликі місця, як-от джерела води, туалети й лавки. Викачані карти займають приблизно вдвічі більше місця."
          }
        }
      }
    },
    "Adds up everything you have hiked today." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt alles zusammen, was du heute gewandert bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma todo lo que has caminado hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
