        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie jest ciepłe – nagrywanie z dokładnością do dziesięciu metrów, dopóki nie ostygnie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivul s-a încălzit – se înregistrează cu o precizie de zece metri până se răcește."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройство нагрелось — запись идет с точностью до десяти метров, пока оно не остынет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пристрій нагрівся — запис іде з точністю до десяти метрів, доки він не охолоне."
          }
        }
      }
