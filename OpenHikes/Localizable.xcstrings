            "value" : "Nie udało się zaktualizować pamięci podręcznej sieci szlaków."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut actualiza memoria cache a rețelei de trasee."
          }
        },
        "ru" : {
          "stringUnit" : {
