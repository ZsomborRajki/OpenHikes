    "%lld of this hike’s photos are on the device they were added on, so they can’t be shared from here." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Eines der Fotos dieser Wanderung befindet sich auf dem Gerät, auf dem es hinzugefügt wurde, daher kann es nicht von hier aus geteilt werden."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Fotos dieser Wanderung befinden sich auf dem Gerät, auf dem sie hinzugefügt wurden, daher können sie nicht von hier aus geteilt werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "One of this hike’s photos is on the device it was added on, so it can’t be shared from here."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld of this hike’s photos are on the device they were added on, so they can’t be shared from here."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld de las fotos de esta excursión están en el dispositivo en el que se añadieron, así que no se pueden compartir desde aquí."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Una de las fotos de esta excursión está en el dispositivo en el que se añadió, así que no se puede compartir desde aquí."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld de las fotos de esta excursión están en el dispositivo en el que se añadieron, así que no se pueden compartir desde aquí."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photos de cette randonnée se trouvent uniquement sur l’appareil où elles ont été ajoutées : elles ne peuvent donc pas être partagées d’ici."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photo de cette randonnée se trouve uniquement sur l’appareil où elle a été ajoutée : elle ne peut donc pas être partagée d’ici."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photos de cette randonnée se trouvent uniquement sur l’appareil où elles ont été ajoutées : elles ne peuvent donc pas être partagées d’ici."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld foto di questa escursione si trovano sul dispositivo su cui sono state aggiunte, quindi non possono essere condivise da qui."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Una delle foto di questa escursione si trova sul dispositivo su cui è stata aggiunta, quindi non può essere condivisa da qui."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld foto di questa escursione si trovano sul dispositivo su cui sono state aggiunte, quindi non possono essere condivise da qui."
                }
              }
            }
          }
        }
      }
    },
    "%lld of this submission’s photos didn’t download, so none can be left out here — leaving one out rewrites the whole set from the copies on this device. Publish it as it is, decline it, or open it again." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Eines der Fotos dieser Einreichung wurde nicht geladen, daher kann hier keines weggelassen werden – wird eines weggelassen, wird der ganze Satz aus den Kopien auf diesem Gerät neu geschrieben. Veröffentliche sie so, wie sie ist, lehne sie ab oder öffne sie erneut."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Fotos dieser Einreichung wurden nicht geladen, daher kann hier keines weggelassen werden – wird eines weggelassen, wird der ganze Satz aus den Kopien auf diesem Gerät neu geschrieben. Veröffentliche sie so, wie sie ist, lehne sie ab oder öffne sie erneut."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "One of this submission’s photos didn’t download, so none can be left out here — leaving one out rewrites the whole set from the copies on this device. Publish it as it is, decline it, or open it again."
                }
              },
