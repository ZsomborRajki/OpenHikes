    "Track your hike with GPS. It keeps recording while your phone is locked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichne deine Wanderung per GPS auf. Die Aufzeichnung läuft weiter, während dein iPhone gesperrt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba tu excursión con GPS. Sigue grabando aunque el teléfono esté bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez votre randonnée par GPS. L’enregistrement continue même quand votre iPhone est verrouillé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratite svoju turu putem GPS-a. Snimanje se nastavlja dok je telefon zaključan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia la tua escursione con il GPS. La registrazione continua anche con il telefono bloccato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg je wandeling met GPS. De opname gaat door terwijl je telefoon vergrendeld is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywaj wędrówkę za pomocą GPS. Nagrywanie trwa także wtedy, gdy telefon jest zablokowany."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrați drumeția prin GPS. Înregistrarea continuă și când telefonul este blocat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
