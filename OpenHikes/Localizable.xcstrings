    "Unlists it for everybody and deletes the submission" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt den Eintrag für alle und löscht die Einreichung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retira de la lista para todo el mundo y elimina el envío"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire la fiche pour tout le monde et supprime la soumission"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja unos za sve i briše prijavu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La toglie dall’elenco per tutti ed elimina l’invio"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haalt de vermelding voor iedereen uit de lijst en verwijdert de inzending"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdejmuje z listy u wszystkich i usuwa wysłaną wędrówkę"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O elimină din listă pentru toată lumea și șterge trimiterea"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирает из списка для всех и удаляет заявку"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімає з публікації для всіх і видаляє заявку"
          }
        }
      }
    },
    "Unlocks on every device signed in to your Apple Account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird auf jedem Gerät freigeschaltet, das mit deinem Apple Account angemeldet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desbloquea en todos los dispositivos con sesión iniciada en tu cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se débloque sur tous les appareils connectés à votre compte Apple."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otključava se na svakom uređaju prijavljenom na vaš Apple račun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sblocca su tutti i dispositivi in cui hai effettuato l’accesso con il tuo Apple Account."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt ontgrendeld op elk apparaat waarop je met je Apple Account bent ingelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa na każdym urządzeniu zalogowanym na Twoim koncie Apple."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se deblochează pe toate dispozitivele pe care v-ați autentificat cu contul dvs. Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступно на всех устройствах, где выполнен вход в ваш Аккаунт Apple."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Діє на всіх пристроях, де виконано вхід у ваш обліковий запис Apple."
          }
        }
      }
    },
