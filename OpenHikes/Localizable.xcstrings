    "That hike isn’t paused." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist nicht pausiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa excursión no está en pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée n’est pas en pause."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta tura nije pauzirana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell’escursione non è in pausa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wandeling is niet gepauzeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wędrówka nie jest wstrzymana."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția respectivă nu este suspendată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот поход не на паузе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей похід не призупинено."
          }
        }
      }
    },
    "That hike was too short to keep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung war zu kurz, um sie zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa excursión era demasiado corta para conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée était trop courte pour être conservée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta je tura bila prekratka da bi se zadržala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell’escursione era troppo breve per essere conservata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wandeling was te kort om te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wędrówka była zbyt krótka, aby ją zachować."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția a fost prea scurtă pentru a fi păstrată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот поход слишком короткий, чтобы его сохранять."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей похід закороткий, щоб його зберегти."
          }
        }
      }
    },
    "That place couldn’t be found. Try another search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ort wurde nicht gefunden. Versuche eine andere Suche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado ese lugar. Prueba con otra búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lieu est introuvable. Essayez une autre recherche."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To mjesto nije pronađeno. Pokušajte s drugim pretraživanjem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare quel luogo. Prova un’altra ricerca."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die plaats kon niet worden gevonden. Probeer een andere zoekopdracht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono tego miejsca. Spróbuj innego wyszukiwania."
