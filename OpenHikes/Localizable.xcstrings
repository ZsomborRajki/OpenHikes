    "Photos from Wikimedia Commons, each under its own license. Open one to see who took it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos aus Wikimedia Commons, jedes unter seiner eigenen Lizenz. Öffne eines, um zu sehen, wer es aufgenommen hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos de Wikimedia Commons, cada una con su propia licencia. Abre una para ver quién la tomó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos de Wikimedia Commons, chacune sous sa propre licence. Ouvrez-en une pour voir qui l’a prise."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije s Wikimedia Commonsa, svaka pod vlastitom licencom. Otvorite jednu kako biste vidjeli tko ju je snimio."
