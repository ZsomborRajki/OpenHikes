    "Background Trail Tracking needs Always location access to keep your widget and Live Activity updating while OpenHikes is closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wegverfolgung im Hintergrund braucht den Standortzugriff „Immer“, damit dein Widget und deine Live-Aktivität weiter aktualisiert werden, während OpenHikes geschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento del sendero en segundo plano necesita el acceso «Siempre» a la ubicación para que tu widget y tu Actividad en directo sigan actualizándose mientras la app está cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi du sentier en arrière-plan nécessite l’accès à la position « Toujours » pour que votre widget et votre Activité en direct restent à jour lorsque OpenHikes est fermé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Monitoraggio del sentiero in background» ha bisogno dell’accesso «Sempre» alla posizione per mantenere aggiornati il widget e l’Attività in tempo reale mentre OpenHikes è chiusa."
          }
        }
      }
    },
