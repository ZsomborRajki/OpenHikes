    "Shown publicly beside your photos, so others can tell them apart. You can leave it blank." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird öffentlich neben deinen Fotos angezeigt, damit andere sie unterscheiden können. Du kannst das Feld leer lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra públicamente junto a tus fotos para que otras personas puedan distinguirlas. Puedes dejarlo en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché publiquement à côté de vos photos, pour que les autres puissent les distinguer. Vous pouvez le laisser vide."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javno se prikazuje uz vaše fotografije kako bi ih drugi mogli razlikovati. Možete ostaviti prazno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato pubblicamente accanto alle tue foto, così le altre persone possono distinguerle. Puoi lasciarlo vuoto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Openbaar getoond naast je foto’s, zodat anderen ze uit elkaar kunnen houden. Je kunt het leeg laten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widoczne publicznie obok Twoich zdjęć, aby inni mogli je odróżnić. Możesz zostawić to pole puste."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișat public lângă pozele dvs., ca ceilalți să le poată deosebi. Îl puteți lăsa necompletat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается всем рядом с вашими фото, чтобы другие могли их различать. Можно оставить пустым."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показується всім поруч із вашими фото, щоб інші могли їх розрізнити. Можна залишити порожнім."
          }
        }
      }
    },
    "Shown publicly next to your hike. It doesn’t have to be your real name, and you can leave it blank." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird öffentlich neben deiner Wanderung angezeigt. Es muss nicht dein echter Name sein, und du kannst das Feld leer lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra públicamente junto a tu excursión. No tiene que ser tu nombre real, y puedes dejarlo en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché publiquement à côté de votre randonnée. Il n’est pas nécessaire d’indiquer votre vrai nom, et vous pouvez le laisser vide."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javno se prikazuje uz vašu turu. Ne mora biti vaše pravo ime i možete ostaviti prazno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato pubblicamente accanto alla tua escursione. Non deve essere per forza il tuo vero nome, e puoi lasciarlo vuoto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Openbaar getoond naast je wandeling. Het hoeft niet je echte naam te zijn, en je kunt het leeg laten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widoczne publicznie obok Twojej wędrówki. Nie musi to być Twoje prawdziwe imię, a pole możesz zostawić puste."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișat public lângă drumeția dvs. Nu trebuie să fie numele dvs. real și îl puteți lăsa necompletat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается всем рядом с вашим походом. Настоящее имя указывать не обязательно, и поле можно оставить пустым."
