    "Topographic hiking map with contour lines and trails. Routes can be downloaded for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topografische Wanderkarte mit Höhenlinien und Wegen. Routen können für die Offlinenutzung heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa topográfico de senderismo con curvas de nivel y senderos. Las rutas se pueden descargar para usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte de randonnée topographique avec courbes de niveau et sentiers. Les itinéraires peuvent être téléchargés pour une utilisation hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa escursionistica topografica con curve di livello e sentieri. I percorsi si possono scaricare per l’uso offline."
          }
        }
      }
    },
    "Topographic map with sharp close-up detail. Tiles you view are auto-saved for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topografische Karte mit scharfen Details aus der Nähe. Angesehene Kacheln werden automatisch für die Offlinenutzung gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa topográfico con detalle nítido de cerca. Las teselas que ves se guardan automáticamente para usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte topographique aux détails nets en gros plan. Les tuiles consultées sont enregistrées automatiquement pour une utilisation hors ligne."
          }
