        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare drumeție este afișată în culoarea propriei rute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый поход нарисован цветом своего маршрута."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен похід показано власним кольором маршруту."
          }
        }
      }
    },
    "Every photo is checked by a person before anyone else can see it." : {
