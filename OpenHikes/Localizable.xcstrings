    "See the viewpoints, shelters and water OpenStreetMap has mapped nearby, and add them to this hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh dir Aussichtspunkte, Schutzhütten und Wasserstellen an, die OpenStreetMap in der Nähe kartiert hat, und füge sie dieser Wanderung hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira los miradores, refugios y fuentes que OpenStreetMap ha cartografiado cerca y añádelos a esta excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez les points de vue, abris et points d’eau qu’OpenStreetMap a cartographiés à proximité, et ajoutez-les à cette randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda i punti panoramici, i ripari e le fonti d’acqua che OpenStreetMap ha mappato nelle vicinanze, e aggiungili a questa escursione."
          }
        }
      }
