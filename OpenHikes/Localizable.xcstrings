          }
        }
      }
    },
    "The route and photographs are deleted for good. The hiker is not told, and their app goes on reading “waiting for review”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Route und die Fotos werden endgültig gelöscht. Die Person wird nicht benachrichtigt, und ihre App zeigt weiterhin „Wartet auf Prüfung“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta y las fotografías se eliminan para siempre. No se avisa a la persona, y su app sigue mostrando «Pendiente de revisión»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’itinéraire et les photos sont définitivement supprimés. La personne n’est pas avertie, et son app continue d’afficher « En attente de vérification »."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta i fotografije trajno se brišu. Planinar nije obaviješten, a njegova aplikacija i dalje prikazuje “Čeka pregled”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il percorso e le fotografie vengono eliminati definitivamente. La persona non viene avvisata, e la sua app continua a mostrare «in attesa di revisione»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De route en foto’s worden definitief verwijderd. De wandelaar krijgt geen bericht, en zijn of haar app blijft ‘wacht op beoordeling’ tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasa i zdjęcia zostaną trwale usunięte. Osoba, która je wysłała, nie dostanie o tym informacji, a jej aplikacja nadal będzie pokazywać „Oczekuje na sprawdzenie”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta și pozele sunt șterse definitiv. Persoana care le-a trimis nu este anunțată, iar aplicația ei afișează în continuare „În așteptarea verificării”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршрут и фото удаляются безвозвратно. Туристу об этом не сообщается, и его приложение по-прежнему показывает «На проверке»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршрут і фото буде видалено назавжди. Людина, яка їх надіслала, про це не дізнається, і її програма й далі показуватиме «Очікує на перевірку»."
          }
        }
      }
    },
    "The route changed while you were editing it. Check it, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Route hat sich geändert, während du sie bearbeitet hast. Prüfe sie und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ruta ha cambiado mientras la editabas. Revísala y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’itinéraire a changé pendant que vous le modifiiez. Vérifiez-le, puis réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta se promijenila dok ste je uređivali. Provjerite je, a zatim pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il percorso è cambiato mentre lo modificavi. Controllalo, poi riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De route is veranderd terwijl je hem wijzigde. Controleer hem en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasa zmieniła się w trakcie edycji. Sprawdź ją i spróbuj ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta s-a modificat în timp ce o editați. Verificați-o, apoi reîncercați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршрут изменился, пока вы его редактировали. Проверьте его и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршрут змінився, поки ви його редагували. Перевірте його й спробуйте ще раз."
          }
        }
      }
    },
    "The shared copy shows the route before your edit. Ask for its removal, then share this one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geteilte Kopie zeigt die Route vor deiner Bearbeitung. Fordere ihre Entfernung an und teile dann diese hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia compartida muestra la ruta antes de tu edición. Pide que se retire y luego comparte esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie partagée montre l’itinéraire avant votre modification. Demandez son retrait, puis partagez la nouvelle version."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podijeljena kopija prikazuje rutu prije vaše izmjene. Zatražite njezino uklanjanje, a zatim podijelite ovu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia condivisa mostra il percorso precedente alla modifica. Chiedine la rimozione, poi condividi questa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedeelde kopie toont de route van vóór je wijziging. Vraag om verwijdering ervan en deel dan deze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępniona kopia pokazuje trasę sprzed Twojej zmiany. Poproś o jej usunięcie, a potem udostępnij tę wersję."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia partajată arată ruta dinainte de modificare. Solicitați retragerea ei, apoi partajați această versiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия в сообществе показывает маршрут до вашей правки. Запросите ее удаление, а затем поделитесь новой версией."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опублікована копія показує маршрут до вашої зміни. Попросіть її видалити, а потім поширте нову версію."
          }
        }
      }
    },
    "The system’s built-in map. Uses the least battery and data, but OpenHikes can’t save it for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die integrierte Karte des Systems. Verbraucht am wenigsten Akku und Daten, aber OpenHikes kann sie nicht für die Offlinenutzung speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa integrado del sistema. Es el que menos batería y datos gasta, pero OpenHikes no puede guardarlo para usarlo sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte intégrée du système. Consomme le moins de batterie et de données, mais OpenHikes ne peut pas l’enregistrer pour une utilisation hors ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugrađena karta sustava. Troši najmanje baterije i podataka, ali OpenHikes je ne može spremiti za izvanmrežnu uporabu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa integrata del sistema. Consuma meno batteria e dati, ma OpenHikes non può salvarla per l’uso offline."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ingebouwde kaart van het systeem. Gebruikt de minste batterij en data, maar OpenHikes kan hem niet offline bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wbudowana mapa systemu. Zużywa najmniej baterii i danych, ale OpenHikes nie może zapisać jej do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta integrată a sistemului. Consumă cel mai puțin din baterie și din date, dar OpenHikes nu o poate salva pentru utilizare offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенная карта системы. Расходует меньше всего заряда аккумулятора и данных, но OpenHikes не может сохранить ее для использования офлайн."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вбудована карта системи. Витрачає найменше заряду й даних, але OpenHikes не може зберегти її для використання офлайн."
          }
        }
      }
    },
