    "The report reaches the reviewer only once you send it there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Meldung erreicht die prüfende Person erst, wenn du sie dort absendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La denuncia solo llega al equipo de revisión cuando la envías desde tu correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le signalement ne parvient à l’équipe de vérification qu’une fois que vous l’avez envoyé depuis votre messagerie."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvještaj stiže do recenzenta tek kad ga onamo pošaljete."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La segnalazione arriva a chi revisiona solo dopo che l’hai inviata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De melding bereikt de beoordelaar pas als je haar daar verstuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgłoszenie trafi do osoby sprawdzającej dopiero wtedy, gdy wyślesz je z aplikacji pocztowej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportul ajunge la moderator numai după ce îl trimiteți din aplicația de e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалоба попадет к модератору, только когда вы отправите ее из почтового приложения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скарга потрапить до модератора, лише коли ви надішлете її з програми пошти."
          }
        }
      }
    },
    "The request reaches the reviewer only once you send it there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
