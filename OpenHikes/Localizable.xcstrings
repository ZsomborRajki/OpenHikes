    "The trail graph cache could not be updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cache des Wegenetzes konnte nicht aktualisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido actualizar la caché de la red de senderos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache du réseau de sentiers n’a pas pu être mis à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aggiornare la cache del grafo dei sentieri."
          }
        },
        "pl" : {
          "stringUnit" : {
