    "Says how far and how long you are into the hike you are recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt, wie weit und wie lange du bei der aufgezeichneten Wanderung schon unterwegs bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica la distancia y el tiempo que llevas en la excursión que estás grabando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique la distance parcourue et le temps écoulé depuis le début de la randonnée que vous enregistrez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Govori koliko ste daleko i koliko dugo na turi koju snimate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica quanta strada hai fatto e da quanto tempo cammini nell’escursione che stai registrando."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertelt hoe ver en hoe lang je al bezig bent met de wandeling die je opneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaje dystans i czas nagrywanej wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune ce distanță ați parcurs și cât timp a trecut de la începutul drumeției pe care o înregistrați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщает, сколько вы прошли и сколько времени длится поход, который вы записываете."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повідомляє, скільки ви пройшли й скільки триває похід, який ви записуєте."
          }
        }
      }
    },
    "Says which way to go before each junction while you follow a trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagt vor jeder Abzweigung, wohin es geht, während du einem Weg folgst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dice hacia dónde ir antes de cada cruce mientras sigues un sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique la direction à prendre avant chaque intersection lorsque vous suivez un sentier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije svakog raskrižja govori kojim smjerom ići dok pratite stazu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica da che parte andare prima di ogni incrocio mentre segui un sentiero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zegt voor elke kruising welke kant je op moet terwijl je een pad volgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mówi, którędy iść, przed każdym skrzyżowaniem, gdy idziesz szlakiem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spune încotro s-o luați înainte de fiecare intersecție, cât timp urmați un traseu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсказывает, куда идти, перед каждым перекрестком, пока вы идете по тропе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підказує, куди йти, перед кожним перехрестям, поки ви йдете стежкою."
          }
        }
      }
    },
