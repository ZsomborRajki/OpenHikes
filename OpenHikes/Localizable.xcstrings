    "Move the handles onto mapped trails, or straighten the stretch instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebe die Griffe auf kartierte Wege oder begradige das Teilstück stattdessen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve los tiradores a senderos cartografiados o endereza el trecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez les poignées sur des sentiers cartographiés, ou rendez plutôt le tronçon rectiligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaknite ručke na ucrtane staze ili umjesto toga izravnajte dionicu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta le maniglie su sentieri mappati, oppure raddrizza la parte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats de hendels naar paden die in kaart zijn gebracht, of maak het stuk in plaats daarvan recht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń uchwyty na szlaki naniesione na mapę albo wyprostuj fragment."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutați mânerele pe trasee cartografiate sau îndreptați porțiunea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместите маркеры на тропы, нанесенные на карту, или выпрямите отрезок."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть маркери на стежки, нанесені на карту, або випряміть відтинок."
          }
        }
      }
    },
    "Move the map and tap Search This Area to look somewhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege die Karte und tippe auf „In diesem Bereich suchen“, um woanders zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el mapa y toca «Buscar en esta zona» para buscar en otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez la carte et touchez « Rechercher dans cette zone » pour chercher ailleurs."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaknite kartu i dodirnite “Pretraži ovo područje” kako biste tražili negdje drugdje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la mappa e tocca «Cerca in questa zona» per cercare altrove."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats de kaart en tik op ‘Zoek in dit gebied’ om ergens anders te zoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń mapę i stuknij „Szukaj tutaj”, aby poszukać gdzie indziej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutați harta și apăsați „Căutați în această zonă” pentru a căuta în altă parte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передвиньте карту и коснитесь «Искать здесь», чтобы поискать в другом месте."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть карту й торкніть «Шукати тут», щоб пошукати деінде."
          }
        }
      }
    },
    "Move the map to put the pin where the place is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege die Karte, um die Stecknadel auf den Ort zu setzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el mapa para colocar la chincheta donde está el lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez la carte pour placer l’épingle sur le lieu."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaknite kartu kako biste iglu postavili na mjesto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la mappa per mettere il segnaposto dove si trova il luogo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats de kaart om de speld op de plaats te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń mapę, aby ustawić pinezkę tam, gdzie jest to miejsce."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutați harta pentru a plasa reperul acolo unde se află locul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передвиньте карту так, чтобы метка оказалась там, где находится место."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть карту так, щоб маркер опинився там, де це місце."
          }
        }
      }
    },
    "Move the map, then tap here to find trails in the new area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege die Karte und tippe dann hier, um Wege im neuen Bereich zu finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el mapa y toca aquí para buscar senderos en la nueva zona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez la carte, puis touchez ici pour trouver des sentiers dans la nouvelle zone."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaknite kartu, a zatim dodirnite ovdje kako biste pronašli staze u novom području."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la mappa, poi tocca qui per trovare sentieri nella nuova zona."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats de kaart en tik dan hier om paden in het nieuwe gebied te vinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń mapę, a potem stuknij tutaj, aby znaleźć szlaki na nowym obszarze."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutați harta, apoi apăsați aici pentru a găsi trasee în noua zonă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Передвиньте карту, затем коснитесь здесь, чтобы найти тропы в новой области."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемістіть карту, а потім торкніть тут, щоб знайти стежки в новій області."
          }
        }
      }
