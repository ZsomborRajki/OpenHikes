          }
        }
      }
    },
    "Press and hold the map to add a stop, or tap a gray route to take it instead. Press and hold a stop to drag it somewhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Karte gedrückt, um einen Stopp hinzuzufügen, oder tippe auf eine graue Route, um sie stattdessen zu nehmen. Halte einen Stopp gedrückt und ziehe ihn, um ihn zu verschieben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur la carte pour ajouter une étape, ou touchez un itinéraire gris pour le prendre à la place. Maintenez le doigt sur une étape pour la déplacer ailleurs."
          }
        }
      }
