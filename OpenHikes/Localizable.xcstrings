    "Low Power Mode — recording at ten-meter accuracy to save battery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stromsparmodus – Aufzeichnung mit zehn Metern Genauigkeit, um Akku zu sparen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo de bajo consumo: grabando con una precisión de diez metros para ahorrar batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode Économie d’énergie – enregistrement avec une précision de dix mètres pour préserver la batterie."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod slabog napajanja – snimanje s točnošću od deset metara radi uštede baterije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità risparmio energetico: registrazione con precisione di dieci metri per risparmiare batteria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energiebesparingsmodus – opname met tien meter nauwkeurigheid om batterij te sparen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb „Niskie zużycie energii” – nagrywanie z dokładnością do dziesięciu metrów, aby oszczędzać baterię."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mod Consum redus – înregistrare cu precizie de zece metri pentru a economisi bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим энергосбережения — запись идет с точностью до десяти метров, чтобы беречь аккумулятор."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим економії заряду — запис із точністю до десяти метрів, щоб заощадити заряд акумулятора."
          }
        }
      }
    },
