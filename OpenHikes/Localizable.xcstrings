    "%@, so it can’t be published again under your name. Your own photos can go on the trail that’s already listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, daher kann er nicht erneut unter deinem Namen veröffentlicht werden. Deine eigenen Fotos können zu dem Weg hinzugefügt werden, der schon gelistet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, así que no se puede volver a publicar con tu nombre. Puedes añadir tus propias fotos al sendero que ya está en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, il ne peut donc pas être republié sous votre nom. Vous pouvez ajouter vos propres photos au sentier qui figure déjà dans la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, quindi non può essere pubblicata di nuovo a tuo nome. Le tue foto possono andare sul sentiero già presente nell’elenco."
