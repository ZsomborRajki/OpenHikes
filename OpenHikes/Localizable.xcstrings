    "Resume it, stop to save it, or discard it below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze sie fort, beende sie zum Speichern oder verwirf sie unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanúdala, detenla para guardarla o descártala abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez-le, arrêtez-le pour le sauvegarder ou supprimez-le ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendila, interrompila per salvarla oppure scartala qui sotto."
          }
        }
      }
    },
    "Resumes the paused hike, from its Lock Screen panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die pausierte Wanderung über ihre Anzeige auf dem Sperrbildschirm fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanuda la excursión en pausa, desde su panel en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend la randonnée en pause, depuis son panneau sur l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprende l’escursione in pausa, dal suo pannello nella schermata di blocco."
          }
        }
      }
    },
    "Resuming it could not be saved, so the hike is still paused. Try resuming it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fortsetzen konnte nicht gespeichert werden, daher ist die Wanderung noch pausiert. Versuche erneut, sie fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la reanudación, así que la excursión sigue en pausa. Intenta reanudarla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reprise n’a pas pu être enregistrée, la randonnée est donc toujours en pause. Réessayez de la reprendre."
