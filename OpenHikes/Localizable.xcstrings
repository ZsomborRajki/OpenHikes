    "Turn on Auto-Save, then pan and zoom around the trail to save its tiles for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere das automatische Speichern und bewege und zoome dann rund um den Weg, um seine Kacheln für die Offlinenutzung zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Guardado automático de teselas» y luego mueve y amplía el mapa alrededor del sendero para guardar sus teselas y usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Enregistrement automatique des tuiles », puis déplacez la carte et zoomez autour du sentier afin d’en enregistrer les tuiles pour une utilisation hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Salvataggio automatico dei tasselli», poi sposta e ingrandisci la mappa intorno al sentiero per salvarne i tasselli per l’uso offline."
          }
        }
      }
    },
    "Turn on Follow in Details, then set off along the trail. Finished hikes are kept here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Folgen“ in den Details und mach dich dann auf den Weg. Abgeschlossene Wanderungen werden hier aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Seguir» en los detalles y ponte en marcha por el sendero. Las excursiones terminadas se guardan aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Suivre » dans les détails, puis mettez-vous en route sur le sentier. Les randonnées terminées sont conservées ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Segui» in «Dettagli», poi mettiti in cammino lungo il sentiero. Le escursioni terminate restano qui."
          }
        }
      }
    },
    "Turn on Precise Location for OpenHikes in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere in den Einstellungen „Genauer Standort“ für OpenHikes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Ubicación exacta» para OpenHikes en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Position exacte » pour OpenHikes dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva «Posizione esatta» per OpenHikes in Impostazioni."
          }
        }
      }
    },
