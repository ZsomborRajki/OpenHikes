    "Legs run along paths mapped in OpenStreetMap. Turn this off to draw straight lines." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschnitte verlaufen entlang von Wegen aus OpenStreetMap. Deaktiviere dies, um gerade Linien zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tramos siguen los caminos de OpenStreetMap. Desactiva esta opción para dibujar líneas rectas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tronçons suivent les chemins cartographiés dans OpenStreetMap. Désactivez cette option pour tracer des lignes droites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tratti seguono i sentieri mappati in OpenStreetMap. Disattiva questa opzione per disegnare linee rette."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odcinki między przystankami biegną po ścieżkach naniesionych na mapę OpenStreetMap. Wyłącz tę opcję, aby rysować linie proste."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tronsoanele urmează potecile cartografiate în OpenStreetMap. Dezactivați opțiunea pentru a trasa linii drepte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отрезки между остановками идут по дорожкам, нанесенным на карту OpenStreetMap. Выключите, чтобы рисовать прямые линии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відрізки між зупинками йдуть доріжками, нанесеними на карту в OpenStreetMap. Вимкніть, щоб малювати прямі лінії."
          }
        }
      }
    },
