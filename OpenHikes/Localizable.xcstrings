    "The OpenHikes map in dark colors. Countries you download are drawn on it too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die OpenHikes-Karte in dunklen Farben. Heruntergeladene Länder werden auch auf ihr gezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa de OpenHikes en colores oscuros. Los países que descargues también se dibujan en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte OpenHikes en couleurs sombres. Les pays que vous téléchargez y sont dessinés aussi."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes karta u tamnim bojama. Na njoj se prikazuju i zemlje koje preuzmete."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa OpenHikes in colori scuri. Anche i paesi che scarichi vengono disegnati su questa mappa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De OpenHikes-kaart in donkere kleuren. Landen die je downloadt, worden er ook op getekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa OpenHikes w ciemnych kolorach. Pobrane kraje też są na niej rysowane."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta OpenHikes în culori închise. Țările pe care le descărcați sunt desenate și pe ea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта OpenHikes в темных цветах. Загруженные страны рисуются и на ней."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта OpenHikes у темних кольорах. Викачані країни малюються й на ній."
          }
        }
      }
    },
    "The original route couldn’t be restored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ursprüngliche Route konnte nicht wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido recuperar la ruta original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de rétablir l’itinéraire d’origine."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvorna ruta nije se mogla vratiti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile ripristinare il percorso originale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De oorspronkelijke route kon niet worden teruggezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przywrócić pierwotnej trasy."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruta originală nu a putut fi restabilită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось вернуть исходный маршрут."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося повернути початковий маршрут."
          }
        }
      }
    },
    "The photo is removed from this hike on all your synced devices. Any copy in OpenHikes on this device is deleted for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Foto wird auf all deinen synchronisierten Geräten aus dieser Wanderung entfernt. Jede Kopie in OpenHikes auf diesem Gerät wird endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto se quita de esta excursión en todos tus dispositivos sincronizados. Cualquier copia en OpenHikes de este dispositivo se elimina para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo est retirée de cette randonnée sur tous vos appareils synchronisés. Toute copie dans OpenHikes sur cet appareil est définitivement supprimée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografija se uklanja iz ove ture na svim vašim sinkroniziranim uređajima. Svaka kopija u OpenHikesu na ovom uređaju trajno se briše."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto viene rimossa da questa escursione su tutti i dispositivi sincronizzati. Qualsiasi copia in OpenHikes su questo dispositivo viene eliminata definitivamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto wordt op al je gesynchroniseerde apparaten uit deze wandeling verwijderd. Elke kopie in OpenHikes op dit apparaat wordt definitief verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcie zostanie usunięte z tej wędrówki na wszystkich Twoich zsynchronizowanych urządzeniach. Jego kopia w OpenHikes na tym urządzeniu zostanie trwale usunięta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza este eliminată din această drumeție pe toate dispozitivele dvs. sincronizate. Orice copie din OpenHikes de pe acest dispozitiv este ștearsă definitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото убирается из этого похода на всех ваших синхронизированных устройствах. Его копия в OpenHikes на этом устройстве удаляется безвозвратно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото вилучається з цього походу на всіх ваших синхронізованих пристроях. Будь-яку його копію в OpenHikes на цьому пристрої буде видалено назавжди."
          }
        }
      }
    },
    "The photos are deleted for good. The hiker is not told, and their app goes on reading “waiting for review”. The trail itself is not touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos werden endgültig gelöscht. Die Person wird nicht benachrichtigt, und ihre App zeigt weiterhin „Wartet auf Prüfung“. Der Weg selbst bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se eliminan para siempre. No se avisa a la persona, y su app sigue mostrando «Pendiente de revisión». El sendero en sí no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont définitivement supprimées. La personne n’est pas avertie, et son app continue d’afficher « En attente de vérification ». Le sentier lui-même n’est pas modifié."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije se trajno brišu. Planinar nije obaviješten, a njegova aplikacija i dalje prikazuje “Čeka pregled”. Sama staza ostaje netaknuta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto vengono eliminate definitivamente. La persona non viene avvisata, e la sua app continua a mostrare «in attesa di revisione». Il sentiero in sé non viene toccato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto’s worden definitief verwijderd. De wandelaar krijgt geen bericht, en zijn of haar app blijft ‘wacht op beoordeling’ tonen. Het pad zelf blijft ongemoeid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia zostaną trwale usunięte. Osoba, która je wysłała, nie dostanie o tym informacji, a jej aplikacja nadal będzie pokazywać „Oczekuje na sprawdzenie”. Sam szlak pozostanie nietknięty."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozele sunt șterse definitiv. Persoana care le-a trimis nu este anunțată, iar aplicația ei afișează în continuare „În așteptarea verificării”. Traseul în sine nu este modificat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото удаляются безвозвратно. Туристу об этом не сообщается, и его приложение по-прежнему показывает «На проверке». Сама тропа не затрагивается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото буде видалено назавжди. Людина, яка їх надіслала, про це не дізнається, і її програма й далі показуватиме «Очікує на перевірку». Сама стежка залишиться без змін."
          }
        }
      }
    },
    "The photos are off the hike for everybody, but the copy stored with their submission couldn’t be deleted. %@ To finish, take them down again before leaving this photo — once you leave, the app can’t reach that copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos sind für alle von der Wanderung entfernt, aber die mit ihrer Einreichung gespeicherte Kopie konnte nicht gelöscht werden. %@ Entferne sie zum Abschließen erneut, bevor du dieses Foto verlässt – danach kann die App diese Kopie nicht mehr erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos ya no aparecen en la excursión para nadie, pero no se ha podido eliminar la copia guardada con su envío. %@ Para terminar, vuelve a retirarlas antes de salir de esta foto: cuando salgas, la app ya no podrá acceder a esa copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont retirées de la randonnée pour tout le monde, mais la copie conservée avec leur soumission n’a pas pu être supprimée. %@ Pour terminer, retirez-les à nouveau avant de quitter cette photo – ensuite, l’app ne pourra plus accéder à cette copie."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije su uklonjene s ture za sve, ali kopija pohranjena uz njihovu prijavu nije se mogla obrisati. %@ Kako biste dovršili, ponovno ih uklonite prije nego što napustite ovu fotografiju – kad odete, aplikacija više ne može doći do te kopije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto sono state tolte dall’escursione per tutti, ma non è stato possibile eliminare la copia conservata con il loro invio. %@ Per completare, ritirale di nuovo prima di lasciare questa foto: dopo che l’hai lasciata, l’app non può più raggiungere quella copia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto’s zijn voor iedereen van de wandeling gehaald, maar de kopie die bij hun inzending is bewaard, kon niet worden verwijderd. %@ Haal ze opnieuw offline voordat je deze foto verlaat om dit af te ronden – zodra je weggaat, kan de app die kopie niet meer bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia zniknęły z wędrówki u wszystkich, ale kopii przechowywanej z wysłanymi zdjęciami nie udało się usunąć. %@ Aby dokończyć, wycofaj je ponownie, zanim opuścisz to zdjęcie – potem aplikacja nie będzie mieć dostępu do tej kopii."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozele nu mai apar la drumeție pentru nimeni, dar copia stocată împreună cu trimiterea lor nu a putut fi ștearsă. %@ Pentru a finaliza, retrageți-le din nou înainte de a părăsi această poză – după ce ieșiți, aplicația nu mai poate accesa acea copie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото убраны из похода для всех, но копию, сохраненную с их заявкой, удалить не удалось. %@ Чтобы завершить, снимите их с публикации еще раз, прежде чем уйти с этого фото, — потом приложение не сможет добраться до этой копии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото вилучено з походу для всіх, але копію, збережену з їхньою заявкою, не вдалося видалити. %@ Щоб завершити, зніміть їх з публікації ще раз, перш ніж закрити це фото — щойно ви його закриєте, програма не матиме доступу до цієї копії."
          }
        }
      }
    },
    "The photos were published but the record came back unreadable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos wurden veröffentlicht, aber der Eintrag kam unlesbar zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se han publicado, pero el registro devuelto no se puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos ont été publiées, mais les données renvoyées étaient illisibles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografije su objavljene, ali zapis se vratio nečitljiv."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto sono state pubblicate, ma il record restituito non è leggibile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto’s zijn gepubliceerd, maar het record kwam onleesbaar terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia zostały opublikowane, ale zwróconego rekordu nie udało się odczytać."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozele au fost publicate, dar datele returnate nu pot fi citite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото опубликованы, но ответ сервера не удалось прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
