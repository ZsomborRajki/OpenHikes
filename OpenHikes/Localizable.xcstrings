    "Add photos to this hike first. Photos added on another device can only be shared from that device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge dieser Wanderung zuerst Fotos hinzu. Fotos, die auf einem anderen Gerät hinzugefügt wurden, können nur von dort geteilt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade primero fotos a esta excursión. Las fotos añadidas en otro dispositivo solo se pueden compartir desde ese dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d’abord des photos à cette randonnée. Les photos ajoutées sur un autre appareil ne peuvent être partagées que depuis celui-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima aggiungi delle foto a questa escursione. Le foto aggiunte su un altro dispositivo possono essere condivise solo da quel dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw dodaj zdjęcia do tej wędrówki. Zdjęcia dodane na innym urządzeniu można udostępnić tylko z tamtego urządzenia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați mai întâi poze la această drumeție. Pozele adăugate pe alt dispozitiv pot fi partajate doar de pe acel dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала добавьте фото в этот поход. Фото, добавленными на другом устройстве, можно поделиться только с того устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу додайте фото до цього походу. Фото, додані на іншому пристрої, можна поширити лише з того пристрою."
          }
        }
      }
    },
