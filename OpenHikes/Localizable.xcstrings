          "stringUnit" : {
            "state" : "translated",
            "value" : "Genau hier ist nichts kartiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de cartographié à cet endroit précis."
          }
        }
      }
    },
    "Nothing on this device offered to write the message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts auf diesem Gerät hat angeboten, die Nachricht zu schreiben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune app de cet appareil n’a proposé de rédiger le message."
          }
        }
      }
    },
    "Nothing to Restore" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts wiederherzustellen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à restaurer"
          }
        }
      }
    },
    "Nothing to save." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à enregistrer."
          }
        }
      }
    },
    "Nothing written." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts geschrieben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun texte."
          }
        }
      }
    },
    "Nothing yet. Add photos to this hike and they can go on %@ for other hikers to see." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts. Füge dieser Wanderung Fotos hinzu, dann können sie für andere sichtbar zu %@ hinzugefügt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien pour l’instant. Ajoutez des photos à cette randonnée et elles pourront figurer sur %@ pour que d’autres personnes les voient."
          }
        }
      }
    },
    "Notifies you when you set off while a hike is paused, stop for 15 minutes while recording, leave the trail you’re following, or may finish after dark." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigt dich, wenn du bei einer pausierten Wanderung losgehst, beim Aufzeichnen 15 Minuten stehen bleibst, den Weg verlässt, dem du folgst, oder erst nach Einbruch der Dunkelheit ankommen könntest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avertit si vous repartez alors qu’une randonnée est en pause, si vous vous arrêtez 15 minutes pendant un enregistrement, si vous quittez le sentier suivi ou si vous risquez d’arriver après la tombée de la nuit."
          }
        }
      }
    },
