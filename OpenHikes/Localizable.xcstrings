        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fișierul nu a fost modificat. Verificați dacă dispozitivul are spațiu de stocare disponibil, apoi importați-l din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл не изменен. Убедитесь, что на устройстве есть свободное место, и импортируйте его снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл не змінено. Переконайтеся, що на пристрої є вільне місце, а потім імпортуйте його ще раз."
          }
        }
      }
    },
    "The highlighted line follows a mapped trail across the gap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die hervorgehobene Linie folgt einem kartierten Weg über die Lücke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La línea resaltada sigue un sendero cartografiado por el hueco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne en surbrillance suit un sentier cartographié à travers l’interruption."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istaknuta linija prati ucrtanu stazu preko praznine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La linea evidenziata segue un sentiero mappato attraverso l’interruzione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gemarkeerde lijn volgt een in kaart gebracht pad over het gat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyróżniona linia prowadzi przez przerwę szlakiem naniesionym na mapę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linia evidențiată urmează un traseu cartografiat peste întrerupere."
