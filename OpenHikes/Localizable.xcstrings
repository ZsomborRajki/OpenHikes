    "Places from OpenStreetMap in the area on the map. Press and hold the map to add your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte aus OpenStreetMap im Bereich auf der Karte. Halte die Karte gedrückt, um eigene hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares de OpenStreetMap en la zona del mapa. Mantén pulsado el mapa para añadir los tuyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieux d’OpenStreetMap dans la zone affichée sur la carte. Maintenez le doigt sur la carte pour ajouter les vôtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luoghi di OpenStreetMap nella zona visibile sulla mappa. Tieni premuto sulla mappa per aggiungerne uno tuo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsca z OpenStreetMap na obszarze widocznym na mapie. Dotknij i przytrzymaj mapę, aby dodać własne."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locuri din OpenStreetMap în zona afișată pe hartă. Mențineți apăsat pe hartă pentru a adăuga un loc propriu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места из OpenStreetMap в области на карте. Нажмите и удерживайте карту, чтобы добавить свое."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місця з OpenStreetMap у видимій області карти. Торкніть і втримуйте карту, щоб додати власне місце."
          }
        }
      }
    },
    "Places from OpenStreetMap. Press and hold the map to add a place of your own anywhere, on the trail or off it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte aus OpenStreetMap. Halte die Karte gedrückt, um überall einen eigenen Ort hinzuzufügen, auf dem Weg oder abseits davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares de OpenStreetMap. Mantén pulsado el mapa para añadir un lugar propio en cualquier sitio, en el sendero o fuera de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieux d’OpenStreetMap. Maintenez le doigt sur la carte pour ajouter votre propre lieu n’importe où, sur le sentier ou en dehors."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luoghi di OpenStreetMap. Tieni premuto sulla mappa per aggiungere un tuo luogo ovunque, sul sentiero o fuori."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsca z OpenStreetMap. Dotknij i przytrzymaj mapę, aby dodać własne miejsce w dowolnym punkcie, na szlaku lub poza nim."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locuri din OpenStreetMap. Mențineți apăsat pe hartă pentru a adăuga oriunde un loc propriu, pe traseu sau în afara lui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места из OpenStreetMap. Нажмите и удерживайте карту, чтобы добавить свое место где угодно, на тропе или вне ее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
