    "Saved %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excursión guardada. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
