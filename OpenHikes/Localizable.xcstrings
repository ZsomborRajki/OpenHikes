            "value" : "Setze ihn dort auf die Karte, wo er ist, gib ihm dann einen Namen und füge Fotos hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colócalo en el mapa donde está, ponle nombre y añade fotos."
