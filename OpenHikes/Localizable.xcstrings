      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was bisher zurückgelegt wurde, bleibt als Eintrag erhalten. Eine Wanderung unter 100 m nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo recorrido hasta ahora se conserva como registro. Una excursión de menos de 100 m, no."
