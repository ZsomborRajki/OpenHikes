    "Photo library access is turned off for this device, so OpenHikes can’t look for pictures of this hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die Mediathek ist für dieses Gerät deaktiviert, daher kann OpenHikes nicht nach Bildern dieser Wanderung suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la fototeca está desactivado en este dispositivo, así que OpenHikes no puede buscar fotos de esta excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la photothèque est désactivé sur cet appareil, donc OpenHikes ne peut pas rechercher de photos de cette randonnée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup medijateci isključen je za ovaj uređaj, pa OpenHikes ne može tražiti slike s ove ture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla libreria foto è disattivato per questo dispositivo, quindi OpenHikes non può cercare immagini di questa escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot de fotobibliotheek staat uit voor dit apparaat, dus OpenHikes kan niet naar foto’s van deze wandeling zoeken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do biblioteki zdjęć jest wyłączony na tym urządzeniu, więc OpenHikes nie może szukać zdjęć z tej wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul la biblioteca foto este dezactivat pe acest dispozitiv, deci OpenHikes nu poate căuta poze din această drumeție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к медиатеке на этом устройстве выключен, поэтому OpenHikes не может искать снимки этого похода."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до фототеки на цьому пристрої вимкнено, тому OpenHikes не може шукати фото цього походу."
          }
        }
      }
    },
