            "value" : "Teile Feedback oder melde ein Problem auf GitHub. Gib dabei bitte die Version oben an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danos tu opinión o informa de un problema en GitHub. Indica la versión que aparece arriba."
