    "Tap %@ on the map to record a hike, or %@ to draw a trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte auf %1$@, um eine Wanderung aufzuzeichnen, oder auf %2$@, um einen Weg zu zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap %1$@ on the map to record a hike, or %2$@ to draw a trail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca %1$@ en el mapa para grabar una excursión, o %2$@ para dibujar un sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez %1$@ sur la carte pour enregistrer une randonnée, ou %2$@ pour dessiner un sentier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca %1$@ sulla mappa per registrare un’escursione, oppure %2$@ per disegnare un sentiero."
          }
        }
      }
    },
    "Tap a photo to see it, and where on the trail it was taken." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Foto, um es zu sehen und zu erfahren, wo auf dem Weg es aufgenommen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una foto para verla y saber en qué punto del sendero se tomó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une photo pour l’afficher et voir où elle a été prise sur le sentier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una foto per vederla, insieme al punto del sentiero in cui è stata scattata."
          }
        }
      }
    },
    "Tap the map to add another point, then save again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Karte, um einen weiteren Punkt hinzuzufügen, und speichere dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el mapa para añadir otro punto y vuelve a guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la carte pour ajouter un autre point, puis enregistrez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la mappa per aggiungere un altro punto, poi salva di nuovo."
          }
        }
      }
    },
    "Tap the Record a hike button on the map to record a hike, or the Make a trail button to draw a trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte auf die Taste „Wanderung aufzeichnen“, um eine Wanderung aufzuzeichnen, oder auf „Weg erstellen“, um einen Weg zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón «Grabar una excursión» en el mapa para grabar una excursión, o el botón «Crear un sendero» para dibujar un sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton « Enregistrer une randonnée » sur la carte pour enregistrer une randonnée, ou le bouton « Créer un sentier » pour dessiner un sentier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante «Registra un’escursione» sulla mappa per registrare un’escursione, oppure il pulsante «Crea un sentiero» per disegnare un sentiero."
          }
        }
      }
    },
