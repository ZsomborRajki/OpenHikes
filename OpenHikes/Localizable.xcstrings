        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes nu are acces la localizare „Întotdeauna”, deci această funcție nu poate rula. Activați accesul în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У приложения OpenHikes нет доступа к геопозиции «Всегда», поэтому эта функция не может работать. Включите его в Настройках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes не має доступу до геопозиції «Завжди», тому ця функція не може працювати. Увімкніть його в Параметрах."
