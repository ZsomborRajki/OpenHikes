    "Colors the line by how steep it is, uphill or down. Applies to every hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färbt die Linie danach, wie steil sie ist, bergauf oder bergab. Gilt für alle Wanderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorea la línea según su pendiente, de subida o de bajada. Se aplica a todas las excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore la ligne selon sa pente, en montée comme en descente. S’applique à toutes les randonnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora la linea in base alla pendenza, in salita o in discesa. Si applica a tutte le escursioni."
          }
        }
      }
    },
    "Colors the line by its OpenStreetMap difficulty grade. Applies to every hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färbt die Linie nach ihrer OpenStreetMap-Schwierigkeitsstufe. Gilt für alle Wanderungen."
          }
