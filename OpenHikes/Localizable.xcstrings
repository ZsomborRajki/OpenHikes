    "%@ uses no downloadable tiles. Choose another map in Map Modes to save this hike for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet keine herunterladbaren Kacheln. Wähle unter „Kartenmodi“ eine andere Karte, um diese Wanderung für die Offlinenutzung zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no usa teselas descargables. Elige otro mapa en «Modos de mapa» para guardar esta excursión y usarla sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’utilise pas de tuiles téléchargeables. Choisissez une autre carte dans « Modes de carte » pour enregistrer cette randonnée pour une utilisation hors ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne koristi pločice koje se mogu preuzeti. Odaberite drugu kartu u izborniku Načini karte kako biste ovu turu spremili za izvanmrežnu uporabu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non usa tasselli scaricabili. Scegli un’altra mappa in «Modalità mappa» per salvare questa escursione e usarla offline."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gebruikt geen downloadbare tegels. Kies een andere kaart in ‘Kaartmodi’ om deze wandeling offline te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styl mapy „%@” nie używa kafelków, które można pobrać. Wybierz inną mapę w panelu „Tryby mapy”, aby zapisać tę wędrówkę do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nu folosește dale descărcabile. Alegeți altă hartă în „Moduri hartă” pentru a salva această drumeție și a o folosi offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта «%@» не использует загружаемые тайлы. Чтобы сохранить этот поход для использования офлайн, выберите другую карту в разделе «Режимы карт»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стиль карти «%@» не використовує тайли, які можна викачати. Щоб зберегти цей похід для використання офлайн, виберіть іншу карту в розділі «Режими карти»."
          }
        }
      }
    },
