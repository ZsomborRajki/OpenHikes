    "Tap %@ on the map to record a hike, or %@ to draw a trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte auf %1$@, um eine Wanderung aufzuzeichnen, oder auf %2$@, um einen Weg zu zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap %1$@ on the map to record a hike, or %2$@ to draw a trail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca %1$@ en el mapa para grabar una excursión, o %2$@ para dibujar un sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez %1$@ sur la carte pour enregistrer une randonnée, ou %2$@ pour dessiner un sentier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite %1$@ na karti kako biste snimili turu ili %2$@ kako biste nacrtali stazu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca %1$@ sulla mappa per registrare un’escursione, oppure %2$@ per disegnare un sentiero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op %1$@ op de kaart om een wandeling op te nemen, of op %2$@ om een pad te tekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij %1$@ na mapie, aby nagrać wędrówkę, albo %2$@, aby narysować szlak."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apăsați %1$@ de pe hartă pentru a înregistra o drumeție sau %2$@ pentru a desena un traseu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь %1$@ на карте, чтобы записать поход, или %2$@, чтобы нарисовать тропу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніть %1$@ на карті, щоб записати похід, або %2$@, щоб намалювати стежку."
          }
        }
      }
    },
    "Tap a photo to see it, and where on the trail it was taken." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Foto, um es zu sehen und zu erfahren, wo auf dem Weg es aufgenommen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una foto para verla y saber en qué punto del sendero se tomó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une photo pour l’afficher et voir où elle a été prise sur le sentier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite fotografiju kako biste je vidjeli i saznali gdje je na stazi snimljena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una foto per vederla, insieme al punto del sentiero in cui è stata scattata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een foto om hem te zien, en waar op het pad hij is gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij zdjęcie, aby je zobaczyć i sprawdzić, w którym miejscu szlaku je zrobiono."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apăsați pe o poză pentru a o vedea, împreună cu locul de pe traseu unde a fost făcută."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь фото, чтобы посмотреть его и то место на тропе, где оно снято."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніть фото, щоб переглянути його й місце на стежці, де його було знято."
          }
        }
      }
    },
    "Tap the map to add another point, then save again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Karte, um einen weiteren Punkt hinzuzufügen, und speichere dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el mapa para añadir otro punto y vuelve a guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la carte pour ajouter un autre point, puis enregistrez à nouveau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite kartu kako biste dodali još jednu točku, a zatim ponovno spremite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la mappa per aggiungere un altro punto, poi salva di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de kaart om nog een punt toe te voegen en bewaar dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij mapę, aby dodać kolejny punkt, a potem zapisz ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apăsați pe hartă pentru a adăuga încă un punct, apoi salvați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь карты, чтобы добавить еще одну точку, и сохраните снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніть карту, щоб додати ще одну точку, а потім збережіть ще раз."
          }
        }
      }
    },
    "Tap the Record a hike button on the map to record a hike, or the Make a trail button to draw a trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte auf die Taste „Wanderung aufzeichnen“, um eine Wanderung aufzuzeichnen, oder auf „Weg erstellen“, um einen Weg zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón «Grabar una excursión» en el mapa para grabar una excursión, o el botón «Crear un sendero» para dibujar un sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton « Enregistrer une randonnée » sur la carte pour enregistrer une randonnée, ou le bouton « Créer un sentier » pour dessiner un sentier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na karti dodirnite tipku “Snimi turu” kako biste snimili turu ili tipku “Izradi stazu” kako biste nacrtali stazu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante «Registra un’escursione» sulla mappa per registrare un’escursione, oppure il pulsante «Crea un sentiero» per disegnare un sentiero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de kaart op de knop ‘Neem een wandeling op’ om een wandeling op te nemen, of op de knop ‘Maak een pad’ om een pad te tekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij na mapie przycisk „Nagraj wędrówkę”, aby nagrać wędrówkę, albo przycisk „Utwórz szlak”, aby narysować szlak."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apăsați butonul „Înregistrați o drumeție” de pe hartă pentru a înregistra o drumeție sau butonul „Creați un traseu” pentru a desena un traseu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь кнопки «Записать поход» на карте, чтобы записать поход, или кнопки «Создать тропу», чтобы нарисовать тропу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніть кнопку «Записати похід» на карті, щоб записати похід, або кнопку «Створити стежку», щоб намалювати стежку."
          }
        }
      }
    },
    "Tells the reviewer something is wrong with it" : {
