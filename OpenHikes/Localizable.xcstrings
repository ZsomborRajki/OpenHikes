        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce qui a été parcouru jusqu’ici est conservé. Ce n’est pas le cas d’une randonnée de moins de 100 m."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
