    "Sent. It appears for other hikers once a person has checked it. Opens a request to withdraw it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendet. Sie erscheint für andere, sobald eine Person sie geprüft hat. Öffnet eine Anfrage, um sie zurückzuziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviada. Aparecerá para otras personas cuando alguien la haya revisado. Abre una solicitud para retirarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyée. Elle apparaîtra pour les autres une fois vérifiée par une personne. Ouvre une demande de retrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviata. Sarà visibile nella community dopo il controllo di una persona. Apre una richiesta per ritirarla."
          }
        }
      }
    },
    "Sent. They appear on the trail once a person has checked them. Opens a request to withdraw them." : {
      "localizations" : {
        "de" : {
