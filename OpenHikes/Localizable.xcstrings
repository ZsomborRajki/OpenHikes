    "The %@ license allows %@ of saved maps on this device, shared by %@. Other map styles have no limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenz von %1$@ erlaubt %2$@ an gespeicherten Karten auf diesem Gerät, die sich %3$@ teilen. Andere Kartenstile haben kein Limit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ license allows %2$@ of saved maps on this device, shared by %3$@. Other map styles have no limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licencia de %1$@ permite %2$@ de mapas guardados en este dispositivo, que comparten %3$@. Los demás estilos de mapa no tienen límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence de %1$@ autorise %2$@ de cartes enregistrées sur cet appareil, à répartir entre %3$@. Les autres styles de carte n’ont aucune limite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licenza di %1$@ consente %2$@ di mappe salvate su questo dispositivo, condivisi tra %3$@. Gli altri stili di mappa non hanno limiti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licencja %1$@ pozwala przechowywać na tym urządzeniu %2$@ zapisanych map – łącznie dla stylów: %3$@. Pozostałe style mapy nie mają limitu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licența %1$@ permite %2$@ de hărți salvate pe acest dispozitiv, o limită comună pentru %3$@. Celelalte stiluri de hartă nu au limită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицензия %1$@ допускает %2$@ сохраненных карт на этом устройстве — в сумме на стили: %3$@. У других стилей карты ограничений нет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліцензія %1$@ дозволяє %2$@ збережених карт на цьому пристрої — спільно для стилів: %3$@. Інші стилі карти не мають обмежень."
          }
        }
      }
    },
