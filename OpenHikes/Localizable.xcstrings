    "Keeps the screen on while you record or hike a trail with OpenHikes open. This uses more battery." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt den Bildschirm eingeschaltet, während du aufzeichnest oder mit geöffnetem OpenHikes einen Weg wanderst. Das verbraucht mehr Akku."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la pantalla encendida mientras grabas o recorres un sendero con la app abierta. Esto gasta más batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde l’écran allumé pendant que vous enregistrez ou suivez un sentier avec OpenHikes ouvert. Cela consomme plus de batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene lo schermo acceso mentre registri o percorri un sentiero con OpenHikes aperta. Consuma più batteria."
          }
        }
      }
    },
    "Keeps your Home Screen widget and Live Activity showing your progress along the selected trail while OpenHikes is closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt dein Home-Bildschirm-Widget und deine Live-Aktivität deinen Fortschritt entlang des ausgewählten Weges anzeigen, während OpenHikes geschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace que tu widget de la pantalla de inicio y tu Actividad en directo muestren tu progreso por el sendero seleccionado mientras la app está cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet au widget de l’écran d’accueil et à l’Activité en direct d’afficher votre progression sur le sentier sélectionné quand OpenHikes est fermé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa sì che il widget della schermata Home e l’Attività in tempo reale mostrino i tuoi progressi lungo il sentiero selezionato mentre OpenHikes è chiusa."
          }
        }
      }
    },
