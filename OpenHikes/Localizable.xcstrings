      }
    },
    "Saved" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré"
          }
        }
      }
    },
    "Saved %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randonnée sauvegardée. %@"
          }
        }
      }
    },
    "Saved %lld of %lld tiles, then reached the %@ %@ allows on this device across all its map styles. Delete another saved map to make room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Kacheln gespeichert, dann wurden die %3$@ erreicht, die %4$@ auf diesem Gerät über alle Kartenstile hinweg erlaubt. Lösche eine andere gespeicherte Karte, um Platz zu schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved %1$lld of %2$lld tiles, then reached the %3$@ %4$@ allows on this device across all its map styles. Delete another saved map to make room."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tuiles sur %2$lld enregistrées, puis la limite de %3$@ autorisée par %4$@ sur cet appareil, tous styles de carte confondus, a été atteinte. Supprimez une autre carte enregistrée pour libérer de l’espace."
          }
        }
      }
    },
    "Saved %lld of %lld tiles. Try again to finish the download." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Kacheln gespeichert. Versuche es erneut, um den Download abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved %1$lld of %2$lld tiles. Try again to finish the download."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tuiles sur %2$lld enregistrées. Réessayez pour terminer le téléchargement."
          }
        }
      }
    },
    "Saved for offline" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline gespeichert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartes hors ligne"
          }
        }
      }
    },
    "Saved for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Offlinenutzung gespeichert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré pour une utilisation hors ligne."
          }
        }
      }
    },
    "Saved from OpenStreetMap" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus OpenStreetMap gespeichert"
          }
        },
        "fr" : {
          "stringUnit" : {
