    "Hillshaded terrain in natural colors, a softer page for reading the shape of the land." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schattiertes Gelände in natürlichen Farben, eine sanftere Darstellung, um die Form der Landschaft zu lesen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief ombré aux couleurs naturelles, une carte plus douce pour lire la forme du terrain."
          }
        }
      }
    },
    "Hillshaded terrain in natural colors. Routes can be downloaded for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schattiertes Gelände in natürlichen Farben. Routen können für die Offlinenutzung heruntergeladen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief ombré aux couleurs naturelles. Les itinéraires peuvent être téléchargés pour une utilisation hors ligne."
          }
        }
      }
    },
    "Hillshading, contour lines and trail-focused styling, at high resolution." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geländeschattierung, Höhenlinien und eine auf Wege ausgerichtete Gestaltung, in hoher Auflösung."
