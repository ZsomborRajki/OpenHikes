    "Publishing deletes the %lld faded photos from the submission for good. The rest still go." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Beim Veröffentlichen wird das abgeblendete Foto endgültig aus der Einreichung gelöscht. Die übrigen werden trotzdem gesendet."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Beim Veröffentlichen werden die %lld abgeblendeten Fotos endgültig aus der Einreichung gelöscht. Die übrigen werden trotzdem gesendet."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
