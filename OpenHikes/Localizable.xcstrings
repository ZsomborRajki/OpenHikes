    "Shown publicly beside your photos, so others can tell them apart. You can leave it blank." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird öffentlich neben deinen Fotos angezeigt, damit andere sie unterscheiden können. Du kannst das Feld leer lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra públicamente junto a tus fotos para que otras personas puedan distinguirlas. Puedes dejarlo en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché publiquement à côté de vos photos, pour que les autres puissent les distinguer. Vous pouvez le laisser vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato pubblicamente accanto alle tue foto, così le altre persone possono distinguerle. Puoi lasciarlo vuoto."
          }
        }
      }
    },
    "Shown publicly next to your hike. It doesn’t have to be your real name, and you can leave it blank." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird öffentlich neben deiner Wanderung angezeigt. Es muss nicht dein echter Name sein, und du kannst das Feld leer lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra públicamente junto a tu excursión. No tiene que ser tu nombre real, y puedes dejarlo en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché publiquement à côté de votre randonnée. Il n’est pas nécessaire d’indiquer votre vrai nom, et vous pouvez le laisser vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato pubblicamente accanto alla tua escursione. Non deve essere per forza il tuo vero nome, e puoi lasciarlo vuoto."
          }
        }
      }
    },
    "Shows a trail you choose, or your selected trail, or a hike currently being recorded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt einen Weg deiner Wahl, deinen ausgewählten Weg oder eine Wanderung, die gerade aufgezeichnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un sendero que elijas, el sendero seleccionado o una excursión que se esté grabando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un sentier de votre choix, le sentier sélectionné ou une randonnée en cours d’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un sentiero a tua scelta, il sentiero selezionato o un’escursione in fase di registrazione."
          }
        }
      }
    },
    "Shows the conditions and where this forecast comes from" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Bedingungen und woher diese Vorhersage stammt"
