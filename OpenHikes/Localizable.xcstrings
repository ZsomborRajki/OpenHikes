    "No previous purchase was found for this Apple Account. If you bought Pro with a different account, sign in to that one and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Apple Account wurde kein früherer Kauf gefunden. Wenn du Pro mit einem anderen Account gekauft hast, melde dich damit an und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha encontrado ninguna compra anterior para esta cuenta de Apple. Si compraste Pro con otra cuenta, inicia sesión con ella y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat antérieur n’a été trouvé pour ce compte Apple. Si vous avez acheté Pro avec un autre compte, connectez-vous à celui-ci et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za ovaj Apple račun nije pronađena prethodna kupnja. Ako ste Pro kupili drugim računom, prijavite se njime i pokušajte ponovno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun acquisto precedente trovato per questo Apple Account. Se hai acquistato Pro con un altro account, accedi con quello e riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
