    "This trail has changed since the hike, so the stretches it covered can no longer be drawn along it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Weg hat sich seit der Wanderung geändert, daher können die zurückgelegten Abschnitte nicht mehr entlang des Weges gezeichnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sendero ha cambiado desde la excursión, así que los tramos recorridos ya no se pueden dibujar sobre él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce sentier a changé depuis la randonnée : les tronçons parcourus ne peuvent plus y être tracés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova se staza promijenila od ture, pa se dionice koje je tura prošla više ne mogu iscrtati duž nje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo sentiero è cambiato dopo l’escursione, quindi i tratti percorsi non possono più essere disegnati lungo di esso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit pad is veranderd sinds de wandeling, dus de stukken die ze afdekte, kunnen er niet meer langs worden getekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten szlak zmienił się od czasu wędrówki, więc przebytych fragmentów nie da się już narysować wzdłuż niego."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest traseu s-a modificat după drumeție, așa că porțiunile parcurse nu mai pot fi desenate pe el."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После похода эта тропа изменилась, поэтому пройденные отрезки больше нельзя нарисовать вдоль нее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
