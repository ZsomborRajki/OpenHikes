        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut salva drumeția."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить поход."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти похід."
          }
        }
      }
    },
    "The hike itself isn’t reported — only the photo somebody added to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung selbst wird nicht gemeldet – nur das Foto, das jemand hinzugefügt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se denuncia la excursión en sí, solo la foto que alguien le añadió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée elle-même n’est pas signalée – seulement la photo que quelqu’un y a ajoutée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’escursione in sé non viene segnalata – solo la foto che qualcuno vi ha aggiunto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama wędrówka nie jest zgłaszana – tylko zdjęcie dodane do niej przez inną osobę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția în sine nu este raportată – doar poza pe care a adăugat-o cineva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалоба подается не на сам поход — только на фото, которое кто-то к нему добавил."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скарга стосується не самого походу — лише фото, доданого до нього іншою людиною."
          }
        }
      }
    },
    "The hike was published but the listing came back unreadable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung wurde veröffentlicht, aber der Eintrag kam unlesbar zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La excursión se ha publicado, pero la ficha devuelta no se puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée a été publiée, mais la fiche renvoyée était illisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’escursione è stata pubblicata, ma la scheda restituita non è leggibile."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wędrówka została opublikowana, ale zwróconej publikacji nie udało się odczytać."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția a fost publicată, dar fișa returnată nu poate fi citită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поход опубликован, но публикацию из ответа сервера не удалось прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похід опубліковано, але публікацію з відповіді сервера не вдалося прочитати."
          }
        }
      }
    },
    "The maker holds one trail at a time, and the one you left half-drawn will be discarded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wegplaner hält jeweils einen Weg, und der halb gezeichnete wird verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El creador de senderos guarda un solo sendero a la vez, y se descartará el que dejaste a medio dibujar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le créateur de sentiers ne conserve qu’un sentier à la fois ; celui que vous avez laissé à moitié dessiné sera supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo strumento per creare sentieri ne contiene uno alla volta, e quello che hai lasciato a metà verrà scartato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreator szlaków przechowuje tylko jeden szlak naraz, więc ten niedokończony zostanie odrzucony."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editorul de trasee păstrează un singur traseu în lucru, iar cel pe care l-ați lăsat desenat pe jumătate va fi șters."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конструктор троп хранит только одну тропу, поэтому та, что вы не дорисовали, будет удалена."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конструктор стежок зберігає лише одну стежку, тож ту, яку ви не домалювали, буде видалено."
          }
        }
      }
    },
    "The map as openstreetmap.org draws it, to compare with the new one. Turn on Auto-Save Tiles in Settings to save the tiles you view for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte, wie openstreetmap.org sie zeichnet, zum Vergleich mit der neuen. Aktiviere in den Einstellungen „Kacheln automatisch speichern“, um angesehene Kacheln für die Offlinenutzung zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa tal como lo dibuja openstreetmap.org, para compararlo con el nuevo. Activa «Guardado automático de teselas» en Ajustes para guardar las teselas que ves y usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte telle qu’openstreetmap.org la dessine, pour la comparer avec la nouvelle. Activez « Enregistrement automatique des tuiles » dans Réglages pour enregistrer les tuiles que vous consultez pour une utilisation hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa come la disegna openstreetmap.org, per confrontarla con quella nuova. Attiva «Salvataggio automatico dei tasselli» in Impostazioni per salvare i tasselli che visualizzi per l’uso offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa w postaci, w jakiej rysuje ją openstreetmap.org, do porównania z nową. Włącz „Automatyczne zapisywanie kafelków” w ustawieniach, aby zapisywać oglądane kafelki do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta așa cum o desenează openstreetmap.org, pentru comparație cu cea nouă. Activați „Salvare automată a dalelor” în Configurări pentru a salva dalele vizualizate și a le folosi offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта в том виде, в каком ее рисует openstreetmap.org, — для сравнения с новой. Включите «Автосохранение тайлов» в настройках, чтобы сохранять просмотренные тайлы для использования офлайн."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта в тому вигляді, у якому її малює openstreetmap.org, — для порівняння з новою. Увімкніть «Автозбереження тайлів» у параметрах, щоб зберігати тайли, які ви переглядаєте, для використання офлайн."
          }
        }
      }
    },
    "The map search service is busy. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kartensuche ist ausgelastet. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de búsqueda del mapa está saturado. Vuelve a intentarlo dentro de un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de recherche de lieux est saturé. Réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio di ricerca sulla mappa è sovraccarico. Riprova tra poco."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa wyszukiwania na mapie jest zajęta. Spróbuj ponownie za chwilę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviciul de căutare pe hartă este ocupat. Reîncercați în câteva momente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервис поиска по карте перегружен. Повторите попытку чуть позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервіс пошуку на карті перевантажений. Спробуйте ще раз трохи згодом."
          }
        }
      }
    },
    "The map shows too wide an area to search. Zoom in, then tap Search This Area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte zeigt einen zu großen Bereich für die Suche. Zoome hinein und tippe dann auf „In diesem Bereich suchen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa muestra una zona demasiado amplia para buscar. Acerca la vista y toca «Buscar en esta zona»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte affiche une zone trop étendue pour la recherche. Zoomez, puis touchez « Rechercher dans cette zone »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa mostra una zona troppo ampia per la ricerca. Ingrandisci, poi tocca «Cerca in questa zona»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa pokazuje zbyt duży obszar, aby go przeszukać. Przybliż ją, a potem stuknij „Szukaj tutaj”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta arată o zonă prea mare pentru căutare. Măriți harta, apoi apăsați pe „Căutați în această zonă”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карте слишком большая область для поиска. Увеличьте масштаб и коснитесь «Искать здесь»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карті надто велика область для пошуку. Наблизьте карту, а потім торкніть «Шукати тут»."
          }
        }
      }
    },
    "The notes above go with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notizen oben werden mitgesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas de arriba también se envían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes ci-dessus sont aussi envoyées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono inviate anche le note qui sopra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatki powyżej są wysyłane razem z nią."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se trimit și notițele de mai sus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметки выше отправляются вместе с ним."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нотатки вище надсилаються разом із ним."
          }
        }
      }
    },
    "The OpenHikes map draws a downloaded country with no signal. Downloads use Wi-Fi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die OpenHikes-Karte zeigt ein heruntergeladenes Land auch ohne Empfang. Downloads laufen über WLAN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa de OpenHikes muestra un país descargado aunque no haya cobertura. Las descargas usan la red Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte OpenHikes affiche un pays téléchargé même sans réseau. Les téléchargements passent par le Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa OpenHikes mostra un paese scaricato anche senza segnale. I download usano il Wi-Fi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa OpenHikes pokazuje pobrany kraj także bez zasięgu. Pobieranie odbywa się przez Wi-Fi."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta OpenHikes afișează și fără semnal o țară descărcată. Descărcările folosesc Wi‑Fi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта OpenHikes показывает загруженную страну даже без сигнала. Загрузка идет по Wi-Fi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта OpenHikes показує викачану країну навіть без сигналу. Викачування відбувається через Wi-Fi."
          }
        }
      }
    },
    "The paid maps are billed per view. Your subscription covers them, so OpenStreetMap stays free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kostenpflichtigen Karten werden pro Aufruf abgerechnet. Dein Abo deckt sie ab, damit OpenStreetMap kostenlos bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mapas de pago se cobran por visualización. Tu suscripción los cubre, así que OpenStreetMap sigue siendo gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes payantes sont facturées à l’affichage. Votre abonnement les couvre, pour qu’OpenStreetMap reste gratuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mappe a pagamento vengono fatturate per visualizzazione. Il tuo abbonamento le copre, così OpenStreetMap resta gratuito."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płatne mapy są rozliczane za każde wyświetlenie. Twoja subskrypcja pokrywa ten koszt, dzięki czemu mapa OpenStreetMap pozostaje bezpłatna."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hărțile cu plată sunt taxate pentru fiecare afișare. Abonamentul dvs. le acoperă, astfel încât OpenStreetMap rămâne gratuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платные карты оплачиваются за каждый просмотр. Ваша подписка покрывает эти расходы, поэтому карта OpenStreetMap остается бесплатной."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платні карти оплачуються за кожен перегляд. Ваша підписка покриває ці витрати, тож карта OpenStreetMap залишається безплатною."
          }
        }
      }
    },
    "The photo is removed from this hike on all your synced devices. Any copy in OpenHikes on this device is deleted for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Foto wird auf all deinen synchronisierten Geräten aus dieser Wanderung entfernt. Jede Kopie in OpenHikes auf diesem Gerät wird endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto se quita de esta excursión en todos tus dispositivos sincronizados. Cualquier copia en OpenHikes de este dispositivo se elimina para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo est retirée de cette randonnée sur tous vos appareils synchronisés. Toute copie dans OpenHikes sur cet appareil est définitivement supprimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La foto viene rimossa da questa escursione su tutti i dispositivi sincronizzati. Qualsiasi copia in OpenHikes su questo dispositivo viene eliminata definitivamente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcie zostanie usunięte z tej wędrówki na wszystkich Twoich zsynchronizowanych urządzeniach. Jego kopia w OpenHikes na tym urządzeniu zostanie trwale usunięta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza este eliminată din această drumeție pe toate dispozitivele dvs. sincronizate. Orice copie din OpenHikes de pe acest dispozitiv este ștearsă definitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото убирается из этого похода на всех ваших синхронизированных устройствах. Его копия в OpenHikes на этом устройстве удаляется безвозвратно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото вилучається з цього походу на всіх ваших синхронізованих пристроях. Будь-яку його копію в OpenHikes на цьому пристрої буде видалено назавжди."
          }
        }
      }
    },
    "The photos are deleted for good. The hiker is not told, and their app goes on reading “waiting for review”. The trail itself is not touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos werden endgültig gelöscht. Die Person wird nicht benachrichtigt, und ihre App zeigt weiterhin „Wartet auf Prüfung“. Der Weg selbst bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se eliminan para siempre. No se avisa a la persona, y su app sigue mostrando «Pendiente de revisión». El sendero en sí no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont définitivement supprimées. La personne n’est pas avertie, et son app continue d’afficher « En attente de vérification ». Le sentier lui-même n’est pas modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto vengono eliminate definitivamente. La persona non viene avvisata, e la sua app continua a mostrare «in attesa di revisione». Il sentiero in sé non viene toccato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia zostaną trwale usunięte. Osoba, która je wysłała, nie dostanie o tym informacji, a jej aplikacja nadal będzie pokazywać „Oczekuje na sprawdzenie”. Sam szlak pozostanie nietknięty."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozele sunt șterse definitiv. Persoana care le-a trimis nu este anunțată, iar aplicația ei afișează în continuare „În așteptarea verificării”. Traseul în sine nu este modificat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото удаляются безвозвратно. Туристу об этом не сообщается, и его приложение по-прежнему показывает «На проверке». Сама тропа не затрагивается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото буде видалено назавжди. Людина, яка їх надіслала, про це не дізнається, і її програма й далі показуватиме «Очікує на перевірку». Сама стежка залишиться без змін."
          }
        }
      }
    },
    "The photos are off the hike for everybody, but the copy stored with their submission couldn’t be deleted. %@ To finish, take them down again before leaving this photo — once you leave, the app can’t reach that copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos sind für alle von der Wanderung entfernt, aber die mit ihrer Einreichung gespeicherte Kopie konnte nicht gelöscht werden. %@ Entferne sie zum Abschließen erneut, bevor du dieses Foto verlässt – danach kann die App diese Kopie nicht mehr erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos ya no aparecen en la excursión para nadie, pero no se ha podido eliminar la copia guardada con su envío. %@ Para terminar, vuelve a retirarlas antes de salir de esta foto: cuando salgas, la app ya no podrá acceder a esa copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont retirées de la randonnée pour tout le monde, mais la copie conservée avec leur soumission n’a pas pu être supprimée. %@ Pour terminer, retirez-les à nouveau avant de quitter cette photo – ensuite, l’app ne pourra plus accéder à cette copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto sono state tolte dall’escursione per tutti, ma non è stato possibile eliminare la copia conservata con il loro invio. %@ Per completare, ritirale di nuovo prima di lasciare questa foto: dopo che l’hai lasciata, l’app non può più raggiungere quella copia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia zniknęły z wędrówki u wszystkich, ale kopii przechowywanej z wysłanymi zdjęciami nie udało się usunąć. %@ Aby dokończyć, wycofaj je ponownie, zanim opuścisz to zdjęcie – potem aplikacja nie będzie mieć dostępu do tej kopii."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozele nu mai apar la drumeție pentru nimeni, dar copia stocată împreună cu trimiterea lor nu a putut fi ștearsă. %@ Pentru a finaliza, retrageți-le din nou înainte de a părăsi această poză – după ce ieșiți, aplicația nu mai poate accesa acea copie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото убраны из похода для всех, но копию, сохраненную с их заявкой, удалить не удалось. %@ Чтобы завершить, снимите их с публикации еще раз, прежде чем уйти с этого фото, — потом приложение не сможет добраться до этой копии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото вилучено з походу для всіх, але копію, збережену з їхньою заявкою, не вдалося видалити. %@ Щоб завершити, зніміть їх з публікації ще раз, перш ніж закрити це фото — щойно ви його закриєте, програма не матиме доступу до цієї копії."
          }
        }
      }
    },
    "The photos were published but the record came back unreadable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos wurden veröffentlicht, aber der Eintrag kam unlesbar zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se han publicado, pero el registro devuelto no se puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos ont été publiées, mais les données renvoyées étaient illisibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto sono state pubblicate, ma il record restituito non è leggibile."
