    "Wikimedia Commons no longer offers this photo, so it can’t be downloaded again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons bietet dieses Foto nicht mehr an, daher kann es nicht erneut heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons ya no ofrece esta foto, así que no se puede volver a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons ne propose plus cette photo : elle ne peut pas être téléchargée à nouveau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons više ne nudi ovu fotografiju, pa se ne može ponovno preuzeti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons non offre più questa foto, quindi non può essere scaricata di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons biedt deze foto niet meer aan, dus hij kan niet opnieuw worden gedownload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons nie udostępnia już tego zdjęcia, więc nie da się go ponownie pobrać."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons nu mai oferă această poză, așa că nu poate fi descărcată din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons больше не предоставляет это фото, поэтому его нельзя загрузить снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikimedia Commons більше не надає це фото, тому його не можна викачати знову."
          }
        }
      }
    },
