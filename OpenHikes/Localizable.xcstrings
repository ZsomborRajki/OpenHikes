        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes musi odczytać Twoją bibliotekę zdjęć, aby znaleźć zdjęcia zrobione podczas tej wędrówki. Możesz to włączyć w Ustawieniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes trebuie să citească biblioteca foto pentru a găsi pozele făcute în timpul acestei drumeții. Puteți activa accesul în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
