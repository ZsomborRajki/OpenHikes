    "Nothing else from this hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonst nichts von dieser Wanderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada más de esta excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien d’autre de cette randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nient’altro da questa escursione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic więcej z tej wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimic altceva din această drumeție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше ничего из этого похода не отправляется."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше нічого з цього походу не надсилається."
          }
        }
      }
    },
    "Nothing in your photo library was taken while you were out on this hike — or everything that was is already here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts in deiner Mediathek wurde aufgenommen, während du auf dieser Wanderung unterwegs warst – oder alles davon ist bereits hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna foto de tu fototeca se tomó durante esta excursión, o todas las que se tomaron ya están aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune photo de votre photothèque n’a été prise pendant cette randonnée – ou elles sont toutes déjà ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella tua libreria foto non ci sono foto scattate durante questa escursione, oppure sono già tutte qui."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Twojej bibliotece zdjęć nie ma niczego zrobionego podczas tej wędrówki – albo wszystko już tu jest."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicio poză din biblioteca foto nu a fost făcută în timpul acestei drumeții – sau toate cele făcute atunci sunt deja aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вашей медиатеке нет снимков, сделанных во время этого похода, — или все они уже здесь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вашій фототеці немає нічого, знятого під час цього походу, — або все це вже тут."
          }
        }
      }
    },
    "Nothing left to publish. Decline these instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts mehr zu veröffentlichen. Lehne diese stattdessen ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No queda nada que publicar. Rechaza estas fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rien à publier. Refusez plutôt ces photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non resta nulla da pubblicare. Rifiuta invece queste foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zostało nic do opublikowania. Zamiast tego odrzuć te zdjęcia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu a mai rămas nimic de publicat. Refuzați în schimb aceste poze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Публиковать больше нечего. Вместо этого отклоните эти фото."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше немає чого публікувати. Натомість відхиліть ці фото."
          }
        }
      }
    },
    "Nothing Mapped" : {
      "localizations" : {
