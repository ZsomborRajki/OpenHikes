    "Syncs your hikes to your other devices through your private iCloud storage. Photos and offline maps stay on the device that saved them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert deine Wanderungen über deinen privaten iCloud-Speicher mit deinen anderen Geräten. Fotos und Offlinekarten bleiben auf dem Gerät, das sie gespeichert hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza tus excursiones con tus otros dispositivos a través de tu almacenamiento privado de iCloud. Las fotos y los mapas sin conexión se quedan en el dispositivo que los guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronise vos randonnées avec vos autres appareils via votre stockage iCloud privé. Les photos et les cartes hors ligne restent sur l’appareil qui les a enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza le escursioni sugli altri tuoi dispositivi tramite il tuo spazio iCloud privato. Le foto e le mappe offline restano sul dispositivo che le ha salvate."
          }
        }
      }
    },
