      }
    },
    "You don’t have to give a reason. It’s your hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst keinen Grund angeben. Es ist deine Wanderung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas à donner de raison. C’est votre randonnée."
          }
        }
      }
    },
    "You haven’t moved for %@. Pause the recording to keep the stop out of your moving time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dich seit %@ nicht bewegt. Pausiere die Aufzeichnung, damit der Halt nicht in deine Bewegungszeit einfließt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas bougé depuis %@. Mettez l’enregistrement en pause pour que cet arrêt ne compte pas dans votre temps en mouvement."
          }
        }
      }
    },
    "You haven’t recorded a hike %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@ keine Wanderung aufgezeichnet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez enregistré aucune randonnée %@."
          }
        }
      }
    },
    "You haven’t walked any of your hikes yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist noch keine deiner Wanderungen gegangen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez encore parcouru aucune de vos randonnées."
          }
        }
      }
    },
    "You saved this from OpenStreetMap, where anyone can already find it. Your own photos can go on the trail that’s already listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dies aus OpenStreetMap gespeichert, wo es bereits alle finden können. Deine eigenen Fotos können zu dem Weg hinzugefügt werden, der schon gelistet ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez enregistré ce sentier depuis OpenStreetMap, où tout le monde peut déjà le trouver. Vos propres photos peuvent être ajoutées au sentier déjà répertorié."
          }
        }
      }
    },
    "You’re %@ in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@ zurückgelegt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez parcouru %@"
          }
        }
      }
    },
    "You’re about %@ from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist etwa %1$@ von %2$@ entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You’re about %1$@ from %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à environ %1$@ de %2$@."
          }
        }
      }
    },
    "You’re hiking %@. End the hike in OpenHikes to start recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist gerade auf %@ unterwegs. Beende die Wanderung in OpenHikes, um mit der Aufzeichnung zu beginnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous parcourez %@. Terminez la randonnée dans OpenHikes pour commencer l’enregistrement."
          }
        }
      }
    },
    "You’re offline — connect to save tiles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline – stelle eine Verbindung her, um Kacheln zu speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne – connectez-vous pour enregistrer des tuiles."
          }
        }
      }
    },
    "You’ve already added photos from this hike. Sending again adds a second set rather than replacing the first. To remove the first, ask from this hike’s screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast bereits Fotos von dieser Wanderung hinzugefügt. Erneutes Senden fügt einen zweiten Satz hinzu, statt den ersten zu ersetzen. Um den ersten zu entfernen, bitte auf der Seite dieser Wanderung darum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà ajouté des photos de cette randonnée. Un nouvel envoi ajoute une deuxième série au lieu de remplacer la première. Pour retirer la première, faites-en la demande depuis l’écran de cette randonnée."
          }
        }
      }
    },
    "You’ve already published this hike. Its route, name and notes stay as they are, and these photos are added to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese Wanderung bereits veröffentlicht. Route, Name und Notizen bleiben, wie sie sind, und diese Fotos werden hinzugefügt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà publié cette randonnée. Son itinéraire, son nom et ses notes restent inchangés, et ces photos y sont ajoutées."
          }
        }
      }
    },
    "You’ve already shared this hike. Sending it again adds a second copy rather than replacing the first. To remove the first, report it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese Wanderung bereits geteilt. Erneutes Senden fügt eine zweite Kopie hinzu, statt die erste zu ersetzen. Um die erste zu entfernen, melde sie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà partagé cette randonnée. La renvoyer ajoute une deuxième copie au lieu de remplacer la première. Pour retirer la première, signalez-la."
          }
        }
      }
    },
    "You’ve already shared this trail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diesen Weg bereits geteilt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà partagé ce sentier"
          }
        }
      }
    },
    "You’ve stopped — checking position less often until you move on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stehst – die Position wird seltener geprüft, bis du weitergehst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à l’arrêt – position vérifiée moins souvent jusqu’à ce que vous repartiez."
          }
        }
      }
    },
    "Your changes to this place couldn’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen an diesem Ort konnten nicht gespeichert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer vos modifications de ce lieu."
          }
        }
      }
    },
    "Your drawing wasn’t lost. Check that the device has storage available, then save again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zeichnung ist nicht verloren. Prüfe, ob auf dem Gerät Speicherplatz verfügbar ist, und speichere dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre tracé n’a pas été perdu. Vérifiez que l’appareil dispose d’espace de stockage, puis enregistrez à nouveau."
          }
        }
      }
    },
    "Your hike" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée"
          }
        }
      }
    },
    "Your hike and photos are uploaded, but the review request didn’t go through, so other hikers can’t see it yet. Finishing sends only the request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung und Fotos sind hochgeladen, aber die Prüfanfrage ist nicht angekommen, daher können andere sie noch nicht sehen. Beim Abschließen wird nur die Anfrage gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée et vos photos ont été transférées, mais la demande de vérification n’a pas abouti : les autres ne peuvent donc pas encore la voir. « Terminer l’envoi » transmet uniquement la demande."
          }
        }
      }
    },
    "Your hike couldn’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung konnte nicht gespeichert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de sauvegarder votre randonnée."
          }
        }
      }
    },
    "Your hike is paused at %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung ist bei %@ pausiert"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée est en pause à %@"
          }
        }
      }
    },
    "Your hike is saved, but it needs you to pick which trail you followed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung ist gespeichert, aber du musst noch auswählen, welchem Weg du gefolgt bist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée est sauvegardée, mais vous devez choisir le sentier que vous avez suivi."
          }
        }
      }
    },
    "Your Hikes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées"
          }
        }
      }
    },
    "Your hikes are kept in your private iCloud storage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen werden in deinem privaten iCloud-Speicher aufbewahrt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées sont conservées dans votre espace de stockage iCloud privé."
          }
        }
      }
    },
    "Your hikes couldn’t be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen konnten nicht gelesen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire vos randonnées."
          }
        }
      }
    },
    "Your hikes lose their offline maps, and the map cache is cleared too. Tiles re-download when you view maps online again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen verlieren ihre Offlinekarten, und auch der Kartencache wird geleert. Kacheln werden erneut geladen, wenn du Karten wieder online ansiehst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées perdront leurs cartes hors ligne, et le cache des cartes sera également vidé. Les tuiles seront à nouveau téléchargées lorsque vous consulterez des cartes en ligne."
          }
        }
      }
    },
    "Your hikes stay on this device only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen bleiben nur auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées restent uniquement sur cet appareil."
          }
        }
      }
    },
    "Your library couldn’t be read just now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen konnten gerade nicht gelesen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire vos randonnées pour le moment."
          }
        }
      }
    },
    "Your order" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Reihenfolge"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre personnalisé"
          }
        }
      }
    },
    "Your Order" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Reihenfolge"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordre personnalisé"
          }
        }
      }
    },
    "Your own hike, already live for other hikers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine eigene Wanderung, bereits für andere sichtbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre propre randonnée, déjà en ligne pour les autres."
          }
        }
      }
    },
    "Your Own Place" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein eigener Ort"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre propre lieu"
          }
        }
      }
    },
    "Your photos are uploaded, but not yet sent for review, so they can’t appear on the trail. Finish sending them, or ask for them to be taken down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos sind hochgeladen, aber noch nicht zur Prüfung gesendet, daher können sie nicht auf dem Weg erscheinen. Schließe das Senden ab oder bitte darum, sie zu entfernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos ont été transférées, mais pas encore envoyées pour vérification : elles ne peuvent donc pas apparaître sur le sentier. Terminez leur envoi ou demandez leur retrait."
          }
        }
      }
    },
    "Your photos are uploaded, but the review request didn’t go through, so they won’t appear on this trail yet. Finishing sends only the request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos sind hochgeladen, aber die Prüfanfrage ist nicht angekommen, daher erscheinen sie noch nicht auf diesem Weg. Beim Abschließen wird nur die Anfrage gesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos ont été transférées, mais la demande de vérification n’a pas abouti : elles n’apparaîtront donc pas encore sur ce sentier. « Terminer l’envoi » transmet uniquement la demande."
          }
        }
      }
    },
    "Your recording has been paused for %@ and you’ve moved %@ since. Resume to put the rest of the hike on the track." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufzeichnung ist seit %1$@ pausiert, und du hast dich seitdem %2$@ bewegt. Setze fort, um den Rest der Wanderung in den Track aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your recording has been paused for %1$@ and you’ve moved %2$@ since. Resume to put the rest of the hike on the track."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre enregistrement est en pause depuis %1$@ et vous avez parcouru %2$@ depuis. Reprenez pour ajouter le reste de la randonnée à la trace."
          }
        }
      }
    },
    "Your report opens in your mail app so you can send it. You don’t need an account to report a hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Meldung öffnet sich in deiner Mail-App, damit du sie senden kannst. Zum Melden einer Wanderung brauchst du keinen Account."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signalement s’ouvre dans votre app de messagerie pour que vous puissiez l’envoyer. Aucun compte n’est nécessaire pour signaler une randonnée."
          }
        }
      }
    },
    "Your request opens in your mail app. Deleting this hike doesn’t take the shared copy down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anfrage öffnet sich in deiner Mail-App. Das Löschen dieser Wanderung entfernt die geteilte Kopie nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre demande s’ouvre dans votre app de messagerie. Supprimer cette randonnée ne retire pas la copie partagée."
          }
        }
      }
    },
    "your route" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "deine Route"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "votre itinéraire"
          }
        }
      }
    },
    "Your route — each point on it with the time you reached it — its name, its length and the date you hiked it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Route – jeder Punkt darauf mit der Zeit, zu der du ihn erreicht hast –, ihr Name, ihre Länge und das Datum, an dem du sie gewandert bist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre itinéraire – chaque point avec l’heure à laquelle vous l’avez atteint –, son nom, sa longueur et la date de votre randonnée."
          }
        }
      }
    },
    "Zoom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomer"
          }
        }
      }
    },
    "Zoom In" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrößern"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom avant"
          }
        }
      }
    },
    "Zoom in to look here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoome hinein, um hier zu suchen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomez pour rechercher ici"
          }
        }
      }
    },
    "Zoom In to Search" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Suchen hineinzoomen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomer pour rechercher"
          }
        }
      }
    },
    "Zoom in to search somewhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoome hinein, um woanders zu suchen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomez pour rechercher ailleurs."
          }
        }
      }
    },
    "Zoom Out" : {
      "localizations" : {
