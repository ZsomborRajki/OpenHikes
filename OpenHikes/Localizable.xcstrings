    "You appear to be offline. Saved hikes and downloaded maps still work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du scheinst offline zu sein. Gespeicherte Wanderungen und geladene Karten funktionieren weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que no tienes conexión. Las excursiones guardadas y los mapas descargados siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez être hors ligne. Les randonnées enregistrées et les cartes téléchargées restent disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu sia offline. Le escursioni salvate e le mappe scaricate funzionano comunque."
          }
        }
      }
    },
    "You don’t have to give a reason. It’s your hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst keinen Grund angeben. Es ist deine Wanderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes que dar ningún motivo. Es tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas à donner de raison. C’est votre randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non devi fornire un motivo. È la tua escursione."
          }
        }
      }
    },
    "You haven’t moved for %@. Pause the recording to keep the stop out of your moving time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dich seit %@ nicht bewegt. Pausiere die Aufzeichnung, damit der Halt nicht in deine Bewegungszeit einfließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te has movido en %@. Pausa la grabación para que el tiempo parado no cuente en tu tiempo en movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas bougé depuis %@. Mettez l’enregistrement en pause pour que cet arrêt ne compte pas dans votre temps en mouvement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ti muovi da %@. Metti in pausa la registrazione per escludere la sosta dal tempo in movimento."
          }
        }
      }
    },
    "You haven’t recorded a hike %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@ keine Wanderung aufgezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has grabado ninguna excursión %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez enregistré aucune randonnée %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai registrato escursioni %@."
          }
        }
      }
    },
    "You haven’t walked any of your hikes yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist noch keine deiner Wanderungen gegangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has recorrido ninguna de tus excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez encore parcouru aucune de vos randonnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora percorso nessuna delle tue escursioni."
          }
        }
      }
    },
    "You saved this from OpenStreetMap, where anyone can already find it. Your own photos can go on the trail that’s already listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dies aus OpenStreetMap gespeichert, wo es bereits alle finden können. Deine eigenen Fotos können zu dem Weg hinzugefügt werden, der schon gelistet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardaste este sendero desde OpenStreetMap, donde cualquiera puede encontrarlo. Puedes añadir tus propias fotos al sendero que ya está en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez enregistré ce sentier depuis OpenStreetMap, où tout le monde peut déjà le trouver. Vos propres photos peuvent être ajoutées au sentier déjà répertorié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hai salvata da OpenStreetMap, dove chiunque può già trovarla. Le tue foto possono andare sul sentiero già presente nell’elenco."
          }
        }
      }
    },
    "You’re %@ in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@ zurückgelegt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llevas %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez parcouru %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai percorso %@"
          }
        }
      }
    },
    "You’re about %@ from %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist etwa %1$@ von %2$@ entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You’re about %1$@ from %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás a unos %1$@ de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à environ %1$@ de %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei a circa %1$@ da %2$@."
          }
        }
      }
    },
    "You’re hiking %@. End the hike in OpenHikes to start recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist gerade auf %@ unterwegs. Beende die Wanderung in OpenHikes, um mit der Aufzeichnung zu beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás recorriendo %@. Termina la excursión en OpenHikes para empezar a grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous parcourez %@. Terminez la randonnée dans OpenHikes pour commencer l’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai percorrendo %@. Termina l’escursione in OpenHikes per iniziare a registrare."
          }
        }
      }
    },
    "You’re offline — connect to save tiles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline – stelle eine Verbindung her, um Kacheln zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión: conéctate para guardar teselas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne – connectez-vous pour enregistrer des tuiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei offline – connettiti per salvare i tasselli."
          }
        }
      }
    },
    "You’ve already added photos from this hike. Sending again adds a second set rather than replacing the first. To remove the first, ask from this hike’s screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast bereits Fotos von dieser Wanderung hinzugefügt. Erneutes Senden fügt einen zweiten Satz hinzu, statt den ersten zu ersetzen. Um den ersten zu entfernen, bitte auf der Seite dieser Wanderung darum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya has añadido fotos de esta excursión. Si las vuelves a enviar, se añade un segundo conjunto en vez de sustituir el primero. Para retirar el primero, pídelo desde la pantalla de esta excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà ajouté des photos de cette randonnée. Un nouvel envoi ajoute une deuxième série au lieu de remplacer la première. Pour retirer la première, faites-en la demande depuis l’écran de cette randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già aggiunto foto da questa escursione. Inviandole di nuovo aggiungi una seconda serie invece di sostituire la prima. Per rimuovere la prima, chiedilo dalla schermata di questa escursione."
          }
        }
      }
    },
    "You’ve already published this hike. Its route, name and notes stay as they are, and these photos are added to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese Wanderung bereits veröffentlicht. Route, Name und Notizen bleiben, wie sie sind, und diese Fotos werden hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya has publicado esta excursión. Su ruta, su nombre y sus notas se quedan como están, y se le añaden estas fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà publié cette randonnée. Son itinéraire, son nom et ses notes restent inchangés, et ces photos y sont ajoutées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già pubblicato questa escursione. Percorso, nome e note restano invariati, e queste foto vengono aggiunte."
          }
        }
      }
    },
    "You’ve already shared this hike. Sending it again adds a second copy rather than replacing the first. To remove the first, report it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese Wanderung bereits geteilt. Erneutes Senden fügt eine zweite Kopie hinzu, statt die erste zu ersetzen. Um die erste zu entfernen, melde sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya has compartido esta excursión. Si la vuelves a enviar, se añade una segunda copia en vez de sustituir la primera. Para retirar la primera, denúnciala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà partagé cette randonnée. La renvoyer ajoute une deuxième copie au lieu de remplacer la première. Pour retirer la première, signalez-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già condiviso questa escursione. Inviandola di nuovo aggiungi una seconda copia invece di sostituire la prima. Per rimuovere la prima, segnalala."
          }
        }
      }
    },
    "You’ve already shared this trail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diesen Weg bereits geteilt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya has compartido este sendero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà partagé ce sentier"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già condiviso questo sentiero"
          }
        }
      }
    },
    "You’ve stopped — checking position less often until you move on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du stehst – die Position wird seltener geprüft, bis du weitergehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te has detenido: se comprueba la posición con menos frecuencia hasta que sigas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes à l’arrêt – position vérifiée moins souvent jusqu’à ce que vous repartiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei in sosta: la posizione viene controllata meno spesso finché non riparti."
          }
        }
      }
    },
    "Your changes to this place couldn’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderungen an diesem Ort konnten nicht gespeichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido guardar los cambios de este lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer vos modifications de ce lieu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare le modifiche a questo luogo."
          }
        }
      }
    },
    "Your drawing wasn’t lost. Check that the device has storage available, then save again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zeichnung ist nicht verloren. Prüfe, ob auf dem Gerät Speicherplatz verfügbar ist, und speichere dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dibujo no se ha perdido. Comprueba que el dispositivo tenga espacio de almacenamiento y vuelve a guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre tracé n’a pas été perdu. Vérifiez que l’appareil dispose d’espace de stockage, puis enregistrez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo disegno non è andato perso. Verifica che il dispositivo abbia spazio disponibile, poi salva di nuovo."
          }
        }
      }
    },
    "Your hike" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu excursión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua escursione"
          }
        }
      }
    },
    "Your hike and photos are uploaded, but the review request didn’t go through, so other hikers can’t see it yet. Finishing sends only the request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung und Fotos sind hochgeladen, aber die Prüfanfrage ist nicht angekommen, daher können andere sie noch nicht sehen. Beim Abschließen wird nur die Anfrage gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu excursión y tus fotos se han subido, pero la solicitud de revisión no se ha completado, así que otras personas aún no pueden verla. «Terminar el envío» solo envía la solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée et vos photos ont été transférées, mais la demande de vérification n’a pas abouti : les autres ne peuvent donc pas encore la voir. « Terminer l’envoi » transmet uniquement la demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’escursione e le foto sono state caricate, ma la richiesta di revisione non è andata a buon fine, quindi le altre persone non possono ancora vederla. Completando l’invio si invia solo la richiesta."
          }
        }
      }
    },
    "Your hike couldn’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung konnte nicht gespeichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de sauvegarder votre randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare la tua escursione."
          }
        }
      }
    },
    "Your hike is paused at %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung ist bei %@ pausiert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu excursión está en pausa tras %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée est en pause à %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua escursione è in pausa a %@"
          }
        }
      }
    },
    "Your hike is saved, but it needs you to pick which trail you followed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderung ist gespeichert, aber du musst noch auswählen, welchem Weg du gefolgt bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu excursión está guardada, pero tienes que elegir qué sendero seguiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée est sauvegardée, mais vous devez choisir le sentier que vous avez suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua escursione è salvata, ma devi scegliere quale sentiero hai seguito."
          }
        }
      }
    },
    "Your Hikes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
