          "stringUnit" : {
            "state" : "translated",
            "value" : "Desnivel positivo, perfil de altitud y colores de pendiente de Stadia Maps, para los senderos que dibujas y las rutas sin datos de altitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dénivelé positif, profil altimétrique et couleurs de pente de Stadia Maps, pour les sentiers que vous dessinez et les itinéraires sans données d’altitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dislivello, profilo altimetrico e colori della pendenza da Stadia Maps, per i sentieri che disegni e i percorsi senza dati altimetrici."
          }
        }
      }
    },
    "Climb, Highest and Steepest leave out activities along trails that have changed since you hiked them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufstieg, Höchste und Steilste lassen Aktivitäten auf Wegen aus, die sich geändert haben, seit du sie gewandert bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Desnivel positivo», «Mayor altitud» y «Mayor pendiente» excluyen las actividades por senderos que han cambiado desde que los recorriste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Dénivelé positif », « La plus haute » et « La plus raide » excluent les activités sur des sentiers modifiés depuis votre passage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Dislivello positivo», «Più alta» e «Più ripida» escludono le attività lungo sentieri modificati dopo che li hai percorsi."
          }
        }
      }
    },
