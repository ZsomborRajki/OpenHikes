    "Resume it, stop to save it, or discard it below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze sie fort, beende sie zum Speichern oder verwirf sie unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanúdala, detenla para guardarla o descártala abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez-le, arrêtez-le pour le sauvegarder ou supprimez-le ci-dessous."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavite je, zaustavite kako biste je spremili ili je odbacite u nastavku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendila, interrompila per salvarla oppure scartala qui sotto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hervat haar, stop om haar te bewaren of verwijder haar hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wznów je, zatrzymaj, aby je zapisać, albo odrzuć poniżej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuați-o, opriți-o pentru a o salva sau abandonați-o mai jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возобновите ее, остановите, чтобы сохранить, или удалите ниже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поновіть його, зупиніть, щоб зберегти, або видаліть нижче."
          }
        }
      }
    },
    "Resumes the paused hike, from its Lock Screen panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die pausierte Wanderung über ihre Anzeige auf dem Sperrbildschirm fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanuda la excursión en pausa, desde su panel en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend la randonnée en pause, depuis son panneau sur l’écran verrouillé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavlja pauziranu turu, s ploče na zaključanom zaslonu."
