    "Uploaded, but not yet sent for review, so it can’t appear for other hikers. Finish sending it, or ask for it to be taken down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochgeladen, aber noch nicht zur Prüfung gesendet, daher kann sie für andere nicht erscheinen. Schließe das Senden ab oder bitte darum, sie zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha subido, pero aún no se ha enviado para revisión, así que no puede aparecer para otras personas. Termina de enviarla o pide que se retire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée a été transférée, mais pas encore envoyée pour vérification : les autres ne peuvent donc pas la voir. Terminez son envoi ou demandez son retrait."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preneseno, ali još nije poslano na pregled, pa se ne može prikazati drugim planinarima. Dovršite slanje ili zatražite uklanjanje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caricata, ma non ancora inviata per la revisione, quindi le altre persone non possono vederla. Completa l’invio, oppure chiedi che venga rimossa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geüpload, maar nog niet verstuurd voor beoordeling, dus ze kan niet verschijnen voor andere wandelaars. Voltooi de verzending, of vraag om haar offline te halen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesłano na serwer, ale nie wysłano jeszcze do sprawdzenia, więc inne osoby tego nie zobaczą. Dokończ wysyłanie albo poproś o usunięcie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția a fost încărcată, dar nu a fost încă trimisă spre verificare, așa că nu poate apărea pentru alți drumeți. Finalizați trimiterea sau solicitați retragerea ei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выгружено, но еще не отправлено на проверку, поэтому другие туристы этого не видят. Завершите отправку или запросите снятие с публикации."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закачано, але ще не надіслано на перевірку, тому інші туристи цього не бачать. Завершіть надсилання або попросіть зняти з публікації."
          }
        }
      }
    },
