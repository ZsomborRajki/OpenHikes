    "Background App Refresh is off, so the track may be sparse while OpenHikes isn’t open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrundaktualisierung ist deaktiviert, daher kann der Track lückenhaft sein, solange OpenHikes nicht geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización en segundo plano está desactivada, así que el track puede tener pocos puntos mientras la app no esté abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’actualisation en arrière-plan est désactivée : la trace risque d’être incomplète tant qu’OpenHikes n’est pas ouvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Aggiorna app in background» è disattivato, quindi la traccia potrebbe risultare rada mentre OpenHikes non è aperta."
          }
        }
      }
    },
    "Background App Refresh is off, so this may not update while OpenHikes is closed." : {
