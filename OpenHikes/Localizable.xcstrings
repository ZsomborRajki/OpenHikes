    "Choose which places and photos the search on the map finds near your trail. Turning one off also hides its pins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, welche Orte und Fotos die Suche auf der Karte nahe deinem Weg findet. Wenn du etwas deaktivierst, werden auch seine Stecknadeln ausgeblendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué lugares y fotos encuentra la búsqueda del mapa cerca de tu sendero. Al desactivar uno, también se ocultan sus chinchetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les lieux et les photos que la recherche sur la carte trouve près de votre sentier. En désactiver un masque aussi ses épingles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite koja mjesta i fotografije pretraživanje na karti pronalazi u blizini vaše staze. Isključivanjem neke stavke skrivaju se i njezine igle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli quali luoghi e quali foto trova la ricerca sulla mappa vicino al tuo sentiero. Se ne disattivi uno, ne nascondi anche i segnaposto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies welke plaatsen en foto’s de zoekfunctie op de kaart bij je pad vindt. Als je er een uitzet, worden ook de spelden ervan verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, które miejsca i zdjęcia wyszukiwanie na mapie znajduje w pobliżu Twojego szlaku. Wyłączenie któregoś rodzaju ukrywa też jego pinezki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alegeți ce locuri și ce poze găsește căutarea pe hartă în apropierea traseului dvs. Dacă dezactivați o categorie, îi ascundeți și reperele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, какие места и фото поиск на карте находит рядом с вашей тропой. Если выключить тип, его метки тоже скроются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, які місця й фото пошук на карті знаходить поблизу вашої стежки. Якщо вимкнути тип, його маркери також буде приховано."
          }
        }
      }
    },
