    "They’re removed for everybody and deleted for good. The hike itself isn’t touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden für alle entfernt und endgültig gelöscht. Die Wanderung selbst bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se retiran para todo el mundo y se eliminan para siempre. La excursión en sí no se modifica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles sont retirées pour tout le monde et supprimées définitivement. La randonnée elle-même n’est pas modifiée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono rimosse per tutti ed eliminate definitivamente. L’escursione in sé non viene toccata."
          }
        }
      }
    },
    "This account can’t review submissions." : {
      "localizations" : {
