    "Reports are read and acted on within 24 hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldungen werden innerhalb von 24 Stunden gelesen und bearbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las denuncias se leen y se atienden en un plazo de 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signalements sont lus et traités sous 24 heures."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijave se čitaju i rješavaju u roku od 24 sata."
