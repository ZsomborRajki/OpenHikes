          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché publiquement à côté de votre randonnée. Il n’est pas nécessaire d’indiquer votre vrai nom, et vous pouvez le laisser vide."
          }
        }
      }
    },
    "Shows a trail you choose, or your selected trail, or a hike currently being recorded." : {
      "extractionState" : "manual",
