    "%@ allows %@ of saved maps on this device, and that’s used up. Saving this route deletes about %@ of the saved maps you’ve used least recently. Those hikes keep their routes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erlaubt %2$@ an gespeicherten Karten auf diesem Gerät, und das ist aufgebraucht. Beim Speichern dieser Route werden etwa %3$@ der gespeicherten Karten gelöscht, die du am längsten nicht verwendet hast. Diese Wanderungen behalten ihre Routen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ allows %2$@ of saved maps on this device, and that’s used up. Saving this route deletes about %3$@ of the saved maps you’ve used least recently. Those hikes keep their routes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ permite %2$@ de mapas guardados en este dispositivo, y ese espacio ya está lleno. Al guardar esta ruta se eliminarán unos %3$@ de los mapas guardados que hace más tiempo que no usas. Esas excursiones conservan sus rutas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ autorise %2$@ de cartes enregistrées sur cet appareil, et cette limite est atteinte. Enregistrer cet itinéraire supprimera environ %3$@ des cartes enregistrées que vous avez utilisées le moins récemment. Ces randonnées conservent leurs itinéraires."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dopušta %2$@ spremljenih karata na ovom uređaju i to je potrošeno. Spremanjem ove rute obrisat će se oko %3$@ spremljenih karata koje najdulje niste koristili. Te ture zadržavaju svoje rute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ consente %2$@ di mappe salvate su questo dispositivo, e lo spazio è esaurito. Salvando questo percorso verranno eliminati circa %3$@ delle mappe salvate che hai usato meno di recente. Quelle escursioni conservano i loro percorsi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ staat %2$@ aan bewaarde kaarten toe op dit apparaat, en die ruimte is op. Als je deze route bewaart, wordt ongeveer %3$@ verwijderd van de bewaarde kaarten die je het langst niet hebt gebruikt. Die wandelingen behouden hun routes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pozwala przechowywać na tym urządzeniu %2$@ zapisanych map i ten limit został wyczerpany. Zapisanie tej trasy usunie około %3$@ zapisanych map, które były używane najdawniej. Te wędrówki zachowają swoje trasy."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ permite %2$@ de hărți salvate pe acest dispozitiv, iar limita a fost atinsă. Salvarea acestei rute șterge circa %3$@ din hărțile salvate pe care nu le-ați mai folosit de cel mai mult timp. Acele drumeții își păstrează rutele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ разрешает хранить на этом устройстве %2$@ сохраненных карт, и этот объем исчерпан. При сохранении этого маршрута будет удалено около %3$@ сохраненных карт, которыми вы не пользовались дольше всего. Маршруты этих походов останутся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ дозволяє зберігати на цьому пристрої до %2$@ карт, і цей обсяг вичерпано. Під час збереження цього маршруту буде видалено приблизно %3$@ збережених карт, якими ви найдовше не користувалися. Маршрути тих походів залишаться."
          }
        }
      }
    },
