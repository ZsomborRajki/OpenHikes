          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert deine Wanderungen über deinen privaten iCloud-Speicher mit deinen anderen Geräten. Fotos und Offlinekarten bleiben auf dem Gerät, das sie gespeichert hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronise vos randonnées avec vos autres appareils via votre stockage iCloud privé. Les photos et les cartes hors ligne restent sur l’appareil qui les a enregistrées."
          }
        }
      }
    },
    "Take a photo of this trail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto von diesem Weg aufnehmen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre une photo de ce sentier"
          }
        }
      }
    },
    "Take Down" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
