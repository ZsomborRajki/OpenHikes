    "This came from a GPX file, which records where a photo was taken but not the photo itself. Its place is on the map." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies stammt aus einer GPX-Datei, die festhält, wo ein Foto aufgenommen wurde, aber nicht das Foto selbst. Seine Stelle ist auf der Karte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto viene de un archivo GPX, que registra dónde se tomó una foto pero no la foto en sí. Su ubicación está en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci provient d’un fichier GPX, qui indique où une photo a été prise, mais pas la photo elle-même. Son emplacement est indiqué sur la carte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo potječe iz GPX datoteke, koja bilježi gdje je fotografija snimljena, ali ne i samu fotografiju. Njezino mjesto je na karti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proviene da un file GPX, che registra dove è stata scattata una foto ma non la foto stessa. La sua posizione è sulla mappa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit komt uit een GPX-bestand, dat vastlegt waar een foto is gemaakt, maar niet de foto zelf. De plek staat op de kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To pochodzi z pliku GPX, w którym zapisano miejsce zrobienia zdjęcia, ale nie samo zdjęcie. Jego miejsce jest na mapie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta provine dintr-un fișier GPX, care înregistrează unde a fost făcută o poză, dar nu și poza propriu-zisă. Poziția ei apare pe hartă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это взято из файла GPX, в котором записано, где сделано фото, но нет самого фото. Его место показано на карте."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це взято з файлу GPX, у якому записано, де зроблено фото, але не саме фото. Його місце показано на карті."
          }
        }
      }
    },
