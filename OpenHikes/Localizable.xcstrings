    "Save the viewpoint, shelter or water you’re standing at, and add photos to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere den Aussichtspunkt, die Schutzhütte oder die Wasserstelle, an der du stehst, und füge Fotos hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el mirador, el refugio o la fuente donde estás y añádele fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le point de vue, l’abri ou le point d’eau où vous vous trouvez, et ajoutez-y des photos."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremite vidikovac, sklonište ili vodu kod koje stojite i dodajte im fotografije."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva il punto panoramico, il riparo o la fonte d’acqua dove ti trovi, e aggiungi delle foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar het uitzichtpunt, de schuilhut of het water waar je staat, en voeg er foto’s aan toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz punkt widokowy, wiatę lub źródło wody, przy którym stoisz, i dodaj do niego zdjęcia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
