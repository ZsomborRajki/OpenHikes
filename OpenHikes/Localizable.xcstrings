    "%lld of this submission’s photos didn’t download, so none can be left out here — leaving one out rewrites the whole set from the copies on this device. Publish it as it is, decline it, or open it again." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Eines der Fotos dieser Einreichung wurde nicht geladen, daher kann hier keines weggelassen werden – wird eines weggelassen, wird der ganze Satz aus den Kopien auf diesem Gerät neu geschrieben. Veröffentliche sie so, wie sie ist, lehne sie ab oder öffne sie erneut."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Fotos dieser Einreichung wurden nicht geladen, daher kann hier keines weggelassen werden – wird eines weggelassen, wird der ganze Satz aus den Kopien auf diesem Gerät neu geschrieben. Veröffentliche sie so, wie sie ist, lehne sie ab oder öffne sie erneut."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "One of this submission’s photos didn’t download, so none can be left out here — leaving one out rewrites the whole set from the copies on this device. Publish it as it is, decline it, or open it again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld of this submission’s photos didn’t download, so none can be left out here — leaving one out rewrites the whole set from the copies on this device. Publish it as it is, decline it, or open it again."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photos de cette soumission n’ont pas été téléchargées : aucune ne peut donc être exclue ici – en exclure une réécrirait tout l’ensemble à partir des copies présentes sur cet appareil. Publiez-la telle quelle, refusez-la ou rouvrez-la."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld photo de cette soumission n’a pas été téléchargée : aucune ne peut donc être exclue ici – en exclure une réécrirait tout l’ensemble à partir des copies présentes sur cet appareil. Publiez-la telle quelle, refusez-la ou rouvrez-la."
