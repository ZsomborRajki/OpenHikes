    "%@ already covers the same ground, so this hike stays in your own list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deckt bereits dieselbe Strecke ab, daher bleibt diese Wanderung in deiner eigenen Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya cubre el mismo recorrido, así que esta excursión se queda en tu propia lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ couvre déjà le même parcours : cette randonnée reste donc dans votre propre liste."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ već pokriva isti teren, pa ova tura ostaje na vašem popisu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ copre già lo stesso tracciato, quindi questa escursione resta nel tuo elenco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beslaat al hetzelfde terrein, dus deze wandeling blijft in je eigen lijst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szlak „%@” obejmuje już tę samą trasę, więc ta wędrówka zostaje na Twojej liście."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ urmează deja același traseu, așa că această drumeție rămâne în lista dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
