    "Share only a route, photos and notes that are yours to publish. A hike that starts at your front door shows where you live." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile nur eine Route, Fotos und Notizen, die du veröffentlichen darfst. Eine Wanderung, die an deiner Haustür beginnt, zeigt, wo du wohnst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte solo una ruta, unas fotos y unas notas que tengas derecho a publicar. Una excursión que empieza en la puerta de tu casa muestra dónde vives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne partagez qu’un itinéraire, des photos et des notes que vous avez le droit de publier. Une randonnée qui part de votre porte révèle où vous habitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi solo un percorso, foto e note che hai il diritto di pubblicare. Un’escursione che parte dalla porta di casa mostra dove abiti."
          }
        }
      }
    },
