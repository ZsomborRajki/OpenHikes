        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося визначити, який це день."
          }
        }
      }
    },
    "OpenHikes doesn’t have Always location access, so this can’t run. Turn it on in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
