          }
        }
      }
    },
    "Your hikes are kept in your private iCloud storage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen werden in deinem privaten iCloud-Speicher aufbewahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus excursiones se guardan en tu almacenamiento privado de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées sont conservées dans votre espace de stockage iCloud privé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue escursioni sono conservate nel tuo spazio iCloud privato."
          }
        }
      }
    },
    "Your hikes couldn’t be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen konnten nicht gelesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer tus excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire vos randonnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere le tue escursioni."
          }
        }
      }
    },
    "Your hikes lose their offline maps, and the map cache is cleared too. Tiles re-download when you view maps online again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen verlieren ihre Offlinekarten, und auch der Kartencache wird geleert. Kacheln werden erneut geladen, wenn du Karten wieder online ansiehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus excursiones perderán sus mapas sin conexión, y también se borrará la caché de mapas. Las teselas se volverán a descargar cuando vuelvas a ver mapas con conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées perdront leurs cartes hors ligne, et le cache des cartes sera également vidé. Les tuiles seront à nouveau téléchargées lorsque vous consulterez des cartes en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue escursioni perdono le mappe offline, e anche la cache delle mappe viene svuotata. I tasselli verranno scaricati di nuovo quando visualizzerai le mappe online."
          }
        }
      }
    },
    "Your hikes stay on this device only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wanderungen bleiben nur auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus excursiones solo se quedan en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos randonnées restent uniquement sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue escursioni restano solo su questo dispositivo."
          }
        }
      }
    },
    "Your library couldn’t be read just now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
