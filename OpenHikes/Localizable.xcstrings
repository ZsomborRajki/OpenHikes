    "%@ is already in the list. Your photos can go on it, and a person checks them first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ steht bereits in der Liste. Deine Fotos können dort hinzugefügt werden, und eine Person prüft sie zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya está en la lista. Puedes añadirle tus fotos, y una persona las revisa antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ figure déjà dans la liste. Vos photos peuvent y être ajoutées, et une personne les vérifie d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già nell’elenco. Puoi aggiungervi le tue foto, e una persona le controlla prima."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szlak „%@” jest już na liście. Możesz dodać do niego swoje zdjęcia, które najpierw sprawdzi człowiek."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se află deja în listă. Puteți adăuga pozele dvs. la acest traseu, iar o persoană le verifică mai întâi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже есть в списке. К этой тропе можно добавить ваши фото, но сначала их проверит человек."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стежка «%@» уже є в списку. Ваші фото можна додати до неї, але спершу їх перевірить людина."
          }
        }
      }
    },
    "%@ is paused, but you’ve covered %@ of it since. Resume to keep your progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist pausiert, aber du hast seitdem %2$@ davon zurückgelegt. Setze fort, um deinen Fortschritt zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is paused, but you’ve covered %2$@ of it since. Resume to keep your progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está en pausa, pero desde entonces has recorrido %2$@. Reanuda la marcha para conservar tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est en pause, mais vous en avez parcouru %2$@ depuis. Reprenez pour conserver votre progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è in pausa, ma da allora hai percorso %2$@. Riprendi per conservare i tuoi progressi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: wstrzymano, ale od tego czasu przebyto %2$@. Wznów, aby zachować postęp."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ este în pauză, dar de atunci ați mai parcurs %2$@. Continuați pentru a vă păstra progresul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ на паузе, но с тех пор вы прошли еще %2$@. Возобновите, чтобы сохранить прогресс."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: призупинено, але відтоді ви пройшли ще %2$@. Поновіть, щоб не втратити прогрес."
          }
        }
      }
