    "Routes use Apple Maps directions. Turn this off to draw straight lines." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routen verwenden die Routenplanung von Apple Karten. Deaktiviere dies, um gerade Linien zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las rutas usan las indicaciones de Mapas de Apple. Desactiva esta opción para dibujar líneas rectas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les itinéraires utilisent le calcul d’itinéraire de Plans. Désactivez cette option pour tracer des lignes droites."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rute koriste upute Apple Karata. Isključite ovo za crtanje ravnih linija."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I percorsi usano le indicazioni di Mappe di Apple. Disattiva questa opzione per disegnare linee rette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Routes gebruiken routebeschrijvingen van Apple Kaarten. Zet dit uit om rechte lijnen te tekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasy są wyznaczane za pomocą Map Apple. Wyłącz, aby rysować linie proste."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rutele sunt calculate de Hărți Apple. Dezactivați opțiunea pentru a trasa linii drepte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршруты прокладываются с помощью Карт Apple. Выключите, чтобы рисовать прямые линии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маршрути прокладаються за допомогою Карт Apple. Вимкніть, щоб малювати прямі лінії."
          }
        }
      }
    },
