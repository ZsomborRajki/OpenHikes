          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La publication attend le chargement de la description et des photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pubblicazione attende il caricamento della descrizione e delle fotografie."
