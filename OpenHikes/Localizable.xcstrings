    "Nothing in your photo library was taken while you were out on this hike — or everything that was is already here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts in deiner Mediathek wurde aufgenommen, während du auf dieser Wanderung unterwegs warst – oder alles davon ist bereits hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna foto de tu fototeca se tomó durante esta excursión, o todas las que se tomaron ya están aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune photo de votre photothèque n’a été prise pendant cette randonnée – ou elles sont toutes déjà ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ništa u vašoj medijateci nije snimljeno dok ste bili na ovoj turi – ili je sve što jest već ovdje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella tua libreria foto non ci sono foto scattate durante questa escursione, oppure sono già tutte qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets in je fotobibliotheek is gemaakt terwijl je deze wandeling liep – of alles wat er toen is gemaakt, staat hier al."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Twojej bibliotece zdjęć nie ma niczego zrobionego podczas tej wędrówki – albo wszystko już tu jest."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicio poză din biblioteca foto nu a fost făcută în timpul acestei drumeții – sau toate cele făcute atunci sunt deja aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вашей медиатеке нет снимков, сделанных во время этого похода, — или все они уже здесь."
          }
        },
        "uk" : {
