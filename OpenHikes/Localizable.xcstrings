    "iCloud hasn’t finished this yet. It will catch up on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist damit noch nicht fertig und holt das von selbst nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud aún no ha terminado. Se pondrá al día por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’a pas encore terminé. La synchronisation se terminera d’elle-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud non ha ancora finito. Si metterà in pari da solo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja z iCloud jeszcze się nie zakończyła. Dokończy się sama."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud nu a terminat încă sincronizarea. Va continua automat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация с iCloud еще не завершена. Она закончится сама."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію з iCloud ще не завершено. Вона завершиться сама."
          }
        }
      }
    },
    "iCloud hasn’t finished this yet. It will catch up on its own. Last synced %@." : {
