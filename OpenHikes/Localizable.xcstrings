    "This map can’t be downloaded. Turn on Auto-Save Tiles in Settings to save it around this hike as you browse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Karte lässt sich nicht herunterladen. Aktiviere in den Einstellungen „Kacheln automatisch speichern“, um sie rund um diese Wanderung beim Ansehen zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mapa no se puede descargar. Activa «Guardado automático de teselas» en Ajustes para guardarlo alrededor de esta excursión mientras lo exploras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette carte ne peut pas être téléchargée. Activez « Enregistrement automatique des tuiles » dans Réglages pour l’enregistrer autour de cette randonnée pendant que vous la consultez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova se karta ne može preuzeti. Uključite “Automatski spremaj pločice” u Postavkama kako biste je spremali oko ove ture dok pregledavate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa mappa non può essere scaricata. Attiva «Salvataggio automatico dei tasselli» in Impostazioni per salvarla intorno a questa escursione mentre la esplori."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kaart kan niet worden gedownload. Zet ‘Bewaar tegels automatisch’ aan in Instellingen om hem rond deze wandeling te bewaren terwijl je rondkijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tej mapy nie można pobrać. Włącz „Automatyczne zapisywanie kafelków” w ustawieniach, aby zapisywać ją wokół tej wędrówki podczas przeglądania."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această hartă nu poate fi descărcată. Activați „Salvare automată a dalelor” în Configurări pentru a o salva în jurul acestei drumeții pe măsură ce o explorați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эту карту нельзя загрузить. Включите «Автосохранение тайлов» в настройках, чтобы сохранять ее вокруг этого похода, пока вы просматриваете карту."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю карту не можна викачати. Увімкніть «Автозбереження тайлів» у параметрах, щоб зберігати її навколо цього походу під час перегляду."
          }
        }
      }
    },
