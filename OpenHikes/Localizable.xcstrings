            "value" : "Luoghi intorno al sentiero"
          }
        }
      }
    },
    "Places from OpenStreetMap in the area on the map. Press and hold the map to add your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte aus OpenStreetMap im Bereich auf der Karte. Halte die Karte gedrückt, um eigene hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares de OpenStreetMap en la zona del mapa. Mantén pulsado el mapa para añadir los tuyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieux d’OpenStreetMap dans la zone affichée sur la carte. Maintenez le doigt sur la carte pour ajouter les vôtres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luoghi di OpenStreetMap nella zona visibile sulla mappa. Tieni premuto sulla mappa per aggiungerne uno tuo."
          }
        }
      }
    },
    "Places from OpenStreetMap. Press and hold the map to add a place of your own anywhere, on the trail or off it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte aus OpenStreetMap. Halte die Karte gedrückt, um überall einen eigenen Ort hinzuzufügen, auf dem Weg oder abseits davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares de OpenStreetMap. Mantén pulsado el mapa para añadir un lugar propio en cualquier sitio, en el sendero o fuera de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lieux d’OpenStreetMap. Maintenez le doigt sur la carte pour ajouter votre propre lieu n’importe où, sur le sentier ou en dehors."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luoghi di OpenStreetMap. Tieni premuto sulla mappa per aggiungere un tuo luogo ovunque, sul sentiero o fuori."
          }
        }
      }
    },
    "Places Nearby" : {
      "localizations" : {
