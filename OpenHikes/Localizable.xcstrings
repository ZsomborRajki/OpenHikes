    "Zoom in to look here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoome hinein, um hier zu suchen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca la vista para buscar aquí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomez pour rechercher ici"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
