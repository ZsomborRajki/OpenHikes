    "%@ is already in the list. Your photos can go on it, and a person checks them first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ steht bereits in der Liste. Deine Fotos können dort hinzugefügt werden, und eine Person prüft sie zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya está en la lista. Puedes añadirle tus fotos, y una persona las revisa antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ figure déjà dans la liste. Vos photos peuvent y être ajoutées, et une personne les vérifie d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è già nell’elenco. Puoi aggiungervi le tue foto, e una persona le controlla prima."
          }
        }
      }
    },
    "%@ is paused, but you’ve covered %@ of it since. Resume to keep your progress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ist pausiert, aber du hast seitdem %2$@ davon zurückgelegt. Setze fort, um deinen Fortschritt zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is paused, but you’ve covered %2$@ of it since. Resume to keep your progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ está en pausa, pero desde entonces has recorrido %2$@. Reanuda la marcha para conservar tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ est en pause, mais vous en avez parcouru %2$@ depuis. Reprenez pour conserver votre progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è in pausa, ma da allora hai percorso %2$@. Riprendi per conservare i tuoi progressi."
          }
        }
      }
    },
