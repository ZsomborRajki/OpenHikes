          }
        }
      }
    },
    "Community hikes are ones worth someone else’s day out — a whole route, hiked by you, that isn’t already on the list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Wanderungen sind solche, die anderen einen ganzen Tag draußen wert sind – eine vollständige Route, von dir gewandert, die noch nicht in der Liste steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excursiones de la comunidad son las que merecen la salida de otra persona: una ruta completa, recorrida por ti, que no esté ya en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les randonnées de la communauté sont celles qui valent une journée de sortie pour quelqu’un d’autre – un itinéraire complet, parcouru par vous, qui ne figure pas déjà dans la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le escursioni della community sono quelle per cui vale la pena che qualcun altro dedichi una giornata: un percorso completo, fatto da te, che non sia già nell’elenco."
          }
        }
      }
    },
    "Community hikes start at %@; this one is %@. It stays in your own list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Community-Wanderungen beginnen bei %1$@; diese hat %2$@. Sie bleibt in deiner eigenen Liste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Community hikes start at %1$@; this one is %2$@. It stays in your own list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excursiones de la comunidad tienen al menos %1$@; esta tiene %2$@. Se queda en tu propia lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les randonnées de la communauté font au moins %1$@ ; celle-ci fait %2$@. Elle reste dans votre propre liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le escursioni della community partono da %1$@; questa è di %2$@. Resta nel tuo elenco."
          }
        }
      }
    },
    "Community shows hikes other people shared, and OpenStreetMap trails, for the area on the map." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Community zeigt Wanderungen, die andere geteilt haben, und Wege aus OpenStreetMap für den Bereich auf der Karte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Comunidad» muestra las excursiones que otras personas han compartido y los senderos de OpenStreetMap de la zona que se ve en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet « Communauté » affiche les randonnées partagées par d’autres personnes et les sentiers OpenStreetMap de la zone visible sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Community mostra le escursioni condivise da altre persone e i sentieri di OpenStreetMap, per la zona visibile sulla mappa."
          }
        }
      }
    },
