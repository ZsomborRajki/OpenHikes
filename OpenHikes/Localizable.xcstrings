    "Hillshaded terrain in natural colors, a softer page for reading the shape of the land." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schattiertes Gelände in natürlichen Farben, eine sanftere Darstellung, um die Form der Landschaft zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relieve sombreado en colores naturales, un mapa más suave para leer la forma del terreno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief ombré aux couleurs naturelles, une carte plus douce pour lire la forme du terrain."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjenčani reljef u prirodnim bojama, blaža podloga za čitanje oblika terena."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilievo ombreggiato in colori naturali, una mappa più delicata per leggere la forma del territorio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terrein met reliëfschaduw in natuurlijke kleuren, een zachter beeld om de vorm van het landschap te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieniowany teren w naturalnych kolorach – łagodniejsza mapa, na której łatwo odczytać ukształtowanie terenu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief umbrit în culori naturale, o hartă mai discretă, potrivită pentru a citi forma terenului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рельеф с отмывкой в естественных цветах — более мягкая карта, на которой легко читается форма местности."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рельєф із відмивкою в природних кольорах — мʼякша карта, на якій добре видно форму місцевості."
          }
        }
      }
    },
    "Hillshaded terrain in natural colors. Routes can be downloaded for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schattiertes Gelände in natürlichen Farben. Routen können für die Offlinenutzung heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relieve sombreado en colores naturales. Las rutas se pueden descargar para usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief ombré aux couleurs naturelles. Les itinéraires peuvent être téléchargés pour une utilisation hors ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjenčani reljef u prirodnim bojama. Rute se mogu preuzeti za izvanmrežnu uporabu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilievo ombreggiato in colori naturali. I percorsi si possono scaricare per l’uso offline."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terrein met reliëfschaduw in natuurlijke kleuren. Routes kunnen worden gedownload voor offline gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieniowany teren w naturalnych kolorach. Trasy można pobrać do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief umbrit în culori naturale. Rutele pot fi descărcate pentru utilizare offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рельеф с отмывкой в естественных цветах. Маршруты можно загрузить для использования офлайн."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рельєф із відмивкою в природних кольорах. Маршрути можна викачати для використання офлайн."
          }
        }
      }
    },
    "Hillshading, contour lines and trail-focused styling, at high resolution." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geländeschattierung, Höhenlinien und eine auf Wege ausgerichtete Gestaltung, in hoher Auflösung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sombreado del relieve, curvas de nivel y un estilo centrado en los senderos, en alta resolución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombrage du relief, courbes de niveau et style axé sur les sentiers, en haute résolution."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjenčanje reljefa, izohipse i stil usmjeren na staze, u visokoj razlučivosti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombreggiatura del rilievo, curve di livello e uno stile pensato per i sentieri, ad alta risoluzione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reliëfschaduw, hoogtelijnen en een stijl gericht op paden, in hoge resolutie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieniowanie rzeźby terenu, poziomice i styl skupiony na szlakach, w wysokiej rozdzielczości."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief umbrit, curbe de nivel și un stil axat pe trasee, la rezoluție înaltă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмывка рельефа, горизонтали и оформление с акцентом на тропы, в высоком разрешении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відмивка рельєфу, горизонталі й оформлення з акцентом на стежки, у високій роздільній здатності."
          }
        }
      }
    },
