    "Paused — checking now and then in case you set off again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert – prüft ab und zu, ob du wieder losgehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa: se comprueba de vez en cuando por si vuelves a ponerte en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause – vérification de temps en temps au cas où vous repartiriez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa – con un controllo di tanto in tanto, nel caso tu riparta."
          }
        }
      }
    },
    "Pauses the hike being recorded, and turns the GPS off until you resume." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert die aufgezeichnete Wanderung und schaltet GPS aus, bis du fortsetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la excursión que se está grabando y apaga el GPS hasta que la reanudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause la randonnée en cours d’enregistrement et désactive le GPS jusqu’à ce que vous la repreniez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa l’escursione in registrazione e spegne il GPS finché non riprendi."
          }
        }
      }
    },
    "Pauses the hike being recorded, from its Lock Screen panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert die aufgezeichnete Wanderung über ihre Anzeige auf dem Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la excursión que se está grabando, desde su panel en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause la randonnée en cours d’enregistrement, depuis son panneau sur l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa l’escursione in registrazione, dal suo pannello nella schermata di blocco."
          }
        }
      }
    },
    "Pausing it could not be saved, so the hike is still under way. Try pausing it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pause konnte nicht gespeichert werden, daher läuft die Wanderung noch. Versuche erneut, sie zu pausieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la pausa, así que la excursión sigue en curso. Intenta pausarla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise en pause n’a pas pu être sauvegardée, la randonnée est donc toujours en cours. Réessayez de la mettre en pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare la pausa, quindi l’escursione è ancora in corso. Prova di nuovo a metterla in pausa."
          }
        }
      }
    },
