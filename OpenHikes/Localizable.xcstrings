    "Hillshaded terrain in natural colors, a softer page for reading the shape of the land." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schattiertes Gelände in natürlichen Farben, eine sanftere Darstellung, um die Form der Landschaft zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relieve sombreado en colores naturales, un mapa más suave para leer la forma del terreno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief ombré aux couleurs naturelles, une carte plus douce pour lire la forme du terrain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilievo ombreggiato in colori naturali, una mappa più delicata per leggere la forma del territorio."
          }
        }
      }
    },
    "Hillshaded terrain in natural colors. Routes can be downloaded for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schattiertes Gelände in natürlichen Farben. Routen können für die Offlinenutzung heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relieve sombreado en colores naturales. Las rutas se pueden descargar para usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relief ombré aux couleurs naturelles. Les itinéraires peuvent être téléchargés pour une utilisation hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilievo ombreggiato in colori naturali. I percorsi si possono scaricare per l’uso offline."
          }
        }
      }
    },
    "Hillshading, contour lines and trail-focused styling, at high resolution." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geländeschattierung, Höhenlinien und eine auf Wege ausgerichtete Gestaltung, in hoher Auflösung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sombreado del relieve, curvas de nivel y un estilo centrado en los senderos, en alta resolución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombrage du relief, courbes de niveau et style axé sur les sentiers, en haute résolution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ombreggiatura del rilievo, curve di livello e uno stile pensato per i sentieri, ad alta risoluzione."
          }
        }
      }
    },
