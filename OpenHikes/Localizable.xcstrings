    "taken on a recorded point of this hike" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "an einem aufgezeichneten Punkt dieser Wanderung aufgenommen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "prise sur un point enregistré de cette randonnée"
          }
        }
      }
    },
    "Taking a break?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machst du eine Pause?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous faites une pause ?"
          }
        }
      }
    },
    "Tap %@ on the map to record a hike, or %@ to draw a trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte auf %1$@, um eine Wanderung aufzuzeichnen, oder auf %2$@, um einen Weg zu zeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap %1$@ on the map to record a hike, or %2$@ to draw a trail."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez %1$@ sur la carte pour enregistrer une randonnée, ou %2$@ pour dessiner un sentier."
          }
        }
      }
    },
    "Tap a photo to see it, and where on the trail it was taken." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Foto, um es zu sehen und zu erfahren, wo auf dem Weg es aufgenommen wurde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une photo pour l’afficher et voir où elle a été prise sur le sentier."
          }
        }
      }
    },
    "Tap the map to add another point, then save again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Karte, um einen weiteren Punkt hinzuzufügen, und speichere dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la carte pour ajouter un autre point, puis enregistrez à nouveau."
          }
        }
      }
    },
    "Tap the Record a hike button on the map to record a hike, or the Make a trail button to draw a trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf der Karte auf die Taste „Wanderung aufzeichnen“, um eine Wanderung aufzuzeichnen, oder auf „Weg erstellen“, um einen Weg zu zeichnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton « Enregistrer une randonnée » sur la carte pour enregistrer une randonnée, ou le bouton « Créer un sentier » pour dessiner un sentier."
          }
        }
      }
    },
    "Tells the reviewer something is wrong with it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilt der prüfenden Person mit, dass etwas nicht stimmt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signale un problème à l’équipe de vérification"
          }
        }
      }
    },
    "Terms & Conditions" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsbedingungen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions générales"
          }
        }
      }
    },
    "Text" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte"
          }
        }
      }
    },
    "Text License" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textlizenz"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence du texte"
          }
        }
      }
    },
    "That hike isn’t paused." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist nicht pausiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée n’est pas en pause."
          }
        }
      }
    },
    "That hike was too short to keep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung war zu kurz, um sie zu behalten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée était trop courte pour être conservée."
          }
        }
      }
    },
    "That place couldn’t be found. Try another search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ort wurde nicht gefunden. Versuche eine andere Suche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lieu est introuvable. Essayez une autre recherche."
          }
        }
      }
    },
    "The %@ license allows %@ of saved maps on this device, shared by %@. Other map styles have no limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lizenz von %1$@ erlaubt %2$@ an gespeicherten Karten auf diesem Gerät, die sich %3$@ teilen. Andere Kartenstile haben kein Limit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ license allows %2$@ of saved maps on this device, shared by %3$@. Other map styles have no limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La licence de %1$@ autorise %2$@ de cartes enregistrées sur cet appareil, à répartir entre %3$@. Les autres styles de carte n’ont aucune limite."
          }
        }
      }
    },
    "The %lld places marked along it go too, each with its name, kind and note." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Der markierte Ort entlang des Weges wird mitgesendet, mit Name, Art und Notiz."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Die %lld markierten Orte entlang des Weges werden mitgesendet, jeweils mit Name, Art und Notiz."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The place marked along it goes too, with its name, kind and note."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The %lld places marked along it go too, each with its name, kind and note."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les %lld lieux marqués le long de l’itinéraire sont aussi envoyés, chacun avec son nom, son type et sa note."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld lieu marqué le long de l’itinéraire est aussi envoyé, avec son nom, son type et sa note."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Les %lld lieux marqués le long de l’itinéraire sont aussi envoyés, chacun avec son nom, son type et sa note."
                }
              }
            }
          }
        }
      }
    },
    "The copy you sent to the community stays where it is; deleting this hike does not withdraw it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie, die du an die Community gesendet hast, bleibt, wo sie ist; das Löschen dieser Wanderung zieht sie nicht zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie envoyée à la communauté reste en place ; supprimer cette randonnée ne la retire pas."
          }
        }
      }
    },
    "The device is warm — recording at ten-meter accuracy until it cools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist warm – Aufzeichnung mit zehn Metern Genauigkeit, bis es abkühlt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil chauffe – enregistrement avec une précision de dix mètres jusqu’à ce qu’il refroidisse."
          }
        }
      }
    },
    "The downloaded trail graph could not be decoded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das geladene Wegenetz konnte nicht dekodiert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réseau de sentiers téléchargé n’a pas pu être décodé."
          }
        }
      }
    },
    "The elevation service answered %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Höhendienst antwortete mit %lld."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service d’altitude a répondu avec le code %lld."
          }
        }
      }
    },
    "The elevation service’s answer was unusable: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Antwort des Höhendienstes war unbrauchbar: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réponse du service d’altitude était inutilisable : %@."
          }
        }
      }
    },
    "the endpoint could not be formed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "der Endpunkt konnte nicht gebildet werden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "l’URL du service n’a pas pu être construite"
          }
        }
      }
    },
    "The file behind this photo is here but couldn’t be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei zu diesem Foto ist vorhanden, konnte aber nicht gelesen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de cette photo est présent, mais n’a pas pu être lu."
          }
        }
      }
    },
    "The file wasn’t changed. Check that the device has storage available, then import it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wurde nicht geändert. Prüfe, ob auf dem Gerät Speicherplatz verfügbar ist, und importiere sie dann erneut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier n’a pas été modifié. Vérifiez que l’appareil dispose d’espace de stockage, puis importez-le à nouveau."
          }
        }
      }
    },
    "The highlighted line follows a mapped trail across the gap." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die hervorgehobene Linie folgt einem kartierten Weg über die Lücke."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ligne en surbrillance suit un sentier cartographié à travers l’interruption."
          }
        }
      }
    },
    "The highlighted section has more than one plausible route." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den hervorgehobenen Abschnitt gibt es mehr als eine plausible Route."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs itinéraires plausibles existent pour la section en surbrillance."
          }
        }
      }
    },
    "The highlighted section was moved onto a mapped trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der hervorgehobene Abschnitt wurde auf einen kartierten Weg verschoben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La section en surbrillance a été déplacée sur un sentier cartographié."
          }
        }
      }
    },
    "The hike could not be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung konnte nicht gespeichert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée n’a pas pu être sauvegardée."
          }
        }
      }
    },
    "The hike itself isn’t reported — only the photo somebody added to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung selbst wird nicht gemeldet – nur das Foto, das jemand hinzugefügt hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée elle-même n’est pas signalée – seulement la photo que quelqu’un y a ajoutée."
          }
        }
      }
    },
    "The hike was published but the listing came back unreadable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung wurde veröffentlicht, aber der Eintrag kam unlesbar zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée a été publiée, mais la fiche renvoyée était illisible."
          }
        }
      }
    },
    "The maker holds one trail at a time, and the one you left half-drawn will be discarded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wegplaner hält jeweils einen Weg, und der halb gezeichnete wird verworfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le créateur de sentiers ne conserve qu’un sentier à la fois ; celui que vous avez laissé à moitié dessiné sera supprimé."
          }
        }
      }
    },
    "The map search service is busy. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kartensuche ist ausgelastet. Versuche es gleich noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de recherche de lieux est saturé. Réessayez dans un instant."
          }
        }
      }
    },
    "The map shows too wide an area to search. Zoom in, then tap Search This Area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte zeigt einen zu großen Bereich für die Suche. Zoome hinein und tippe dann auf „In diesem Bereich suchen“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte affiche une zone trop étendue pour la recherche. Zoomez, puis touchez « Rechercher dans cette zone »."
          }
        }
      }
    },
    "The notes above go with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notizen oben werden mitgesendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes ci-dessus sont aussi envoyées."
          }
        }
      }
    },
    "The paid maps are billed per view. Your subscription covers them, so OpenStreetMap stays free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kostenpflichtigen Karten werden pro Aufruf abgerechnet. Dein Abo deckt sie ab, damit OpenStreetMap kostenlos bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes payantes sont facturées à l’affichage. Votre abonnement les couvre, pour qu’OpenStreetMap reste gratuit."
          }
        }
      }
    },
    "The photo is removed from this hike on all your synced devices. Any copy in OpenHikes on this device is deleted for good." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Foto wird auf all deinen synchronisierten Geräten aus dieser Wanderung entfernt. Jede Kopie in OpenHikes auf diesem Gerät wird endgültig gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La photo est retirée de cette randonnée sur tous vos appareils synchronisés. Toute copie dans OpenHikes sur cet appareil est définitivement supprimée."
          }
        }
      }
    },
    "The photos are deleted for good. The hiker is not told, and their app goes on reading “waiting for review”. The trail itself is not touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos werden endgültig gelöscht. Die Person wird nicht benachrichtigt, und ihre App zeigt weiterhin „Wartet auf Prüfung“. Der Weg selbst bleibt unberührt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont définitivement supprimées. La personne n’est pas avertie, et son app continue d’afficher « En attente de vérification ». Le sentier lui-même n’est pas modifié."
          }
        }
      }
    },
    "The photos are off the hike for everybody, but the copy stored with their submission couldn’t be deleted. %@ To finish, take them down again before leaving this photo — once you leave, the app can’t reach that copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos sind für alle von der Wanderung entfernt, aber die mit ihrer Einreichung gespeicherte Kopie konnte nicht gelöscht werden. %@ Entferne sie zum Abschließen erneut, bevor du dieses Foto verlässt – danach kann die App diese Kopie nicht mehr erreichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont retirées de la randonnée pour tout le monde, mais la copie conservée avec leur soumission n’a pas pu être supprimée. %@ Pour terminer, retirez-les à nouveau avant de quitter cette photo – ensuite, l’app ne pourra plus accéder à cette copie."
          }
        }
      }
    },
    "The photos were published but the record came back unreadable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos wurden veröffentlicht, aber der Eintrag kam unlesbar zurück."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos ont été publiées, mais les données renvoyées étaient illisibles."
          }
        }
      }
    },
    "The published copy stays in the community; deleting this hike does not take it down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die veröffentlichte Kopie bleibt in der Community; das Löschen dieser Wanderung entfernt sie nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie publiée reste dans la communauté ; supprimer cette randonnée ne la retire pas."
          }
        }
      }
    },
    "The recorded hike couldn’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aufgezeichnete Wanderung konnte nicht gespeichert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée enregistrée n’a pas pu être sauvegardée."
          }
        }
      }
    },
    "The recorded track cannot be recovered after it is discarded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aufgezeichnete Track kann nach dem Verwerfen nicht wiederhergestellt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La trace enregistrée ne peut pas être récupérée une fois supprimée."
          }
        }
      }
    },
    "The recording could not be written safely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung konnte nicht sicher geschrieben werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement n’a pas pu être écrit en toute sécurité."
          }
        }
      }
    },
    "The recording has not been finished yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung ist noch nicht abgeschlossen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement n’est pas encore terminé."
          }
        }
      }
    },
    "The recording journal couldn’t be created." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Aufzeichnungsprotokoll konnte nicht erstellt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal d’enregistrement n’a pas pu être créé."
          }
        }
      }
    },
    "The recording journal is closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Aufzeichnungsprotokoll ist geschlossen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal d’enregistrement est fermé."
          }
        }
      }
    },
    "The report reaches the reviewer only once you send it there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Meldung erreicht die prüfende Person erst, wenn du sie dort absendest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le signalement ne parvient à l’équipe de vérification qu’une fois que vous l’avez envoyé depuis votre messagerie."
          }
        }
      }
    },
    "The request reaches the reviewer only once you send it there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anfrage erreicht die prüfende Person erst, wenn du sie dort absendest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande ne parvient à l’équipe de vérification qu’une fois que vous l’avez envoyée depuis votre messagerie."
          }
        }
      }
    },
    "The route and photographs are deleted for good. The hiker is not told, and their app goes on reading “waiting for review”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Route und die Fotos werden endgültig gelöscht. Die Person wird nicht benachrichtigt, und ihre App zeigt weiterhin „Wartet auf Prüfung“."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’itinéraire et les photos sont définitivement supprimés. La personne n’est pas avertie, et son app continue d’afficher « En attente de vérification »."
          }
        }
      }
    },
    "The shared copy shows the route before your edit. Ask for its removal, then share this one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geteilte Kopie zeigt die Route vor deiner Bearbeitung. Fordere ihre Entfernung an und teile dann diese hier."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie partagée montre l’itinéraire avant votre modification. Demandez son retrait, puis partagez la nouvelle version."
          }
        }
      }
    },
    "The system’s built-in map. Uses the least battery and data, but OpenHikes can’t save it for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die integrierte Karte des Systems. Verbraucht am wenigsten Akku und Daten, aber OpenHikes kann sie nicht für die Offlinenutzung speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte intégrée du système. Consomme le moins de batterie et de données, mais OpenHikes ne peut pas l’enregistrer pour une utilisation hors ligne."
          }
        }
      }
    },
    "the trail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "deinem Weg"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "votre sentier"
          }
        }
      }
    },
    "The trail graph cache could not be updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cache des Wegenetzes konnte nicht aktualisiert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache du réseau de sentiers n’a pas pu être mis à jour."
          }
        }
      }
    },
    "Their hikes and photos are hidden on this device only. To have something taken down, report it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderungen und Fotos dieser Person werden nur auf diesem Gerät ausgeblendet. Um etwas entfernen zu lassen, melde es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les randonnées et photos de cette personne sont masquées sur cet appareil uniquement. Pour faire retirer un contenu, signalez-le."
          }
        }
      }
    },
    "Their hikes stop appearing on this device. You can undo this in Settings. Blocking doesn’t report the hike or take it down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderungen dieser Person werden auf diesem Gerät nicht mehr angezeigt. Du kannst das in den Einstellungen rückgängig machen. Blockieren meldet die Wanderung nicht und entfernt sie nicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les randonnées de cette personne n’apparaîtront plus sur cet appareil. Vous pouvez annuler cela dans Réglages. Bloquer ne signale pas la randonnée et ne la retire pas."
          }
        }
      }
    },
    "Their photos stop appearing on any hike, on this device. You can undo this in Settings. Blocking doesn’t report them or take anything down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos dieser Person werden auf diesem Gerät bei keiner Wanderung mehr angezeigt. Du kannst das in den Einstellungen rückgängig machen. Blockieren meldet sie nicht und entfernt nichts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur cet appareil, les photos de cette personne n’apparaîtront plus sur aucune randonnée. Vous pouvez annuler cela dans Réglages. Bloquer ne les signale pas et ne retire rien."
          }
        }
      }
    },
    "Their places are on the map behind this sheet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Orte sind auf der Karte hinter diesem Fenster."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs emplacements figurent sur la carte, derrière cette fenêtre."
          }
        }
      }
    },
    "There are no photos to add." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Fotos zum Hinzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a aucune photo à ajouter."
          }
        }
      }
    },
    "There aren’t any hikes in OpenHikes yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In OpenHikes gibt es noch keine Wanderungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a encore aucune randonnée dans OpenHikes."
          }
        }
      }
    },
    "These are the hikes from the last search that worked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sind die Wanderungen aus der letzten erfolgreichen Suche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici les randonnées de la dernière recherche réussie."
          }
        }
      }
    },
    "They’ll appear on this trail once they’ve been checked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie erscheinen auf diesem Weg, sobald sie geprüft wurden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles apparaîtront sur ce sentier une fois vérifiées."
          }
        }
      }
    },
    "They’re removed for everybody and deleted for good. The hike itself isn’t touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden für alle entfernt und endgültig gelöscht. Die Wanderung selbst bleibt unberührt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles sont retirées pour tout le monde et supprimées définitivement. La randonnée elle-même n’est pas modifiée."
          }
        }
      }
    },
    "This account can’t review submissions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Account kann keine Einreichungen prüfen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte ne peut pas vérifier les soumissions."
          }
        }
      }
    },
    "This also removes it from your other devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird sie auch von deinen anderen Geräten entfernt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sera aussi retirée de vos autres appareils."
          }
        }
      }
    },
    "This build has no elevation key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Build hat keinen Schlüssel für Höhendaten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version ne contient pas de clé d’altitude."
          }
        }
      }
    },
    "This came from a GPX file, which records where a photo was taken but not the photo itself. Its place is on the map." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies stammt aus einer GPX-Datei, die festhält, wo ein Foto aufgenommen wurde, aber nicht das Foto selbst. Seine Stelle ist auf der Karte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci provient d’un fichier GPX, qui indique où une photo a été prise, mais pas la photo elle-même. Son emplacement est indiqué sur la carte."
          }
        }
      }
    },
    "This device’s settings don’t allow iCloud, so hikes stay on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen dieses Geräts erlauben iCloud nicht, daher bleiben Wanderungen auf diesem Gerät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de cet appareil n’autorisent pas iCloud : les randonnées restent donc sur cet appareil."
          }
        }
      }
    },
    "This file couldn’t be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei konnte nicht gelesen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire ce fichier."
          }
        }
      }
    },
    "This GPX file has only one track point." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese GPX-Datei hat nur einen Trackpunkt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier GPX ne contient qu’un seul point de trace."
          }
        }
      }
    },
    "This GPX file holds more than one track." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese GPX-Datei enthält mehr als einen Track."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier GPX contient plus d’une trace."
          }
        }
      }
    },
    "This GPX file is too large to import." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese GPX-Datei ist zu groß zum Importieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier GPX est trop volumineux pour être importé."
          }
        }
      }
    },
    "This hike couldn’t be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung konnte nicht gespeichert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de sauvegarder cette randonnée."
          }
        }
      }
    },
    "This hike has no route to share." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung hat keine Route zum Teilen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée n’a pas d’itinéraire à partager."
          }
        }
      }
    },
    "This hike is already in your list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist bereits in deiner Liste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée figure déjà dans votre liste."
          }
        }
      }
    },
    "This hike is still live, so you can add photos to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist weiterhin sichtbar, daher kannst du Fotos hinzufügen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée est toujours en ligne : vous pouvez donc y ajouter des photos."
          }
        }
      }
    },
    "This hike is too short to share" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist zu kurz zum Teilen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée est trop courte pour être partagée"
          }
        }
      }
    },
    "This hike isn’t available any more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist nicht mehr verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée n’est plus disponible."
          }
        }
      }
    },
    "This hike isn’t in the community list any more. Resetting lets you share it again, but forgets the details needed to ask for its removal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung ist nicht mehr in der Community-Liste. Durch das Zurücksetzen kannst du sie erneut teilen, aber die Angaben für eine Anfrage zur Entfernung gehen verloren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée ne figure plus dans la liste de la communauté. Réinitialiser vous permet de la partager à nouveau, mais efface les informations nécessaires pour demander son retrait."
          }
        }
      }
    },
    "This Hike’s Photos" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos dieser Wanderung"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos de cette randonnée"
          }
        }
      }
    },
    "This hike’s route doesn’t record when each point was reached, so photos can’t be matched to it by time. Hike it with OpenHikes and they can." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Route dieser Wanderung hält nicht fest, wann jeder Punkt erreicht wurde, daher können Fotos ihr nicht nach Zeit zugeordnet werden. Wandere sie mit OpenHikes, dann geht das."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’itinéraire de cette randonnée n’indique pas quand chaque point a été atteint : les photos ne peuvent donc pas y être associées par l’heure. Faites cette randonnée avec OpenHikes et ce sera possible."
          }
        }
      }
    },
    "This is wider than a search reaches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist größer, als eine Suche reicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette zone dépasse la portée d’une recherche."
          }
        }
      }
    },
    "This map source doesn’t allow offline downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kartenquelle erlaubt keine Offline-Downloads."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette source de cartes n’autorise pas les téléchargements hors ligne."
          }
        }
      }
    },
    "This photo couldn’t be opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto konnte nicht geöffnet werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir cette photo."
          }
        }
      }
    },
    "This photo is on the device it was added on. Only where and when it was taken syncs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Foto ist auf dem Gerät, auf dem es hinzugefügt wurde. Nur Ort und Zeit der Aufnahme werden synchronisiert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette photo se trouve sur l’appareil où elle a été ajoutée. Seuls le lieu et l’heure de la prise de vue sont synchronisés."
          }
        }
      }
    },
    "This photograph couldn’t be opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
