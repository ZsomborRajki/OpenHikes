    "%@ — resized before sending, with camera details and original location data removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – vor dem Senden verkleinert, Kameradetails und ursprüngliche Ortsdaten entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con reducción de tamaño antes del envío y sin los datos de la cámara ni la ubicación original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – redimensionnement avant l’envoi, sans les informations de l’appareil photo ni la position d’origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con ridimensionamento prima dell’invio e rimozione dei dati della fotocamera e della posizione originale."
          }
        }
      }
    },
    "%@ — resized before sending, with camera details and original location data removed. Your route, your notes and this hike’s name stay on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – vor dem Senden verkleinert, Kameradetails und ursprüngliche Ortsdaten entfernt. Deine Route, deine Notizen und der Name dieser Wanderung bleiben auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con reducción de tamaño antes del envío y sin los datos de la cámara ni la ubicación original. Tu ruta, tus notas y el nombre de esta excursión se quedan en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – redimensionnement avant l’envoi, sans les informations de l’appareil photo ni la position d’origine. Votre itinéraire, vos notes et le nom de cette randonnée restent sur votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – con ridimensionamento prima dell’invio e rimozione dei dati della fotocamera e della posizione originale. Il percorso, le note e il nome di questa escursione restano sul tuo dispositivo."
          }
        }
      }
    },
