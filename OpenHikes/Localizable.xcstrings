    "Your Own Place" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein eigener Ort"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu propio lugar"
          }
        },
        "fr" : {
          "stringUnit" : {
