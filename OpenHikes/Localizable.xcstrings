    "Satellite imagery with road and place names. Needs a connection, and can’t be saved for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satellitenbilder mit Straßen- und Ortsnamen. Braucht eine Verbindung und kann nicht für die Offlinenutzung gespeichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imágenes por satélite con nombres de carreteras y lugares. Necesita conexión y no se puede guardar para usarse sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagerie satellite avec noms de routes et de lieux. Nécessite une connexion et ne peut pas être enregistrée pour une utilisation hors ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satelitske snimke s nazivima cesta i mjesta. Treba vezu i ne može se spremiti za izvanmrežnu uporabu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagini satellitari con nomi di strade e luoghi. Richiede una connessione e non può essere salvata per l’uso offline."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satellietbeelden met namen van wegen en plaatsen. Vereist een verbinding en kan niet offline worden bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia satelitarne z nazwami dróg i miejsc. Wymagają połączenia i nie można ich zapisać do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagini din satelit cu nume de drumuri și locuri. Necesită o conexiune și nu pot fi salvate pentru utilizare offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спутниковые снимки с названиями дорог и мест. Нужно подключение к сети, сохранить для использования офлайн нельзя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Супутникові знімки з назвами доріг і місць. Потрібне зʼєднання з мережею; зберегти для використання офлайн не можна."
          }
        }
      }
    },
