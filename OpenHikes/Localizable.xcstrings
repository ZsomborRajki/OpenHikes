    "%@ allows %@ of saved maps on this device, and that’s used up. Saving this route deletes about %@ of the saved maps you’ve used least recently. Those hikes keep their routes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erlaubt %2$@ an gespeicherten Karten auf diesem Gerät, und das ist aufgebraucht. Beim Speichern dieser Route werden etwa %3$@ der gespeicherten Karten gelöscht, die du am längsten nicht verwendet hast. Diese Wanderungen behalten ihre Routen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ allows %2$@ of saved maps on this device, and that’s used up. Saving this route deletes about %3$@ of the saved maps you’ve used least recently. Those hikes keep their routes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ autorise %2$@ de cartes enregistrées sur cet appareil, et cette limite est atteinte. Enregistrer cet itinéraire supprimera environ %3$@ des cartes enregistrées que vous avez utilisées le moins récemment. Ces randonnées conservent leurs itinéraires."
          }
        }
      }
    },
    "%@ along the route" : {
      "localizations" : {
