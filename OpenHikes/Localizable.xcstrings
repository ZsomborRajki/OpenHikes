    "Places and photos are hidden and won’t be saved with this trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte und Fotos sind ausgeblendet und werden nicht mit diesem Weg gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares y las fotos están ocultos y no se guardarán con este sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux et les photos sont masqués et ne seront pas enregistrés avec ce sentier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luoghi e foto sono nascosti e non verranno salvati con questo sentiero."
          }
        }
      }
    },
    "Places Around Trail" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte rund um den Weg"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares alrededor del sendero"
          }
        },
