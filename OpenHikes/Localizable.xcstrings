    "Uploaded, but not yet sent for review, so it can’t appear for other hikers. Finish sending it, or ask for it to be taken down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochgeladen, aber noch nicht zur Prüfung gesendet, daher kann sie für andere nicht erscheinen. Schließe das Senden ab oder bitte darum, sie zu entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha subido, pero aún no se ha enviado para revisión, así que no puede aparecer para otras personas. Termina de enviarla o pide que se retire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre randonnée a été transférée, mais pas encore envoyée pour vérification : les autres ne peuvent donc pas la voir. Terminez son envoi ou demandez son retrait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caricata, ma non ancora inviata per la revisione, quindi le altre persone non possono vederla. Completa l’invio, oppure chiedi che venga rimossa."
          }
        }
      }
    },
