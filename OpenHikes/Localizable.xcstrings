            "value" : "Ordine personalizzato"
          }
        }
      }
    },
    "Your own hike, already live for other hikers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine eigene Wanderung, bereits für andere sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu propia excursión, ya publicada para otras personas."
          }
        },
        "fr" : {
          "stringUnit" : {
