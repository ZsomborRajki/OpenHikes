    "Colors the line by how steep it is, uphill or down. Applies to every hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färbt die Linie danach, wie steil sie ist, bergauf oder bergab. Gilt für alle Wanderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorea la línea según su pendiente, de subida o de bajada. Se aplica a todas las excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore la ligne selon sa pente, en montée comme en descente. S’applique à toutes les randonnées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boji liniju prema strmini, uzbrdo ili nizbrdo. Primjenjuje se na svaku turu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora la linea in base alla pendenza, in salita o in discesa. Si applica a tutte le escursioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurt de lijn naar hoe steil hij is, omhoog of omlaag. Geldt voor elke wandeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koloruje linię według nachylenia, pod górę i w dół. Dotyczy każdej wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorează linia după cât de abruptă este, la urcare sau la coborâre. Se aplică tuturor drumețiilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раскрашивает линию по крутизне, на подъеме и на спуске. Применяется ко всем походам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розфарбовує лінію за крутизною вгору чи вниз. Застосовується до всіх походів."
          }
        }
      }
    },
    "Colors the line by its OpenStreetMap difficulty grade. Applies to every hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färbt die Linie nach ihrer OpenStreetMap-Schwierigkeitsstufe. Gilt für alle Wanderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorea la línea según su grado de dificultad de OpenStreetMap. Se aplica a todas las excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colore la ligne selon son niveau de difficulté OpenStreetMap. S’applique à toutes les randonnées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boji liniju prema stupnju težine u OpenStreetMapu. Primjenjuje se na svaku turu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colora la linea in base al grado di difficoltà di OpenStreetMap. Si applica a tutte le escursioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurt de lijn naar de moeilijkheidsgraad in OpenStreetMap. Geldt voor elke wandeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koloruje linię według stopnia trudności z OpenStreetMap. Dotyczy każdej wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colorează linia după gradul de dificultate din OpenStreetMap. Se aplică tuturor drumețiilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раскрашивает линию по категории сложности из OpenStreetMap. Применяется ко всем походам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розфарбовує лінію за категорією складності з OpenStreetMap. Застосовується до всіх походів."
          }
        }
      }
    },
