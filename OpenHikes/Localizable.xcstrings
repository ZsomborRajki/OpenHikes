      }
    },
    "This submission has no creator recorded, so a published listing would be invisible and nobody could block its author. It cannot be published." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Einreichung ist keine erstellende Person vermerkt, daher wäre ein veröffentlichter Eintrag unsichtbar, und niemand könnte die Person blockieren. Sie kann nicht veröffentlicht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette soumission n’indique pas qui l’a créée : sa fiche publiée serait invisible et personne ne pourrait bloquer la personne qui l’a envoyée. Elle ne peut pas être publiée."
          }
        }
      }
    },
    "This submission has no creator recorded, so nobody could block whoever sent it. It cannot be published." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Einreichung ist keine erstellende Person vermerkt, daher könnte niemand blockieren, wer sie gesendet hat. Sie kann nicht veröffentlicht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette soumission n’indique pas qui l’a créée : personne ne pourrait donc bloquer la personne qui l’a envoyée. Elle ne peut pas être publiée."
          }
        }
      }
    },
