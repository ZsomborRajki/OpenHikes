    "Matched by the time and place each photo was taken. Nothing is added until you tap Add." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Zeit und Ort der Aufnahme jedes Fotos zugeordnet. Nichts wird hinzugefügt, bevor du auf „Hinzufügen“ tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asociadas por la hora y el lugar en que se tomó cada foto. No se añade nada hasta que tocas «Añadir»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associées selon l’heure et le lieu de prise de vue de chaque photo. Rien n’est ajouté tant que vous ne touchez pas « Ajouter »."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usklađeno prema vremenu i mjestu snimanja svake fotografije. Ništa se ne dodaje dok ne dodirnete “Dodaj”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbinate in base all’ora e al luogo in cui è stata scattata ciascuna foto. Non viene aggiunto nulla finché non tocchi «Aggiungi»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppeld aan de tijd en plek waarop elke foto is gemaakt. Er wordt niets toegevoegd tot je op ‘Voeg toe’ tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowano według czasu i miejsca zrobienia każdego zdjęcia. Nic nie zostanie dodane, dopóki nie stukniesz „Dodaj”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrivite după ora și locul în care a fost făcută fiecare poză. Nu se adaugă nimic până nu apăsați „Adăugați”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопоставлены по времени и месту съемки каждого фото. Ничего не добавляется, пока вы не коснетесь «Добавить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зіставлено за часом і місцем зйомки кожного фото. Нічого не додається, доки ви не торкнете «Додати»."
          }
        }
      }
    },
