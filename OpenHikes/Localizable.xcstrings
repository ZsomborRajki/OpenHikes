    "iCloud hasn’t finished this yet. It will catch up on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist damit noch nicht fertig und holt das von selbst nach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’a pas encore terminé. La synchronisation se terminera d’elle-même."
          }
        }
      }
    },
    "iCloud hasn’t finished this yet. It will catch up on its own. Last synced %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist damit noch nicht fertig und holt das von selbst nach. Zuletzt synchronisiert: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud n’a pas encore terminé. La synchronisation se terminera d’elle-même. Dernière synchronisation : %@."
          }
        }
      }
    },
    "iCloud Restricted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud eingeschränkt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud restreint"
          }
        }
      }
    },
    "If no message opened — no mail account set up, or you closed the draft — copy this and send it yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich keine Nachricht geöffnet hat – weil kein E-Mail-Account eingerichtet ist oder du den Entwurf geschlossen hast –, kopiere dies und sende es selbst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aucun message ne s’est ouvert – aucun compte de messagerie configuré ou brouillon fermé –, copiez ce texte et envoyez-le vous-même."
          }
        }
      }
    },
