    "If no message opened — no mail account set up, or you closed the draft — copy this and send it yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich keine Nachricht geöffnet hat – weil kein E-Mail-Account eingerichtet ist oder du den Entwurf geschlossen hast –, kopiere dies und sende es selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no se ha abierto ningún mensaje (porque no hay una cuenta de correo configurada o has cerrado el borrador), copia esto y envíalo tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aucun message ne s’est ouvert – aucun compte de messagerie configuré ou brouillon fermé –, copiez ce texte et envoyez-le vous-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non si è aperto nessun messaggio – nessun account di posta configurato, oppure hai chiuso la bozza – copia questo testo e invialo tu."
          }
        }
      }
    },
