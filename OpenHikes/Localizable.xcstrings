    "Topographic hiking map with contour lines and trails. Routes can be downloaded for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topografische Wanderkarte mit Höhenlinien und Wegen. Routen können für die Offlinenutzung heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa topográfico de senderismo con curvas de nivel y senderos. Las rutas se pueden descargar para usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte de randonnée topographique avec courbes de niveau et sentiers. Les itinéraires peuvent être téléchargés pour une utilisation hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa escursionistica topografica con curve di livello e sentieri. I percorsi si possono scaricare per l’uso offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topograficzna mapa turystyczna z poziomicami i szlakami. Trasy można pobrać do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartă topografică pentru drumeții, cu curbe de nivel și trasee. Rutele pot fi descărcate pentru utilizare offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Топографическая туристская карта с горизонталями и тропами. Маршруты можно загрузить для использования офлайн."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Топографічна туристична карта з горизонталями й стежками. Маршрути можна викачати для використання офлайн."
          }
        }
      }
    },
    "Topographic map with sharp close-up detail. Turn on Auto-Save Tiles in Settings to save the tiles you view for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topografische Karte mit scharfen Details aus der Nähe. Aktiviere in den Einstellungen „Kacheln automatisch speichern“, um angesehene Kacheln für die Offlinenutzung zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa topográfico con detalle nítido de cerca. Activa «Guardado automático de teselas» en Ajustes para guardar las teselas que ves y usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte topographique aux détails nets en gros plan. Activez « Enregistrement automatique des tuiles » dans Réglages pour enregistrer les tuiles que vous consultez pour une utilisation hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa topografica con dettagli nitidi da vicino. Attiva «Salvataggio automatico dei tasselli» in Impostazioni per salvare i tasselli che visualizzi per l’uso offline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa topograficzna z ostrymi szczegółami w zbliżeniu. Włącz „Automatyczne zapisywanie kafelków” w ustawieniach, aby zapisywać oglądane kafelki do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartă topografică cu detalii clare la apropiere. Activați „Salvare automată a dalelor” în Configurări pentru a salva dalele vizualizate și a le folosi offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Топографическая карта с четкими деталями вблизи. Включите «Автосохранение тайлов» в настройках, чтобы сохранять просмотренные тайлы для использования офлайн."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Топографічна карта з чіткою деталізацією зблизька. Увімкніть «Автозбереження тайлів» у параметрах, щоб зберігати тайли, які ви переглядаєте, для використання офлайн."
          }
        }
      }
    },
