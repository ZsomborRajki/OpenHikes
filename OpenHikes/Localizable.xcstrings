    "Background App Refresh is off, so the track may be sparse while OpenHikes isn’t open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrundaktualisierung ist deaktiviert, daher kann der Track lückenhaft sein, solange OpenHikes nicht geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actualización en segundo plano está desactivada, así que el track puede tener pocos puntos mientras la app no esté abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’actualisation en arrière-plan est désactivée : la trace risque d’être incomplète tant qu’OpenHikes n’est pas ouvert."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Osvježavanje u pozadini” je isključeno, pa trag može biti rijedak dok OpenHikes nije otvoren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Aggiorna app in background» è disattivato, quindi la traccia potrebbe risultare rada mentre OpenHikes non è aperta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Ververs op achtergrond’ staat uit, dus de track kan onvolledig zijn zolang OpenHikes niet open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odświeżanie w tle jest wyłączone, więc ślad może mieć luki, gdy aplikacja OpenHikes nie jest otwarta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reîmprospătarea în fundal este dezactivată, așa că traseul înregistrat poate avea mai puține puncte cât timp aplicația OpenHikes nu este deschisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Обновление контента» выключено, поэтому в треке могут быть пропуски, пока приложение OpenHikes не открыто."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Фонове оновлювання» вимкнено, тому в треку можуть бути пропуски, поки програма OpenHikes не відкрита."
          }
        }
      }
    },
    "Background App Refresh is off, so this may not update while OpenHikes is closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hintergrundaktualisierung ist deaktiviert, daher wird dies möglicherweise nicht aktualisiert, solange OpenHikes geschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
