        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprende l’escursione in pausa, dal suo pannello nella schermata di blocco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hervat de gepauzeerde wandeling, vanaf het paneel op het toegangsscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wznawia wstrzymaną wędrówkę z jej panelu na ekranie blokady."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuă drumeția suspendată, din panoul de pe ecranul de blocare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возобновляет приостановленный поход с его панели на экране блокировки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поновлює призупинений похід з його панелі на замкненому екрані."
          }
        }
      }
    },
    "Resuming it could not be saved, so the hike is still paused. Try resuming it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fortsetzen konnte nicht gespeichert werden, daher ist die Wanderung noch pausiert. Versuche erneut, sie fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la reanudación, así que la excursión sigue en pausa. Intenta reanudarla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reprise n’a pas pu être enregistrée, la randonnée est donc toujours en pause. Réessayez de la reprendre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavak se nije mogao spremiti, pa je tura još pauzirana. Pokušajte je ponovno nastaviti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare la ripresa, quindi l’escursione è ancora in pausa. Prova di nuovo a riprenderla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hervatten kon niet worden bewaard, dus de wandeling is nog gepauzeerd. Probeer haar opnieuw te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać wznowienia, więc wędrówka jest nadal wstrzymana. Spróbuj wznowić ją ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reluarea nu a putut fi salvată, așa că drumeția este încă suspendată. Încercați din nou s-o continuați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить возобновление, поэтому поход все еще на паузе. Попробуйте возобновить его еще раз."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти стан походу, тому його досі призупинено. Спробуйте поновити його ще раз."
          }
        }
      }
    },
