            "value" : "Vergrößern"
          }
        }
      }
    },
    "Zoom in to look here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoome hinein, um hier zu suchen"
          }
        }
      }
    },
    "Zoom In to Search" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Suchen hineinzoomen"
          }
        }
      }
    },
    "Zoom in to search somewhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoome hinein, um woanders zu suchen."
          }
        }
      }
    },
    "Zoom Out" : {
