    "The trail graph cache could not be updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Cache des Wegenetzes konnte nicht aktualisiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido actualizar la caché de la red de senderos."
          }
        },
        "fr" : {
          "stringUnit" : {
