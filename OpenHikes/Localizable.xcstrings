    "Photos you take on a hike are always kept with the hike. Turn this on to also save a copy to your photo library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, die du auf einer Wanderung aufnimmst, werden immer bei der Wanderung behalten. Aktiviere dies, um zusätzlich eine Kopie in deiner Mediathek zu speichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos que vous prenez pendant une randonnée sont toujours conservées avec celle-ci. Activez cette option pour en enregistrer aussi une copie dans votre photothèque."
          }
        }
      }
    },
    "Photos you take on this hike appear here." : {
      "localizations" : {
