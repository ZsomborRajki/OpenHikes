    "You appear to be offline. Saved hikes and downloaded maps still work." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du scheinst offline zu sein. Gespeicherte Wanderungen und geladene Karten funktionieren weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que no tienes conexión. Las excursiones guardadas y los mapas descargados siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous semblez être hors ligne. Les randonnées enregistrées et les cartes téléchargées restent disponibles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čini se da niste na mreži. Spremljene ture i preuzete karte i dalje rade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che tu sia offline. Le escursioni salvate e le mappe scaricate funzionano comunque."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lijkt offline te zijn. Bewaarde wandelingen en gedownloade kaarten werken nog."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że jesteś offline. Zapisane wędrówki i pobrane mapy nadal działają."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pare că sunteți offline. Drumețiile salvate și hărțile descărcate funcționează în continuare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, вы не в сети. Сохраненные походы и загруженные карты по-прежнему работают."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Схоже, ви не в мережі. Збережені походи й викачані карти працюють і далі."
          }
        }
      }
    },
    "You don’t have to give a reason. It’s your hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst keinen Grund angeben. Es ist deine Wanderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes que dar ningún motivo. Es tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas à donner de raison. C’est votre randonnée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne morate navesti razlog. To je vaša tura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non devi fornire un motivo. È la tua escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft geen reden te geven. Het is jouw wandeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie musisz podawać powodu. To Twoja wędrówka."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu trebuie să precizați un motiv. Este drumeția dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Причину указывать не обязательно. Это ваш поход."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Причину вказувати не обовʼязково. Це ваш похід."
          }
        }
      }
    },
    "You haven’t moved for %@. Pause the recording to keep the stop out of your moving time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dich seit %@ nicht bewegt. Pausiere die Aufzeichnung, damit der Halt nicht in deine Bewegungszeit einfließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te has movido en %@. Pausa la grabación para que el tiempo parado no cuente en tu tiempo en movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas bougé depuis %@. Mettez l’enregistrement en pause pour que cet arrêt ne compte pas dans votre temps en mouvement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niste se pomaknuli već %@. Pauzirajte snimanje kako se stanka ne bi uračunala u vrijeme kretanja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ti muovi da %@. Metti in pausa la registrazione per escludere la sosta dal tempo in movimento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt al %@ niet bewogen. Pauzeer de opname om deze stop buiten je beweegtijd te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoisz w miejscu od %@. Wstrzymaj nagrywanie, aby postój nie wliczał się do czasu w ruchu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu v-ați mișcat de %@. Suspendați înregistrarea pentru ca popasul să nu intre în timpul în mișcare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не двигаетесь уже %@. Приостановите запись, чтобы остановка не засчитывалась как время в движении."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не рухаєтеся вже %@. Призупиніть запис, щоб зупинка не входила в час у русі."
          }
        }
      }
    },
    "You haven’t recorded a hike %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %@ keine Wanderung aufgezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No has grabado ninguna excursión %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez enregistré aucune randonnée %@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niste snimili nijednu turu %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai registrato escursioni %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt %@ geen wandeling opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie nagrano żadnej wędrówki %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ați înregistrat nicio drumeție %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не записали ни одного похода %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви не записали жодного походу %@."
          }
        }
      }
    },
    "You haven’t walked any of your hikes yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist noch keine deiner Wanderungen gegangen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has recorrido ninguna de tus excursiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez encore parcouru aucune de vos randonnées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još niste prošli nijednu svoju turu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora percorso nessuna delle tue escursioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt nog geen van je wandelingen gelopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żadna z Twoich wędrówek nie została jeszcze przebyta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu ați parcurs încă niciuna dintre drumețiile dvs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы еще не прошли ни одного из своих походов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви ще не пройшли жодного зі своїх походів."
          }
        }
      }
    },
    "You saved this from OpenStreetMap, where anyone can already find it. Your own photos can go on the trail that’s already listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dies aus OpenStreetMap gespeichert, wo es bereits alle finden können. Deine eigenen Fotos können zu dem Weg hinzugefügt werden, der schon gelistet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardaste este sendero desde OpenStreetMap, donde cualquiera puede encontrarlo. Puedes añadir tus propias fotos al sendero que ya está en la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez enregistré ce sentier depuis OpenStreetMap, où tout le monde peut déjà le trouver. Vos propres photos peuvent être ajoutées au sentier déjà répertorié."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo ste spremili iz OpenStreetMapa, gdje je svatko već može pronaći. Svoje fotografije možete dodati stazi koja je već na popisu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’hai salvata da OpenStreetMap, dove chiunque può già trovarla. Le tue foto possono andare sul sentiero già presente nell’elenco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt dit uit OpenStreetMap bewaard, waar iedereen het al kan vinden. Je eigen foto’s kunnen wel bij het pad dat al in de lijst staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten szlak pochodzi z OpenStreetMap, gdzie każdy może go już znaleźć. Swoje zdjęcia możesz dodać do szlaku, który jest już na liście."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ați salvat acest traseu din OpenStreetMap, unde oricine îl poate găsi deja. Pozele dvs. pot fi adăugate la traseul care figurează deja în listă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы сохранили эту тропу из OpenStreetMap, где ее и так может найти любой. Свои фото можно добавить к тропе, которая уже есть в списке."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви зберегли цю стежку з OpenStreetMap, де її вже може знайти будь-хто. Свої фото можна додати до стежки, яка вже є в списку."
          }
        }
      }
    },
