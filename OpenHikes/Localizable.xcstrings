    "The commercial maps are billed per view. Your subscription covers them, so OpenStreetMap stays free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die kommerziellen Karten werden pro Aufruf abgerechnet. Dein Abo deckt sie ab, damit OpenStreetMap kostenlos bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mapas comerciales se cobran por visualización. Tu suscripción los cubre, así que OpenStreetMap sigue siendo gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes commerciales sont facturées à l’affichage. Votre abonnement les couvre, pour qu’OpenStreetMap reste gratuit."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komercijalne karte naplaćuju se po prikazu. Vaša ih pretplata pokriva, pa OpenStreetMap ostaje besplatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mappe commerciali vengono fatturate per visualizzazione. Il tuo abbonamento le copre, così OpenStreetMap resta gratuito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor de commerciële kaarten wordt per weergave betaald. Je abonnement dekt ze, zodat OpenStreetMap gratis blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komercyjne mapy są rozliczane za każde wyświetlenie. Twoja subskrypcja pokrywa ten koszt, dzięki czemu mapa OpenStreetMap pozostaje bezpłatna."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hărțile comerciale sunt taxate pentru fiecare afișare. Abonamentul dvs. le acoperă, astfel încât OpenStreetMap rămâne gratuit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коммерческие карты оплачиваются за каждый просмотр. Ваша подписка покрывает эти расходы, поэтому карта OpenStreetMap остается бесплатной."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комерційні карти оплачуються за кожен перегляд. Ваша підписка покриває ці витрати, тож карта OpenStreetMap залишається безплатною."
          }
        }
      }
    },
    "The copy you sent to the community stays where it is; deleting this hike does not withdraw it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie, die du an die Community gesendet hast, bleibt, wo sie ist; das Löschen dieser Wanderung zieht sie nicht zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia que enviaste a la comunidad se queda donde está; eliminar esta excursión no la retira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie envoyée à la communauté reste en place ; supprimer cette randonnée ne la retire pas."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopija koju ste poslali zajednici ostaje gdje jest; brisanjem ove ture ona se ne povlači."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia che hai inviato alla community resta dov’è: eliminare questa escursione non la ritira."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kopie die je naar de community hebt gestuurd, blijft waar ze is; als je deze wandeling verwijdert, wordt ze niet ingetrokken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia wysłana do społeczności pozostaje tam, gdzie jest; usunięcie tej wędrówki jej nie wycofuje."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia trimisă comunității rămâne acolo; ștergerea acestei drumeții nu o retrage."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия, отправленная в сообщество, остается на месте: удаление этого похода ее не отзывает."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копія, яку ви надіслали до спільноти, залишається на місці; видалення цього походу не відкликає її."
          }
        }
      }
    },
    "The device is warm — recording at ten-meter accuracy until it cools." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist warm – Aufzeichnung mit zehn Metern Genauigkeit, bis es abkühlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo está caliente: grabando con una precisión de diez metros hasta que se enfríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil chauffe – enregistrement avec une précision de dix mètres jusqu’à ce qu’il refroidisse."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaj je topao – snimanje s točnošću od deset metara dok se ne ohladi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo è caldo: registrazione con precisione di dieci metri finché non si raffredda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
