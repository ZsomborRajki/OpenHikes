    "Saved %lld of %lld tiles, then reached the %@ %@ allows on this device across all its map styles. Delete another saved map to make room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Kacheln gespeichert, dann wurden die %3$@ erreicht, die %4$@ auf diesem Gerät über alle Kartenstile hinweg erlaubt. Lösche eine andere gespeicherte Karte, um Platz zu schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Saved %1$lld of %2$lld tiles, then reached the %3$@ %4$@ allows on this device across all its map styles. Delete another saved map to make room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han guardado %1$lld de %2$lld teselas y luego se ha alcanzado el límite de %3$@ que %4$@ permite en este dispositivo entre todos sus estilos de mapa. Elimina otro mapa guardado para hacer sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld tuiles sur %2$lld enregistrées, puis la limite de %3$@ autorisée par %4$@ sur cet appareil, tous styles de carte confondus, a été atteinte. Supprimez une autre carte enregistrée pour libérer de l’espace."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno %1$lld od %2$lld pločica, a zatim je dosegnuto %3$@ koliko %4$@ dopušta na ovom uređaju za sve svoje stilove karata. Obrišite drugu spremljenu kartu kako biste oslobodili mjesto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvati %1$lld tasselli su %2$lld, poi è stato raggiunto il limite di %3$@ che %4$@ consente su questo dispositivo per tutti i suoi stili di mappa. Elimina un’altra mappa salvata per fare spazio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld van %2$lld tegels bewaard, en toen was de %3$@ bereikt die %4$@ op dit apparaat toestaat, over al zijn kaartstijlen. Verwijder een andere bewaarde kaart om ruimte te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane kafelki: %1$lld z %2$lld. Osiągnięto limit %3$@, na jaki %4$@ pozwala na tym urządzeniu łącznie dla wszystkich swoich stylów mapy. Usuń inną zapisaną mapę, aby zrobić miejsce."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale salvate: %1$lld din %2$lld. Apoi s-a atins limita de %3$@ pe care %4$@ o permite pe acest dispozitiv pentru toate stilurile sale de hartă. Ștergeți o altă hartă salvată pentru a face loc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено тайлов: %1$lld из %2$lld, после чего достигнут лимит %3$@, который %4$@ разрешает на этом устройстве для всех своих стилей карты. Удалите другую сохраненную карту, чтобы освободить место."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережено тайлів: %1$lld з %2$lld, після чого досягнуто ліміту %3$@, який %4$@ дозволяє на цьому пристрої для всіх своїх стилів карти. Видаліть іншу збережену карту, щоб звільнити місце."
          }
        }
      }
    },
    "Saved %lld of %lld tiles. Try again to finish the download." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Kacheln gespeichert. Versuche es erneut, um den Download abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
