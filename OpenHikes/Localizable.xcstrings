    "Places and photos are hidden and won’t be saved with this trail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte und Fotos sind ausgeblendet und werden nicht mit diesem Weg gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares y las fotos están ocultos y no se guardarán con este sendero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux et les photos sont masqués et ne seront pas enregistrés avec ce sentier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luoghi e foto sono nascosti e non verranno salvati con questo sentiero."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsca i zdjęcia są ukryte i nie zostaną zapisane z tym szlakiem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locurile și pozele sunt ascunse și nu vor fi salvate cu acest traseu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места и фото скрыты и не будут сохранены вместе с этой тропой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Місця й фото приховано, і їх не буде збережено разом із цією стежкою."
          }
        }
      }
    },
