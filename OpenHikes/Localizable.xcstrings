    "Sent. It appears for other hikers once a person has checked it. Opens a request to withdraw it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendet. Sie erscheint für andere, sobald eine Person sie geprüft hat. Öffnet eine Anfrage, um sie zurückzuziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviada. Aparecerá para otras personas cuando alguien la haya revisado. Abre una solicitud para retirarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyée. Elle apparaîtra pour les autres une fois vérifiée par une personne. Ouvre une demande de retrait."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslano. Prikazat će se drugim planinarima nakon što je netko pregleda. Otvara zahtjev za njezino povlačenje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviata. Sarà visibile nella community dopo il controllo di una persona. Apre una richiesta per ritirarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurd. Ze verschijnt voor andere wandelaars zodra iemand haar heeft bekeken. Opent een verzoek om haar in te trekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłano. Wędrówka pojawi się u innych osób, gdy sprawdzi ją człowiek. Otwiera prośbę o jej wycofanie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimisă. Va apărea pentru ceilalți drumeți după ce o persoană o verifică. Deschide o cerere de retragere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено. Поход появится у других туристов, когда его проверит человек. Открывает запрос на его отзыв."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслано. Похід стане видимим іншим туристам, щойно його перевірить людина. Відкриває запит на його відкликання."
          }
        }
      }
    },
    "Sent. They appear on the trail once a person has checked them. Opens a request to withdraw them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendet. Sie erscheinen auf dem Weg, sobald eine Person sie geprüft hat. Öffnet eine Anfrage, um sie zurückzuziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviadas. Aparecerán en el sendero cuando alguien las haya revisado. Abre una solicitud para retirarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyées. Elles apparaîtront sur le sentier une fois vérifiées par une personne. Ouvre une demande de retrait."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslano. Prikazat će se na stazi nakon što ih netko pregleda. Otvara zahtjev za njihovo povlačenje."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviate. Compariranno sul sentiero dopo il controllo di una persona. Apre una richiesta per ritirarle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurd. Ze verschijnen bij het pad zodra iemand ze heeft bekeken. Opent een verzoek om ze in te trekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłano. Zdjęcia pojawią się na szlaku, gdy sprawdzi je człowiek. Otwiera prośbę o ich wycofanie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trimise. Vor apărea pe traseu după ce o persoană le verifică. Deschide o cerere de retragere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено. Фото появятся на тропе, когда их проверит человек. Открывает запрос на их отзыв."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надіслано. Фото зʼявляться на стежці, щойно їх перевірить людина. Відкриває запит на їх відкликання."
          }
        }
      }
    },
