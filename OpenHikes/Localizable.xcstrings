    "Background Trail Tracking needs Always location access to keep your widget and Live Activity updating while OpenHikes is closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wegverfolgung im Hintergrund braucht den Standortzugriff „Immer“, damit dein Widget und deine Live-Aktivität weiter aktualisiert werden, während OpenHikes geschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento del sendero en segundo plano necesita el acceso «Siempre» a la ubicación para que tu widget y tu Actividad en directo sigan actualizándose mientras la app está cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi du sentier en arrière-plan nécessite l’accès à la position « Toujours » pour que votre widget et votre Activité en direct restent à jour lorsque OpenHikes est fermé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praćenje staze u pozadini treba pristup lokaciji “Uvijek” kako bi se widget i Aktivnost uživo ažurirali dok je OpenHikes zatvoren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Monitoraggio del sentiero in background» ha bisogno dell’accesso «Sempre» alla posizione per mantenere aggiornati il widget e l’Attività in tempo reale mentre OpenHikes è chiusa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padvolging op achtergrond heeft locatietoegang ‘Altijd’ nodig om je widget en live activiteit bij te werken terwijl OpenHikes gesloten is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Śledzenie szlaku w tle” wymaga dostępu do położenia „Zawsze”, aby widżet i wydarzenie na żywo aktualizowały się, gdy aplikacja OpenHikes jest zamknięta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urmărirea traseului în fundal necesită accesul la localizare „Întotdeauna” pentru ca widgetul și Activitatea live să se actualizeze în continuare cât timp aplicația OpenHikes este închisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметру «Фоновое отслеживание тропы» нужен доступ к геопозиции «Всегда», чтобы виджет и Эфир активности обновлялись, пока приложение OpenHikes закрыто."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функції «Фонове відстеження стежки» потрібен доступ до геопозиції «Завжди», щоб віджет і Дія наживо оновлювалися, поки програма OpenHikes закрита."
          }
        }
      }
    },
