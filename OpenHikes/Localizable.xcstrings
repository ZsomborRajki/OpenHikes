    "Each track becomes a hike of its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Track wird zu einer eigenen Wanderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada track se convierte en una excursión propia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque trace devient une randonnée distincte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki trag postaje zasebna tura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni traccia diventa un’escursione a sé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke track wordt een eigen wandeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy ślad staje się osobną wędrówką."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare traseu din fișier devine o drumeție separată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый трек становится отдельным походом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен трек стане окремим походом."
          }
        }
      }
    },
    "Each track imports as a hike of its own. Choose at least one to import the file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Track wird als eigene Wanderung importiert. Wähle mindestens einen aus, um die Datei zu importieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada track se importa como una excursión propia. Elige al menos uno para importar el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque trace est importée comme une randonnée distincte. Choisissez-en au moins une pour importer le fichier."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaki se trag uvozi kao zasebna tura. Odaberite barem jedan kako biste uvezli datoteku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni traccia viene importata come un’escursione a sé. Scegline almeno una per importare il file."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke track wordt als eigen wandeling geïmporteerd. Kies er minstens één om het bestand te importeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy ślad jest importowany jako osobna wędrówka. Wybierz co najmniej jeden, aby zaimportować plik."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare traseu din fișier se importă ca drumeție separată. Alegeți cel puțin unul pentru a importa fișierul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый трек импортируется как отдельный поход. Выберите хотя бы один, чтобы импортировать файл."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен трек імпортується як окремий похід. Виберіть принаймні один, щоб імпортувати файл."
          }
        }
      }
    },
