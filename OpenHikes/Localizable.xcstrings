            "value" : "Виділену ділянку перенесено на стежку, нанесену на карту."
          }
        }
      }
    },
    "The hike could not be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung konnte nicht gespeichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar la excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée n’a pas pu être sauvegardée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tura se nije mogla spremiti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare l’escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wandeling kon niet worden bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut salva drumeția."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить поход."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти похід."
          }
        }
      }
    },
    "The hike itself isn’t reported — only the photo somebody added to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung selbst wird nicht gemeldet – nur das Foto, das jemand hinzugefügt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se denuncia la excursión en sí, solo la foto que alguien le añadió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée elle-même n’est pas signalée – seulement la photo que quelqu’un y a ajoutée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne prijavljuje se sama tura – samo fotografija koju joj je netko dodao."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’escursione in sé non viene segnalata – solo la foto che qualcuno vi ha aggiunto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wandeling zelf wordt niet gemeld – alleen de foto die iemand eraan heeft toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama wędrówka nie jest zgłaszana – tylko zdjęcie dodane do niej przez inną osobę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția în sine nu este raportată – doar poza pe care a adăugat-o cineva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалоба подается не на сам поход — только на фото, которое кто-то к нему добавил."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скарга стосується не самого походу — лише фото, доданого до нього іншою людиною."
          }
        }
      }
    },
    "The hike was published but the listing came back unreadable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wanderung wurde veröffentlicht, aber der Eintrag kam unlesbar zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La excursión se ha publicado, pero la ficha devuelta no se puede leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La randonnée a été publiée, mais la fiche renvoyée était illisible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tura je objavljena, ali objava se vratila nečitljiva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’escursione è stata pubblicata, ma la scheda restituita non è leggibile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De wandeling is gepubliceerd, maar de vermelding kwam onleesbaar terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wędrówka została opublikowana, ale zwróconej publikacji nie udało się odczytać."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția a fost publicată, dar fișa returnată nu poate fi citită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поход опубликован, но публикацию из ответа сервера не удалось прочитать."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похід опубліковано, але публікацію з відповіді сервера не вдалося прочитати."
          }
        }
      }
    },
    "The map as openstreetmap.org draws it, to compare with the new one. Turn on Auto-Save Tiles in Settings to save the tiles you view for offline use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte, wie openstreetmap.org sie zeichnet, zum Vergleich mit der neuen. Aktiviere in den Einstellungen „Kacheln automatisch speichern“, um angesehene Kacheln für die Offlinenutzung zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa tal como lo dibuja openstreetmap.org, para compararlo con el nuevo. Activa «Guardado automático de teselas» en Ajustes para guardar las teselas que ves y usarlas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte telle qu’openstreetmap.org la dessine, pour la comparer avec la nouvelle. Activez « Enregistrement automatique des tuiles » dans Réglages pour enregistrer les tuiles que vous consultez pour une utilisation hors ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta kakvu iscrtava openstreetmap.org, za usporedbu s novom. Uključite “Automatski spremaj pločice” u Postavkama kako biste pločice koje pregledavate spremili za izvanmrežnu uporabu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa come la disegna openstreetmap.org, per confrontarla con quella nuova. Attiva «Salvataggio automatico dei tasselli» in Impostazioni per salvare i tasselli che visualizzi per l’uso offline."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart zoals openstreetmap.org hem tekent, om te vergelijken met de nieuwe. Zet ‘Bewaar tegels automatisch’ aan in Instellingen om de tegels die je bekijkt offline te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa w postaci, w jakiej rysuje ją openstreetmap.org, do porównania z nową. Włącz „Automatyczne zapisywanie kafelków” w ustawieniach, aby zapisywać oglądane kafelki do użytku offline."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta așa cum o desenează openstreetmap.org, pentru comparație cu cea nouă. Activați „Salvare automată a dalelor” în Configurări pentru a salva dalele vizualizate și a le folosi offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта в том виде, в каком ее рисует openstreetmap.org, — для сравнения с новой. Включите «Автосохранение тайлов» в настройках, чтобы сохранять просмотренные тайлы для использования офлайн."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта в тому вигляді, у якому її малює openstreetmap.org, — для порівняння з новою. Увімкніть «Автозбереження тайлів» у параметрах, щоб зберігати тайли, які ви переглядаєте, для використання офлайн."
          }
        }
      }
    },
    "The map search service is busy. Try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kartensuche ist ausgelastet. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de búsqueda del mapa está saturado. Vuelve a intentarlo dentro de un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service de recherche de lieux est saturé. Réessayez dans un instant."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usluga pretraživanja karte je zauzeta. Pokušajte ponovno za trenutak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio di ricerca sulla mappa è sovraccarico. Riprova tra poco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaartzoekdienst is bezet. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa wyszukiwania na mapie jest zajęta. Spróbuj ponownie za chwilę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviciul de căutare pe hartă este ocupat. Reîncercați în câteva momente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервис поиска по карте перегружен. Повторите попытку чуть позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервіс пошуку на карті перевантажений. Спробуйте ще раз трохи згодом."
          }
        }
      }
    },
    "The map shows too wide an area to search. Zoom in, then tap Search This Area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte zeigt einen zu großen Bereich für die Suche. Zoome hinein und tippe dann auf „In diesem Bereich suchen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa muestra una zona demasiado amplia para buscar. Acerca la vista y toca «Buscar en esta zona»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte affiche une zone trop étendue pour la recherche. Zoomez, puis touchez « Rechercher dans cette zone »."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta prikazuje preširoko područje za pretraživanje. Povećajte prikaz, a zatim dodirnite “Pretraži ovo područje”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa mostra una zona troppo ampia per la ricerca. Ingrandisci, poi tocca «Cerca in questa zona»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart toont een te groot gebied om te zoeken. Zoom in en tik dan op ‘Zoek in dit gebied’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa pokazuje zbyt duży obszar, aby go przeszukać. Przybliż ją, a potem stuknij „Szukaj tutaj”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta arată o zonă prea mare pentru căutare. Măriți harta, apoi apăsați pe „Căutați în această zonă”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карте слишком большая область для поиска. Увеличьте масштаб и коснитесь «Искать здесь»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На карті надто велика область для пошуку. Наблизьте карту, а потім торкніть «Шукати тут»."
          }
        }
      }
    },
    "The notes above go with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notizen oben werden mitgesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas de arriba también se envían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes ci-dessus sont aussi envoyées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilješke iznad idu uz nju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono inviate anche le note qui sopra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De notities hierboven gaan mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatki powyżej są wysyłane razem z nią."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se trimit și notițele de mai sus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заметки выше отправляются вместе с ним."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нотатки вище надсилаються разом із ним."
          }
        }
      }
    },
    "The OpenHikes map draws a downloaded country with no signal, and Community finds its OpenStreetMap trails. Downloads use Wi-Fi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die OpenHikes-Karte zeigt ein heruntergeladenes Land auch ohne Empfang, und die Community findet seine Wege aus OpenStreetMap. Downloads laufen über WLAN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mapa de OpenHikes muestra un país descargado aunque no haya cobertura, y «Comunidad» encuentra sus senderos de OpenStreetMap. Las descargas usan la red Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte OpenHikes affiche un pays téléchargé même sans réseau, et l’onglet « Communauté » y trouve les sentiers OpenStreetMap. Les téléchargements passent par le Wi-Fi."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes karta prikazuje preuzetu zemlju bez signala, a Zajednica pronalazi njezine staze iz OpenStreetMapa. Preuzimanja koriste Wi‑Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mappa OpenHikes mostra un paese scaricato anche senza segnale, e la Community ne trova i sentieri di OpenStreetMap. I download usano il Wi-Fi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De OpenHikes-kaart toont een gedownload land zonder bereik, en Community vindt de paden uit OpenStreetMap daar. Downloads gebruiken wifi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa OpenHikes pokazuje pobrany kraj także bez zasięgu, a Społeczność znajduje w nim szlaki z OpenStreetMap. Pobieranie odbywa się przez Wi-Fi."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harta OpenHikes afișează și fără semnal o țară descărcată, iar Comunitatea îi găsește traseele OpenStreetMap. Descărcările folosesc Wi‑Fi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта OpenHikes показывает загруженную страну даже без сигнала, а «Сообщество» находит в ней тропы OpenStreetMap. Загрузка идет по Wi-Fi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта OpenHikes показує викачану країну навіть без сигналу, а «Спільнота» знаходить у ній стежки OpenStreetMap. Викачування відбувається через Wi-Fi."
          }
        }
      }
    },
