    "Save the viewpoint, shelter or water you’re standing at, and add photos to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere den Aussichtspunkt, die Schutzhütte oder die Wasserstelle, an der du stehst, und füge Fotos hinzu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez le point de vue, l’abri ou le point d’eau où vous vous trouvez, et ajoutez-y des photos."
          }
