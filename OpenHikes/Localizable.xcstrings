    "Add photos you took yourself, on this trail. A photo taken at your front door shows where you live." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Fotos hinzu, die du selbst auf diesem Weg aufgenommen hast. Ein Foto vor deiner Haustür zeigt, wo du wohnst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade fotos que hayas tomado tú en este sendero. Una foto tomada en la puerta de tu casa muestra dónde vives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des photos que vous avez prises vous-même sur ce sentier. Une photo prise devant chez vous montre où vous habitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi foto scattate da te, su questo sentiero. Una foto scattata davanti alla porta di casa mostra dove abiti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj własne zdjęcia zrobione na tym szlaku. Zdjęcie zrobione pod drzwiami Twojego domu pokazuje, gdzie mieszkasz."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adăugați poze făcute chiar de dvs., pe acest traseu. O poză făcută la ușa casei arată unde locuiți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте фото, которые вы сами сняли на этой тропе. Фото, снятое у вашего порога, показывает, где вы живете."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додавайте фото, які ви самі зняли на цій стежці. Фото, зняте біля ваших дверей, показує, де ви живете."
          }
        }
      }
    },
