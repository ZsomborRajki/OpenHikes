    "Every community hike is checked by a person before anyone else can see it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Community-Wanderung wird von einer Person geprüft, bevor andere sie sehen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona revisa cada excursión de la comunidad antes de que nadie más pueda verla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque randonnée de la communauté est vérifiée par une personne avant d’être visible par d’autres."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaku turu zajednice pregleda osoba prije nego što je drugi mogu vidjeti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni escursione della community viene controllata da una persona prima di diventare visibile."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke communitywandeling wordt door iemand bekeken voordat anderen haar kunnen zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdą wędrówkę w społeczności sprawdza człowiek, zanim zobaczy ją ktokolwiek inny."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare drumeție din comunitate este verificată de o persoană înainte de a deveni vizibilă pentru alții."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый поход в сообществе проверяет человек, прежде чем его увидит кто-то еще."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен похід у спільноті перевіряє людина, перш ніж його побачить хтось інший."
          }
        }
      }
    },
    "Every hike is drawn in its own route color." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Wanderung wird in ihrer eigenen Routenfarbe gezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada excursión se dibuja con su propio color de ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque randonnée est tracée dans sa propre couleur d’itinéraire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka se tura iscrtava vlastitom bojom rute."
          }
        },
        "it" : {
          "stringUnit" : {
