    "Pick a shorter stretch, or undo an earlier change first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein kürzeres Teilstück oder mache zuerst eine frühere Änderung rückgängig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un trecho más corto o deshaz antes un cambio anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un tronçon plus court, ou annulez d’abord une modification précédente."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
