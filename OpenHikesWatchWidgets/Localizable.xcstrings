    "Resumes the paused hike, from its Lock Screen panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt die pausierte Wanderung über ihre Anzeige auf dem Sperrbildschirm fort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanuda la excursión en pausa, desde su panel en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprend la randonnée en pause, depuis son panneau sur l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprende l’escursione in pausa, dal suo pannello nella schermata di blocco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возобновляет приостановленный поход с его панели на экране блокировки."
          }
        }
      }
    },
    "Shows a trail you choose, or your selected trail, or a hike currently being recorded." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt einen Weg deiner Wahl, deinen ausgewählten Weg oder eine Wanderung, die gerade aufgezeichnet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un sendero que elijas, el sendero seleccionado o una excursión que se esté grabando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche un sentier de votre choix, le sentier sélectionné ou une randonnée en cours d’enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra un sentiero a tua scelta, il sentiero selezionato o un’escursione in fase di registrazione."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает тропу на ваш выбор, выбранную в приложении тропу или поход, который сейчас записывается."
          }
        }
      }
    },
    "Start a recording, or see the one under way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine Aufzeichnung oder sieh dir die laufende an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una grabación o consulta la que está en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez un enregistrement ou consultez celui en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia una registrazione o guarda quella in corso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните запись или посмотрите ту, что уже идет."
          }
        }
