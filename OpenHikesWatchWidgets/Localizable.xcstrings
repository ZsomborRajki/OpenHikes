    "OpenHikes needs your location before it can record a hike." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht deinen Standort, bevor es eine Wanderung aufzeichnen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita tu ubicación para poder grabar una excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin de votre position avant de pouvoir enregistrer une randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno della tua posizione per poter registrare un’escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes heeft je locatie nodig voordat het een wandeling kan opnemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes potrzebuje Twojego położenia, zanim będzie można nagrać wędrówkę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes are nevoie de localizarea dvs. pentru a putea înregistra o drumeție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы записать поход, приложению OpenHikes нужна ваша геопозиция."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб записати похід, програмі OpenHikes потрібна ваша геопозиція."
          }
        }
      }
    },
