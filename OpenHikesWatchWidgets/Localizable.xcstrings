    "Pauses the hike being recorded, from its Lock Screen panel." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert die aufgezeichnete Wanderung über ihre Anzeige auf dem Sperrbildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa la excursión que se está grabando, desde su panel en la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause la randonnée en cours d’enregistrement, depuis son panneau sur l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa l’escursione in registrazione, dal suo pannello nella schermata di blocco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeert de wandeling die wordt opgenomen, vanaf het paneel op het toegangsscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuje nagrywaną wędrówkę z jej panelu na ekranie blokady."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendă drumeția în curs de înregistrare, din panoul de pe ecranul de blocare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостанавливает запись похода с ее панели на экране блокировки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Призупиняє запис походу з його панелі на замкненому екрані."
          }
        }
      }
    },
