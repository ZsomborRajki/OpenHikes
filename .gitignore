# Secrets — bundled API keys, never commit the real one.
# Copy Secrets.example.plist to OpenHikes/Secrets.plist and fill in your key.
**/Secrets.plist

# Xcode user-specific state
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Build products
build/
DerivedData/
violations.txt
*.xcarchive
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/

# sourcekit-lsp's build-server binding, written by `xcode-build-server config`.
# It records absolute DerivedData and workspace paths, so it is per-machine and
# has to be regenerated locally rather than shared. See README.md.
buildServer.json

# macOS
.DS_Store

# Performance runs — Scripts/run-performance-tests.sh writes measured output here.
PerformanceReports/

# Test result bundles — CI writes one here, and so does anyone running the
# same `xcodebuild ... -resultBundlePath` command locally.
TestResults/

# Python bytecode — `python3 -m py_compile` and the unittest run under
# `Scripts/tests/` both write it beside the source.
__pycache__/
