        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno della tua posizione per poter registrare un’escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes heeft je locatie nodig voordat het een wandeling kan opnemen."
