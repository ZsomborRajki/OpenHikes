{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes"
          }
        }
      },
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikesWatch"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes liest deine Herzfrequenz aus Health, während du eine Wanderung aufzeichnest, damit die Watch sie beim Wandern anzeigen kann. Sonst wird nichts aus Health gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes reads your heart rate from Health while you are recording a hike, so the watch can show it as you hike. Nothing else in Health is read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes lee tu frecuencia cardiaca de Salud mientras grabas una excursión, para que el reloj pueda mostrarla mientras caminas. No lee nada más de Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes lit votre fréquence cardiaque dans Santé pendant que vous enregistrez une randonnée, pour que la montre puisse l’afficher pendant que vous marchez. Rien d’autre n’est lu dans Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes legge la tua frequenza cardiaca da Salute mentre registri un’escursione, così l’orologio può mostrarla mentre cammini. Nient’altro viene letto da Salute."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes odczytuje Twoje tętno z aplikacji Zdrowie, gdy nagrywasz wędrówkę, aby zegarek mógł je pokazywać w trakcie marszu. Nic innego z aplikacji Zdrowie nie jest odczytywane."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes citește ritmul cardiac din Sănătate cât timp înregistrați o drumeție, pentru ca ceasul să vi-l arate pe parcurs. Nimic altceva din Sănătate nu este citit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes читает ваш пульс из приложения «Здоровье», пока вы записываете поход, чтобы часы показывали его в пути. Больше ничего из приложения «Здоровье» не читается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes зчитує ваш серцевий ритм зі Здоровʼя, поки ви записуєте похід, щоб годинник показував його в дорозі. Нічого іншого зі Здоровʼя не зчитується."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes startet ein Wandertraining in Health, während du auf deiner Watch aufzeichnest – nur so läuft die Aufzeichnung bei ausgeschaltetem Bildschirm weiter. Das Training selbst wird nicht gespeichert – dein iPhone speichert die abgeschlossene Wanderung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes starts a hiking workout in Health while you record on your watch, which is what keeps the recording running with the screen off. The workout itself is not saved — your iPhone saves the finished hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes inicia un entrenamiento de senderismo en Salud mientras grabas en el reloj, que es lo que mantiene la grabación en marcha con la pantalla apagada. El entrenamiento en sí no se guarda: tu iPhone guarda la excursión terminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes démarre un entraînement de randonnée dans Santé pendant que vous enregistrez sur votre montre : c’est ce qui maintient l’enregistrement actif écran éteint. L’entraînement lui-même n’est pas sauvegardé – c’est votre iPhone qui sauvegarde la randonnée terminée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes avvia un allenamento di escursionismo in Salute mentre registri sull’orologio: è questo che mantiene attiva la registrazione a schermo spento. L’allenamento in sé non viene salvato – è il tuo iPhone a salvare l’escursione terminata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy nagrywasz na zegarku, OpenHikes rozpoczyna w aplikacji Zdrowie trening typu Wędrówka, bo to on podtrzymuje nagrywanie przy wyłączonym ekranie. Sam trening nie jest zapisywany – ukończoną wędrówkę zapisuje Twój iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes începe un exercițiu de drumeție în Sănătate cât timp înregistrați pe ceas, iar acesta menține înregistrarea activă cu ecranul stins. Exercițiul în sine nu este salvat – iPhone‑ul salvează drumeția încheiată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока вы записываете поход на часах, OpenHikes запускает в приложении «Здоровье» тренировку «Пеший туризм»: благодаря ей запись продолжается при выключенном экране. Сама тренировка не сохраняется — завершенный поход сохраняет ваш iPhone."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поки ви записуєте похід на годиннику, OpenHikes запускає у Здоровʼї тренування «Піший туризм»: завдяки йому запис триває при вимкненому екрані. Саме тренування не зберігається — завершений похід зберігає ваш iPhone."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet deinen Standort, um zu zeigen, wo du dich auf dem Weg befindest, dem du folgst, und um deine Wanderung aufzuzeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses your location to show where you are on the trail you are following, and to record your hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa tu ubicación para mostrar dónde estás en el sendero que sigues y para grabar tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise votre position pour indiquer où vous êtes sur le sentier que vous suivez, et pour enregistrer votre randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa la tua posizione per mostrarti dove ti trovi sul sentiero che stai seguendo e per registrare la tua escursione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes używa Twojego położenia, aby pokazywać, gdzie jesteś na szlaku, którym idziesz, i nagrywać Twoją wędrówkę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes folosește localizarea dvs. pentru a arăta unde vă aflați pe traseul pe care îl urmați și pentru a înregistra drumeția."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes использует вашу геопозицию, чтобы показывать, где вы находитесь на тропе, по которой идете, и записывать ваш поход."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes використовує вашу геопозицію, щоб показувати, де ви перебуваєте на стежці, якою йдете, і записувати ваш похід."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet die Bewegungssensoren, um die auf deiner Wanderung aufgezeichnete Höhe zu verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses motion sensors to improve the elevation recorded on your hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa los sensores de movimiento para mejorar la altitud grabada en tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise les capteurs de mouvement pour améliorer l’altitude enregistrée pendant votre randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa i sensori di movimento per migliorare l’altitudine registrata durante l’escursione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes używa czujników ruchu, aby poprawiać wysokość nagraną podczas wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes folosește senzorii de mișcare pentru a îmbunătăți altitudinea înregistrată în timpul drumeției."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes использует датчики движения, чтобы уточнять высоту, записанную в походе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes використовує датчики руху, щоб уточнювати висоту, записану під час походу."
          }
        }
      }
    }
  },
  "version" : "1.0"
}