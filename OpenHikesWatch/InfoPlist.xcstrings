{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes"
          }
        }
      },
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikesWatch"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes liest deine Herzfrequenz aus Health, während du eine Wanderung aufzeichnest, damit die Watch sie beim Wandern anzeigen kann. Sonst wird nichts aus Health gelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes reads your heart rate from Health while you are recording a hike, so the watch can show it as you hike. Nothing else in Health is read."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes lee tu frecuencia cardiaca de Salud mientras grabas una excursión, para que el reloj pueda mostrarla mientras caminas. No lee nada más de Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes lit votre fréquence cardiaque dans Santé pendant que vous enregistrez une randonnée, pour que la montre puisse l’afficher pendant que vous marchez. Rien d’autre n’est lu dans Santé."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes startet ein Wandertraining in Health, während du auf deiner Watch aufzeichnest – nur so läuft die Aufzeichnung bei ausgeschaltetem Bildschirm weiter. Das Training selbst wird nicht gespeichert – dein iPhone speichert die abgeschlossene Wanderung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes starts a hiking workout in Health while you record on your watch, which is what keeps the recording running with the screen off. The workout itself is not saved — your iPhone saves the finished hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes inicia un entrenamiento de senderismo en Salud mientras grabas en el reloj, que es lo que mantiene la grabación en marcha con la pantalla apagada. El entrenamiento en sí no se guarda: tu iPhone guarda la excursión terminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes démarre un entraînement de randonnée dans Santé pendant que vous enregistrez sur votre montre : c’est ce qui maintient l’enregistrement actif écran éteint. L’entraînement lui-même n’est pas sauvegardé – c’est votre iPhone qui sauvegarde la randonnée terminée."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet deinen Standort, um zu zeigen, wo du dich auf dem Weg befindest, dem du folgst, und um deine Wanderung aufzuzeichnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses your location to show where you are on the trail you are following, and to record your hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa tu ubicación para mostrar dónde estás en el sendero que sigues y para grabar tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise votre position pour indiquer où vous êtes sur le sentier que vous suivez, et pour enregistrer votre randonnée."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes verwendet die Bewegungssensoren, um die auf deiner Wanderung aufgezeichnete Höhe zu verbessern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "OpenHikes uses motion sensors to improve the elevation recorded on your hike."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes usa los sensores de movimiento para mejorar la altitud grabada en tu excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes utilise les capteurs de mouvement pour améliorer l’altitude enregistrée pendant votre randonnée."
          }
        }
      }
    }
  },
  "version" : "1.0"
}