    "OpenHikes needs location access to record a hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht Standortzugriff, um eine Wanderung aufzuzeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita acceso a la ubicación para grabar una excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin d’accéder à votre position pour enregistrer une randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno dell’accesso alla posizione per registrare un’escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes heeft locatietoegang nodig om een wandeling op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes potrzebuje dostępu do położenia, aby nagrać wędrówkę."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesită acces la localizare pentru a înregistra o drumeție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы записать поход, приложению OpenHikes нужен доступ к геопозиции."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб записати похід, програмі OpenHikes потрібен доступ до геопозиції."
          }
        }
      }
    },
    "OpenHikes needs permission to start a workout, which is what keeps a recording running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes braucht die Erlaubnis, ein Training zu starten – nur so läuft eine Aufzeichnung weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesita permiso para iniciar un entrenamiento, que es lo que mantiene la grabación en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes a besoin de votre autorisation pour démarrer un entraînement, ce qui permet à l’enregistrement de continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes ha bisogno dell’autorizzazione ad avviare un allenamento: è ciò che mantiene attiva la registrazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes heeft toestemming nodig om een work-out te starten, want die houdt een opname draaiende."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes potrzebuje pozwolenia na rozpoczęcie treningu, bo to on podtrzymuje nagrywanie."
