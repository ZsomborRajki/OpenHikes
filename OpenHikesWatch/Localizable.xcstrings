    "Bring your iPhone nearby, with OpenHikes installed, to send your trails over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring dein iPhone mit installiertem OpenHikes in die Nähe, um deine Wege zu übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca tu iPhone, con OpenHikes instalado, para pasar tus senderos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approchez votre iPhone, avec OpenHikes installé, pour transférer vos sentiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvicina il tuo iPhone, con l’app OpenHikes installata, per trasferire i tuoi sentieri."
          }
        },
        "nl" : {
