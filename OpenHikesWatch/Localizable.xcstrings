        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На часах закончилось место. Освободите его и повторите попытку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На годиннику закінчилося місце. Звільніть трохи місця й спробуйте ще раз."
          }
        }
