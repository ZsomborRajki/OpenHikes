    "Paused. The ground you cover now isn’t part of the hike." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert. Die Strecke, die du jetzt zurücklegst, gehört nicht zur Wanderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa. Lo que recorras ahora no cuenta para la excursión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pause. La distance que vous parcourez maintenant ne compte pas dans la randonnée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In pausa. La strada che fai ora non fa parte dell’escursione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gepauzeerd. De afstand die je nu aflegt, hoort niet bij de wandeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymano. Droga, którą teraz pokonujesz, nie jest częścią wędrówki."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrare suspendată. Ce parcurgeți acum nu intră în drumeție."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На паузе. Путь, который вы проходите сейчас, в поход не войдет."
