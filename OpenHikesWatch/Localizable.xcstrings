          }
        }
      }
    },
    "Install OpenHikes on the iPhone paired with this watch to send trails across." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere OpenHikes auf dem iPhone, das mit dieser Watch gekoppelt ist, um Wege zu übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
