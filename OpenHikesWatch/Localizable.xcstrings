    "That hike was too short to keep." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Wanderung war zu kurz, um sie zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa excursión era demasiado corta para conservarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette randonnée était trop courte pour être conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell’escursione era troppo breve per essere conservata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wandeling was te kort om te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wędrówka była zbyt krótka, aby ją zachować."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeția a fost prea scurtă pentru a fi păstrată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот поход слишком короткий, чтобы его сохранять."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей похід закороткий, щоб його зберегти."
          }
        }
      }
    },
    "This watch can’t read the interrupted hike right now. Try again, or discard it to record a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Watch kann die unterbrochene Wanderung gerade nicht lesen. Versuche es erneut oder verwirf sie, um eine neue aufzuzeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este reloj no puede leer la excursión interrumpida en este momento. Inténtalo de nuevo o descártala para grabar una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette montre ne peut pas lire la randonnée interrompue pour le moment. Réessayez, ou supprimez-la pour en enregistrer une nouvelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo orologio non riesce a leggere l’escursione interrotta in questo momento. Riprova, oppure scartala per registrarne una nuova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit horloge kan de onderbroken wandeling nu niet lezen. Probeer het opnieuw, of verwijder haar om een nieuwe op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten zegarek nie może teraz odczytać przerwanej wędrówki. Spróbuj ponownie lub odrzuć ją, aby nagrać nową."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest ceas nu poate citi acum drumeția întreruptă. Reîncercați sau abandonați-o pentru a înregistra una nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы сейчас не могут прочитать прерванный поход. Повторите попытку или удалите его, чтобы записать новый."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годинник зараз не може прочитати перерваний похід. Спробуйте ще раз або видаліть його, щоб записати новий."
          }
        }
      }
    },
    "This watch can’t start a workout, so a recording couldn’t stay running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Watch kann kein Training starten, daher könnte eine Aufzeichnung nicht weiterlaufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este reloj no puede iniciar un entrenamiento, así que la grabación no podría seguir en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette montre ne peut pas démarrer d’entraînement : un enregistrement ne pourrait donc pas continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo orologio non può avviare un allenamento, quindi la registrazione non potrebbe restare attiva."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit horloge kan geen work-out starten, dus een opname zou niet kunnen blijven lopen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten zegarek nie może rozpocząć treningu, więc nagrywanie nie mogłoby trwać."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest ceas nu poate începe un exercițiu, deci înregistrarea nu ar putea continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти часы не могут начать тренировку, поэтому запись прервалась бы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей годинник не може почати тренування, тож запис не зміг би тривати."
          }
        }
      }
    },
    "This watch couldn’t discard the hike. Try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Watch konnte die Wanderung nicht verwerfen. Versuche es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este reloj no ha podido descartar la excursión. Inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette montre n’a pas pu supprimer la randonnée. Réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo orologio non è riuscito a scartare l’escursione. Riprova più tardi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit horloge kon de wandeling niet verwijderen. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten zegarek nie mógł odrzucić wędrówki. Spróbuj ponownie później."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest ceas nu a putut abandona drumeția. Reîncercați mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часам не удалось удалить поход. Повторите попытку позже."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Годиннику не вдалося видалити похід. Спробуйте ще раз пізніше."
          }
        }
      }
    },
    "This watch is out of storage. Free up some space, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicher dieser Watch ist voll. Gib etwas Speicherplatz frei und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este reloj no tiene espacio. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage de cette montre est saturé. Libérez de l’espace, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio su questo orologio è esaurito. Libera dello spazio, poi riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opslag van dit horloge is vol. Maak wat ruimte vrij en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym zegarku zabrakło miejsca. Zwolnij trochę miejsca i spróbuj ponownie."
          }
