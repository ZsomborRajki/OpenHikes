    "A hike was interrupted — see Record" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Wanderung wurde unterbrochen – siehe „Aufzeichnen“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excursión interrumpida – ve a «Grabar»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randonnée interrompue – voir « Enregistrer »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escursione interrotta – vai a «Registra»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wandeling is onderbroken – zie ‘Neem op’"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wędrówka została przerwana – zobacz „Nagrywanie”"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drumeție întreruptă – vedeți „Înregistrare”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поход прерван — см. «Запись»"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похід перервано — див. «Запис»"
          }
        }
      }
    },
    "A workout couldn’t be started, so a recording wouldn’t survive the screen going dark." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Training konnte nicht gestartet werden, daher würde eine Aufzeichnung das Ausschalten des Bildschirms nicht überstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido iniciar un entrenamiento, así que la grabación se detendría al apagarse la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de démarrer un entraînement : un enregistrement ne survivrait pas à la mise en veille de l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile avviare un allenamento: la registrazione non continuerebbe a schermo spento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kon geen work-out worden gestart, dus een opname zou het uitgaan van het scherm niet overleven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się rozpocząć treningu, więc nagrywanie nie przetrwałoby wygaszenia ekranu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu s-a putut începe un exercițiu, deci înregistrarea nu ar continua cu ecranul stins."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось начать тренировку, а без нее запись прервется, когда погаснет экран."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося почати тренування, а без нього запис перерветься, коли згасне екран."
          }
        }
      }
    },
    "Asking your iPhone for your trails…" : {
