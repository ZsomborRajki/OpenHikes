        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenHikes necesită permisiunea de a începe un exercițiu, ceea ce menține înregistrarea activă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению OpenHikes нужно разрешение начинать тренировку: благодаря ей запись не прерывается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програмі OpenHikes потрібен дозвіл починати тренування: завдяки йому запис не переривається."
