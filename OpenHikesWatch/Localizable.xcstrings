    },
    "It hasn’t been saved anywhere, so it can’t be recovered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wurde nirgends gespeichert und kann daher nicht wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha guardado en ningún sitio, así que no se puede recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
