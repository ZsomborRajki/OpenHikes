    "Recording stopped at %@. Everything before then is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufzeichnung um %@ beendet. Alles davor bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo a las %@. Se conserva todo lo anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrement arrêté à %@. Tout ce qui précède est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrazione interrotta alle %@. Tutto ciò che precede è stato conservato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opname gestopt om %@. Alles daarvoor blijft bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie zatrzymało się o %@. Wszystko sprzed tej chwili zostało zachowane."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrarea s-a oprit la %@. Tot ce era înainte se păstrează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановилась в %@. Все, что было до этого, сохранено."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запис зупинився о %@. Усе, що було до цього, збережено."
          }
        }
      }
    },
    "Records on this watch, with or without your iPhone. The hike goes to your iPhone when it’s back in range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeichnet auf dieser Watch auf, mit oder ohne dein iPhone. Die Wanderung geht an dein iPhone, sobald es wieder in Reichweite ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba en este reloj, con o sin tu iPhone. La excursión pasa a tu iPhone cuando vuelve a estar al alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre sur cette montre, avec ou sans votre iPhone. La randonnée est envoyée à votre iPhone dès qu’il est de nouveau à portée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra su questo orologio, con o senza iPhone. L’escursione passa all’iPhone quando torna a portata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neemt op met dit horloge, met of zonder je iPhone. De wandeling gaat naar je iPhone zodra die weer binnen bereik is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywa na tym zegarku, z iPhone’em lub bez niego. Wędrówka trafi na iPhone’a, gdy znów będzie w zasięgu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrează pe acest ceas, cu sau fără iPhone. Drumeția ajunge pe iPhone când acesta revine în raza de acțiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись ведется на этих часах, с iPhone или без него. Поход перейдет на iPhone, когда тот снова окажется рядом."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запис ведеться на цьому годиннику, з iPhone або без нього. Похід буде передано на iPhone, щойно той знову буде в полі дії."
          }
        }
      }
    },
