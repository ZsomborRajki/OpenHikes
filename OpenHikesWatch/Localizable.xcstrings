    "This watch can’t start a workout, so a recording couldn’t stay running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Watch kann kein Training starten, daher könnte eine Aufzeichnung nicht weiterlaufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este reloj no puede iniciar un entrenamiento, así que la grabación no podría seguir en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette montre ne peut pas démarrer d’entraînement : un enregistrement ne pourrait donc pas continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo orologio non può avviare un allenamento, quindi la registrazione non potrebbe restare attiva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти часы не могут начать тренировку, поэтому запись прервалась бы."
          }
        }
      }
    },
    "This watch is out of storage. Free up some space, then try again." : {
      "localizations" : {
        "de" : {
