<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Written out rather than generated, for the reason given in
	     OpenHikes/Info.plist: the app target had to stop generating its
	     Info.plist, and every target in this project is kept consistent. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>OpenHikes</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<!-- Written out because nothing writes it for us: Xcode injects this key
	     only when it generates the Info.plist, which this project does not do
	     — see OpenHikes/Info.plist. Without it the asset catalog's icon is
	     built into the bundle and then not declared, and the upload is
	     rejected for an icon that is sitting right there. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The single-target shape: a watchOS app that is its own bundle, with no
	     WatchKit extension beside it. -->
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>tappium.com.OpenHikes</string>
	<!-- Without this a recording ends the moment the wrist drops. watchOS
	     suspends an ordinary app within seconds of the screen going dark, and
	     the workout-processing mode is the only thing that keeps a session
	     running and its location updates arriving for the length of a walk.
	     It is claimed by starting an HKWorkoutSession and by nothing else, so
	     the entitlement, this key and WatchRecorder's session all have to
	     agree or the recording is silently short. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>OpenHikes reads your heart rate and energy from Health while you are recording a hike, so the watch can show them as you walk. Nothing else in Health is read.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>OpenHikes starts a hiking workout in Health while you record on your watch, which is what keeps the recording running with the screen off and saves the walk beside your other activity.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OpenHikes uses your location to show where you are on the trail you are following, and to record the hike you walk.</string>
	<key>NSMotionUsageDescription</key>
	<string>OpenHikes uses motion sensors to improve the elevation recorded on your hike.</string>
</dict>
</plist>
