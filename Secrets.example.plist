<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for bundled secrets. To enable a key-gated tile source without
  typing a key into the in-app Settings screen:

    1. Copy this file to OpenHikes/Secrets.plist
    2. Replace the placeholder(s) with your own API key(s)
       Stadia Maps: https://client.stadiamaps.com/ — Manage Properties → API Keys
       Thunderforest: https://www.thunderforest.com/docs/apikeys/

  OpenHikes/Secrets.plist is gitignored, so your real key never gets committed.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StadiaAPIKey</key>
	<string>YOUR_STADIA_API_KEY_HERE</string>
	<key>ThunderforestAPIKey</key>
	<string>YOUR_THUNDERFOREST_API_KEY_HERE</string>
</dict>
</plist>
