<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for bundled secrets. To enable the Stadia Outdoors tile source
  without typing a key into the in-app Settings screen:

    1. Copy this file to OpenTrails/Secrets.plist
    2. Replace the placeholder with your own Stadia Maps API key
       (https://client.stadiamaps.com/ — Manage Properties → API Keys)

  OpenTrails/Secrets.plist is gitignored, so your real key never gets committed.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>StadiaAPIKey</key>
	<string>YOUR_STADIA_API_KEY_HERE</string>
</dict>
</plist>
